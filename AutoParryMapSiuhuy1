        or pct > 0.50 and Color3.fromRGB(215, 145, 20)
        or Color3.fromRGB(30, 160, 65)

    if Lock.target and Lock.target.Character then
        local er  = Lock.target.Character:FindFirstChild("HumanoidRootPart")
