--  LOCK STATE — v9.3 TRUE NEUTRAL
--
--  NEUTRAL  = Lock.on=true,  Lock.target=nil   (no constraint, no aim)
--  ACTIVE   = Lock.on=true,  Lock.target=X     (full lock + aim)
--  OFF      = Lock.on=false  (manual RCtrl or death)
--
--  Auto-lock fires ONLY on:
--    · incoming HP drop (CombatLock:onIncoming)
--    · outgoing attack attr flip (CombatLock:onOutgoing)
--    · FX events (HeavyPunchFX, HitRunFX, etc.)
--
--  Auto-neutral fires after HIT_EXCHANGE_TTL seconds of no exchange.
-- ============================================================
local Lock = {
    on = false, target = nil, expireTime = 0, combatTime = 0, inCombat = false,
    alignOri = nil, att0 = nil,
    prevPos = nil, vel = Vector3.zero, lastVelT = 0,
    lastSwitch = 0, lastProx = 0, isAtk = false, candidates = {},
    lastAttacker = nil, lastAttackerT = 0,
    lastHitTarget = nil, lastHitTargetT = 0,
}

local LOCK_SWITCH_HYSTERESIS = 16

local HIT_EXCHANGE_TTL = 3.5   -- seconds before lock goes neutral

local CombatLock = {
    active        = false,
    lastExchangeT = 0,
    incomingHit   = false,
    outgoingHit   = false,
}

-- forward declarations
local LockOn, UnlockTarget, FullOff, GetBestTarget

-- v9.3: incoming hit → lock to closest attacker
function CombatLock:onIncoming(attackerHint)
    self.incomingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
    task.defer(function()
        if not Lock.on then return end
        local target = attackerHint
        if not target then
            local root = MC.root
            if root then
                local closest, cd = nil, LockCFG.Range
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local er = p.Character:FindFirstChild("HumanoidRootPart")
                        local eh = p.Character:FindFirstChild("Humanoid")
                        if er and eh and eh.Health > 0 then
                            local d = (root.Position - er.Position).Magnitude
                            if d < cd then cd = d; closest = p end
                        end
                    end
                end
                target = closest
            end
        end
        if not target then target = GetBestTarget(true) end
        if target then
            Lock.lastAttacker  = target
            Lock.lastAttackerT = os.clock()
            LockOn(target)
        end
    end)
end

-- v9.3: outgoing hit → lock to attacked target
function CombatLock:onOutgoing(targetHint)
    self.outgoingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
    task.defer(function()
        if not Lock.on then return end
        local target = targetHint
        if not target then target = GetBestTarget(true) end
        if target then
            Lock.lastHitTarget  = target
            Lock.lastHitTargetT = os.clock()
            LockOn(target)
        end
    end)
end

-- v9.3: tick — idle > TTL → neutral (target nil, Lock.on stays)
function CombatLock:tick()
    if not self.active then return end
    local now = os.clock()
    if now - self.lastExchangeT > HIT_EXCHANGE_TTL then
        self.active      = false
        self.incomingHit = false
        self.outgoingHit = false
        if Lock.on and Lock.target then
            UnlockTarget()
        end
    end
end

-- ============================================================
--  HP WATCH — detect incoming hit via HP drop
-- ============================================================
local HPWatch = { lastHP = nil, lastHum = nil }

local function SetupHPWatch()
    local hum = MC.hum
    if not hum or hum == HPWatch.lastHum then return end
    HPWatch.lastHum = hum
    HPWatch.lastHP  = hum.Health
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        local cur  = hum.Health
        local prev = HPWatch.lastHP or cur
        if cur < prev then CombatLock:onIncoming(nil) end
        HPWatch.lastHP = cur
    end)
end

-- ============================================================
--  OUTGOING WATCH — detect outgoing attack via attr flip
