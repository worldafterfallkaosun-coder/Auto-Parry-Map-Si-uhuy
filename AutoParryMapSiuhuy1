-- ============================================================
--  PING MONITOR
-- ============================================================
local Ping = { current=80, samples={}, maxSamp=14, lastT=0 }

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.22 then return end
    self.lastT = now
    local ok,v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples,1) end
        local sum = 0
        for _,s in ipairs(self.samples) do sum=sum+s end
        self.current = sum/#self.samples
    end
end

function Ping:get()  self:update(); return self.current end
function Ping:lead()
    local p = self:get()
    return math.min(0.13, math.max(0, (p-50)/1000*2.6))
end
function Ping:cd(heavy)
    local p    = self:get()
    local base = heavy and 0.13 or 0.18
    if p > 200 then return math.max(base*0.40, base-0.10)
    elseif p > 130 then return math.max(base*0.55, base-0.05) end
    return base
end

-- ============================================================
--  MATH — lognormal + gamma
-- ============================================================
local _TWO_PI = 2*math.pi

local function _gauss()
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    return math.sqrt(-2*math.log(u1)) * math.cos(_TWO_PI*u2)
end

local function LogN(mu, sigma, lo, hi)
    local v = math.exp(mu + sigma * _gauss())
    return math.clamp(v, lo, hi)
end

local function Gamma(k, theta)
    k = math.max(k, 1.0)
    local d = k - 1/3
    local c = 1 / math.sqrt(9*d)
    while true do
        local x, v
        repeat
            x = _gauss()
            v = 1 + c*x
        until v > 0
        v = v*v*v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331*(x*x)*(x*x) then
            return d*v*theta
        end
        if math.log(u) < 0.5*x*x + d*(1 - v + math.log(v)) then
            return d*v*theta
        end
    end
end

local function ReactionDelay(isHeavy)
    if isHeavy then
        return LogN(-2.41, 0.30, 0.045, 0.110)
    else
        return LogN(-1.90, 0.28, 0.080, 0.220)
    end
end

-- ============================================================
--  NEW v9.1 — AUTO BLOCK FALLBACK SYSTEM
--  Priority: Parry > AutoBlock
--  Block hanya aktif ketika parry window missed
--  Block hold lognormal: manusiawi, bukan robot-constant
-- ============================================================
local AutoBlock = {
    active      = false,   -- apakah block sedang hold
    holdUntil   = 0,       -- kapan block dilepas
    fallbackArmed = false, -- sudah arm untuk fire fallback?
    armTime     = 0,       -- kapan fallback di-arm
    armTTL      = 0.18,    -- berapa lama arm sebelum fire (window)
    cooldown    = 0,       -- cooldown antar block
    cdDuration  = 0.22,    -- min gap antar block fire
}

-- Arm fallback: dipanggil saat ancaman terdeteksi
-- Jika dalam armTTL parry tidak fire, block otomatis turun
function AutoBlock:arm(isHeavy)
    if self.active then return end -- sudah block, skip
    if os.clock() < self.cooldown then return end
    self.fallbackArmed = true
    self.armTime       = os.clock()
    -- Heavy attack = arm lebih cepat (ancaman lebih serius)
    self.armTTL        = isHeavy and 0.10 or 0.18
end

-- Disarm: dipanggil saat parry berhasil fire
-- Jadi block fallback tidak dobel dengan parry
function AutoBlock:disarm()
    self.fallbackArmed = false
    self.active        = false
    self.holdUntil     = 0
end

-- Tick: dipanggil tiap frame
-- Cek apakah perlu fire block, atau lepas block
function AutoBlock:tick()
    local now = os.clock()

    -- Lepas block kalau sudah habis waktunya
    if self.active and now >= self.holdUntil then
        pcall(function() RequestBlock:FireServer(false) end)
        self.active    = false
        self.cooldown  = now + self.cdDuration
        return
    end

    -- Fire block fallback jika arm sudah lewat window
    if self.fallbackArmed and not self.active then
        if now - self.armTime >= self.armTTL then
            -- Parry tidak fire dalam window → turunkan block
            if RL:ok() then
                local react = ReactionDelay(false) * 0.5
                task.delay(react, function()
                    if self.fallbackArmed and not self.active then
                        pcall(function()
                            RequestBlock:FireServer(true)
                            RL:mark()
                        end)
                        -- Hold block selama window lognormal (manusiawi)
                        self.active        = true
                        self.holdUntil     = os.clock() + LogN(-1.60, 0.25, 0.12, 0.38)
                        self.fallbackArmed = false
                    end
                end)
            end
        end
    end
end

-- ============================================================
--  NEW v9.1 — COMBAT LOCK / NEUTRAL LOGIC
--
--  Lock NEUTRAL: lock reset ke idle jika tidak ada
--  hit exchange dalam HIT_EXCHANGE_TTL detik
--
--  Lock ACTIVE: lock aktif hanya ketika:
--    · Kita kena hit (incoming damage)
--    · Kita ngehit musuh (outgoing hit confirmed)
--
--  Ini mencegah lock "nempel terus" ke musuh yang
--  sudah tidak aktif, dan membuatnya lebih natural
-- ============================================================
local HIT_EXCHANGE_TTL = 3.2  -- detik tanpa exchange → neutral

local CombatLock = {
    active          = false,
    lastExchangeT   = 0,   -- kapan terakhir ada hit exchange
    incomingHit     = false,
    outgoingHit     = false,
}

-- Dipanggil saat kita kena hit
function CombatLock:onIncoming()
    self.incomingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
end

-- Dipanggil saat kita ngehit musuh
function CombatLock:onOutgoing()
    self.outgoingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
end

-- Dipanggil tiap frame — cek apakah harus neutral
function CombatLock:tick()
    if not self.active then return end
    local now = os.clock()
    if now - self.lastExchangeT > HIT_EXCHANGE_TTL then
        -- Tidak ada exchange cukup lama → neutral
        self.active      = false
        self.incomingHit = false
        self.outgoingHit = false
        -- Reset lock target ke neutral state
        Lock.on        = false
        Lock.target    = nil
        Lock.inCombat  = false
        if Lock.alignOri then
            pcall(function() Lock.alignOri:Destroy() end)
            Lock.alignOri = nil
        end
        if Lock.att0 then
            pcall(function() Lock.att0:Destroy() end)
            Lock.att0 = nil
        end
    end
end

-- ============================================================
--  DYNAMIC RATE CAP
-- ============================================================
local DynRL = {
    floor=4, ceiling=12, current=6,
    probeT=0, probeCd=28.0,
    hitCap=false, hardBack=false,
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hardBack then
        self.current  = math.max(self.floor, self.current-3)
        self.hardBack = false
    elseif self.hitCap then
        self.current  = math.max(self.floor, self.current-2)
        self.hardBack = true
    else
        self.current = math.min(self.ceiling, self.current+1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls={} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _,t in ipairs(self.calls) do
        if now-t < 1.0 then table.insert(fresh,t) end
    end
    self.calls = fresh
    local cap = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap=true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

