                local ec  = p.Character
                if ec then
                    local er = ec:FindFirstChild("HumanoidRootPart")
                    local eh = ec:FindFirstChildWhichIsA("Humanoid")
                    if er and eh and eh.Health > 0 then
                        local sc, hvy = Score(p, ps)
                        -- v9.1: arm auto block saat ancaman terdeteksi
                        -- bahkan sebelum threshold parry
                        if sc >= 2 then
                            AutoBlock:arm(hvy)
                        end
                        -- Threshold 3 untuk parry fire
                        if sc >= Parry.dynThreshold then
                            FireParry(uid, hvy, ps)
                        end
                    end
                end
            end
        end
    end

    Decoy:tick()
end)

