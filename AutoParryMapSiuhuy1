--  NOTHING ELSE sets Lock.target. Ever.
-- ============================================================
local Lock = {
    on=false, target=nil, expT=0,
    combatT=0, inCombat=false,
    alignOri=nil, att0=nil,
    prevPos=nil, vel=Vector3.zero, velT=0,
    lastSw=0, lastProx=0, isAtk=false,
    lastAtk=nil, lastAtkT=0,
    lastHitTgt=nil, lastHitTgtT=0,
}
