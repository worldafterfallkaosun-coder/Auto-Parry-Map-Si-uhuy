--  COMBAT MARK
-- ============================================================
local function NearestEnemy(range)
    local root = MC.root
    if not root then return nil, 9999 end
    local best, bd = nil, range or 9999
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
            local eh = p.Character:FindFirstChildWhichIsA("Humanoid")
            if er and eh and eh.Health > 0 then
                local d = (er.Position - root.Position).Magnitude
                if d < bd then bd = d; best = p end
            end
        end
    end
    return best, bd
end

local function NearEnemy(range) return (NearestEnemy(range)) ~= nil end

