-- ============================================================
--  LOCK HEARTBEAT — v9.3: Lock.on never auto-false
--  Idle = target nil (neutral), exchange = target set (active)
-- ============================================================
RunService.Heartbeat:Connect(function(dt)
    CheckNeutral()

    -- ProxCheck gated: only runs during active exchange
    if CombatLock and CombatLock.active then ProxCheck() end

    if not Lock.on then return end

    -- no exchange? → neutral (kill target, keep Lock.on)
    if not (Lock.inCombat or (CombatLock and CombatLock.active)) then
        if Lock.target then UnlockTarget() end
        return
    end

    -- validate and expire
    if Lock.target and os.clock() > Lock.expireTime then UnlockTarget(); return end
    if Lock.target and not ValidTarget(Lock.target) then UnlockTarget(); return end

    -- try switch
    local best = GetBestTarget(true)
    if best and ShouldSwitch(best) then LockOn(best) end
    if not Lock.target and best then LockOn(best); return end
    if not Lock.target then return end

    local ec = Lock.target.Character; if not ec then return end
    local er = ec:FindFirstChild("HumanoidRootPart"); if not er then return end
    UpdateVel(er.Position)
    local aimPt = Predict(er.Position, dt)
    aimPt = Vector3.new(aimPt.X, aimPt.Y + 1.5, aimPt.Z)
    SetAimDir(aimPt)
end)

