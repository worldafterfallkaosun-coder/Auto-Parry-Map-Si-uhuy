--  RAGDOLL STATE — v9.2: lebih sensitif, cooldown lebih pendek
-- ============================================================
local RagdollState = {
    active    = false,
    detectedT = 0,
    lastVelY  = 0,
    duration  = 0,    -- berapa lama sudah ragdoll
}

local function UpdateRagdollState()
    local root = MC.root
    local now  = os.clock()
    if not root then RagdollState.active=false; return end
    local vel   = root.Velocity
    local velY  = vel.Y
    local velH  = Vector3.new(vel.X, 0, vel.Z).Magnitude
    -- v9.2: lebih sensitif — detect launch ke atas (>8) atau jatuh cepat (>6)
    -- atau horizontal velocity spike (>22) = uppercut/slam
    local isAirborne = velY < -6 or velY > 8 or (velH > 22 and velY ~= 0)
    local c = MC.char
    local beingHeld = c and (
        c:GetAttribute("IsBeingCarried")==true or
        c:GetAttribute("IsBeingFinished")==true
    )
    local wasActive = RagdollState.active
    RagdollState.active = isAirborne or beingHeld
    if RagdollState.active then
        if not wasActive then
            RagdollState.detectedT = now
            RagdollState.duration  = 0
        else
            RagdollState.duration  = now - RagdollState.detectedT
        end
    else
        RagdollState.duration = 0
    end
    RagdollState.lastVelY = velY
end

