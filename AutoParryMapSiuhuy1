--  MAIN HEARTBEAT — priority queue parry
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not Parry then return end

    MaybeRotateNames()
    RefreshChar()

    if not MC.root or not MC.hum then return end
    if MC.hum.Health <= 0 then return end

    if Parry.on then
        local now = os.clock()
        local q = {}
        for _,p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local ec = p.Character
                local er = ec and ec:FindFirstChild("HumanoidRootPart")
                local eh = ec and ec:FindFirstChildWhichIsA("Humanoid")
                if er and eh and eh.Health > 0 then
                    local ps = GetPS(p.UserId)
                    local sc, hvy = Score(p, ps)
                    if sc > 0 then                       -- 0 = jauh / dari belakang / mati
                        local dist = Dist(MC.root, er)
                        local atk, tr, nm = false, nil, nil
                        if dist <= 16 then atk, tr, nm = EnemyStriking(ec, eh) end
                        if PCFG.debug and dist <= 14 then DebugAnims(eh) end

                        if tr then
                            -- JALUR PRESISI: 1 press per swing
                            local startT = now - tr.TimePosition / math.max(tr.Speed, 0.05)
                            if ps.atkTrack ~= tr or math.abs(startT - (ps.atkStartT or 0)) > 0.15 then
                                ps.atkTrack, ps.atkStartT, ps.atkName = tr, startT, nm
                                ps.atkPressed, ps.atkHitSeen = false, false
                                Parry.lastEpisodeT = now
                                UpdateCombo(ps, IsM2Anim(nm), "anim")
                            end
                            if not ps.atkPressed then
                                ps.atkPressed = true
                                SchedulePress(nm, ps.atkStartT)
                            end
                        elseif sc >= Parry.dynThreshold and (atk or sc >= PCFG.spamScore) then
                            -- JALUR CADANGAN: serangan tanpa anim yang kebaca
                            q[#q+1] = { uid=p.UserId, sc=sc, hvy=hvy, ps=ps, atk=atk }
                        end
                    end
                end
            end
        end

        table.sort(q, function(a, b)
            if a.atk ~= b.atk then return a.atk end
            return a.sc > b.sc
        end)

        local cap = DynRL:cap()
        for i = 1, math.min(#q, PCFG.topN) do
            local c = q[i]
            if c.atk or RL:count() < cap * PCFG.reserveFrac then
                if FireParry(c.uid, c.hvy, c.ps) and c.atk then
                    UpdateCombo(c.ps, c.hvy, "HB")
                end
            end
        end
    end

    Decoy:tick()
end)

