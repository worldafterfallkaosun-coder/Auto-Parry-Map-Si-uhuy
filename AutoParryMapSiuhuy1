-- ============================================================
--  FPS MONITOR — rolling average, updated every 0.25s
-- ============================================================
local FPS = { current = 60, frametime = 1/60, samples = {}, maxSamp = 40, lastT = 0 }

RunService.Heartbeat:Connect(function(dt)
    table.insert(FPS.samples, dt)
    if #FPS.samples > FPS.maxSamp then table.remove(FPS.samples, 1) end
    local now = os.clock()
    if now - FPS.lastT > 0.25 then
        local sum = 0
        for _, s in ipairs(FPS.samples) do sum = sum + s end
        FPS.frametime = sum / #FPS.samples
        FPS.current   = math.clamp(math.floor(1 / math.max(FPS.frametime, 0.001)), 10, 500)
        FPS.lastT     = now
    end
end)

-- ============================================================
--  PING MONITOR — rolling average with variance tracking
-- ============================================================
local Ping = {
    current  = 80,
    variance = 0,
    samples  = {},
    maxSamp  = 16,
    lastT    = 0,
}

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.20 then return end
    self.lastT = now
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples, 1) end
        local sum, sum2 = 0, 0
        for _, s in ipairs(self.samples) do sum = sum + s; sum2 = sum2 + s*s end
        local avg = sum / #self.samples
        self.current  = avg
        self.variance = math.sqrt(math.max(0, sum2/#self.samples - avg*avg))
    end
end

function Ping:get()    self:update(); return self.current end
function Ping:jitter() self:update(); return self.variance end

-- lead: how far ahead to fire (accounts for latency + jitter)
function Ping:lead()
    local p = self:get()
    local j = self:jitter()
    -- base lead from ping, extra from jitter
    local base = math.clamp((p - 30) / 1000 * 3.5, 0.004, 0.22)
    local extra = math.clamp(j / 2000, 0, 0.025)
    return base + extra
end

-- adaptive cooldown between parry bursts
function Ping:cd(heavy)
    local p    = self:get()
    local base = heavy and 0.09 or 0.12
    if p > 250 then return math.max(base * 0.25, base - 0.08)
    elseif p > 180 then return math.max(base * 0.38, base - 0.06)
    elseif p > 120 then return math.max(base * 0.52, base - 0.04)
    elseif p > 70  then return math.max(base * 0.72, base - 0.02) end
    return base
end

-- ============================================================
--  ADAPTIVE TAP DURATION
--  Combined FPS + Ping formula, re-evaluated every tap
-- ============================================================
local function AdaptiveTapDuration(urgency)
    local fps  = math.max(FPS.current, 10)
    local ping = Ping:get()
    local jit  = Ping:jitter()

    -- FPS bonus: higher FPS = shorter tap (server sees frames faster)
    local fpsBonus  = math.clamp((fps - 30) / 1200, 0, 0.020)
    -- Ping bonus: higher ping = longer tap (server needs more time)
    local pingBonus = math.clamp((ping - 60) / 2200, 0, 0.022)
    -- Jitter bonus: unstable connection = slightly longer tap
    local jitBonus  = math.clamp(jit / 3000, 0, 0.008)

    local lo = math.max(0.011, 0.020 - fpsBonus)
    local hi = math.min(0.098, 0.065 + pingBonus + jitBonus)

    -- urgency modes compress the range
    if urgency == "ragdoll" or urgency == "instant" then
        lo = lo * 0.65
        hi = hi * 0.72
    elseif urgency == "reactive" then
        lo = lo * 0.80
        hi = hi * 0.88
    end

    return lo + (hi - lo) * math.random()
end

-- ============================================================
--  ADAPTIVE BURST COUNT
--  Scales with FPS, ping stability, and urgency
-- ============================================================
local function AdaptiveBurstCount(isHeavy, urgency, capOverride)
    local fps  = FPS.current
    local ping = Ping:get()
    local jit  = Ping:jitter()
    local cap  = capOverride or math.huge

    -- base ranges
    local minB, maxB
    if urgency == "ragdoll" then
        minB = 7; maxB = 12
    elseif urgency == "instant" then
        minB = isHeavy and 6 or 5
        maxB = isHeavy and 11 or 9
    elseif isHeavy then
        minB = fps > 90 and 5 or 4
        maxB = fps > 90 and 10 or 8
    else
        minB = fps > 90 and 4 or 3
        maxB = fps > 90 and 8 or 6
    end

    -- high jitter = reduce burst (network too unstable for spam)
    if jit > 40 then
        maxB = math.max(minB, maxB - 2)
    end

    -- high ping = reduce burst slightly (each tap takes longer to register)
    if ping > 200 then
        maxB = math.max(minB, maxB - 1)
    end

    local count = math.random(minB, maxB)
    return math.min(count, cap)
end

-- ============================================================
--  MATH — lognormal + gamma (human timing distributions)
-- ============================================================
local _TWO_PI = 2 * math.pi

local function _gauss()
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    return math.sqrt(-2 * math.log(u1)) * math.cos(_TWO_PI * u2)
end

local function LogN(mu, sigma, lo, hi)
    return math.clamp(math.exp(mu + sigma * _gauss()), lo, hi)
end

local function Gamma(k, theta)
    k = math.max(k, 1.0)
    local d = k - 1/3
    local c = 1 / math.sqrt(9 * d)
    while true do
        local x, v
        repeat x = _gauss(); v = 1 + c * x until v > 0
        v = v * v * v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331 * (x*x) * (x*x) then return d * v * theta end
        if math.log(u) < 0.5*x*x + d*(1 - v + math.log(v)) then return d * v * theta end
    end
end

-- reaction delay, adaptive to FPS and urgency
local function ReactionDelay(isHeavy, urgency)
    local fpsScale = math.clamp((FPS.current - 30) / 120, 0, 0.45)
    if urgency == "instant" or urgency == "ragdoll" then
        return LogN(-3.90, 0.10, 0.008, 0.032)
    elseif urgency == "reactive" then
        return LogN(-3.15, 0.09, 0.030, 0.065)
    elseif isHeavy then
        local lo = math.max(0.018, 0.042 * (1 - fpsScale))
        local hi = math.max(0.045, 0.085 * (1 - fpsScale * 0.5))
        return LogN(-2.38, 0.28, lo, hi)
    else
        local lo = math.max(0.030, 0.075 * (1 - fpsScale * 0.5))
        local hi = math.max(0.070, 0.165 * (1 - fpsScale * 0.3))
        return LogN(-1.88, 0.26, lo, hi)
    end
end

-- ============================================================
--  DYNAMIC RATE CAP
-- ============================================================
local DynRL = {
    floor = 5, ceiling = 16, current = 8,
    probeT = 0, probeCd = 20.0,
    hitCap = false, hardBack = false,
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hardBack then
        self.current  = math.max(self.floor, self.current - 2)
        self.hardBack = false
    elseif self.hitCap then
        self.current  = math.max(self.floor, self.current - 1)
        self.hardBack = true
    else
        self.current = math.min(self.ceiling, self.current + 1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls = {} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _, t in ipairs(self.calls) do
        if now - t < 1.0 then table.insert(fresh, t) end
    end
    self.calls = fresh
    local cap = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap = true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

