    if now - lastHBTime < scanRate then return end
    lastHBTime = now

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
            if er and Dist(MC.root or er, er) <= 26 and not IsFromBack(er) then
                CheckVelPreFire(p, GetPS(p.UserId), er)
            end
        end
    end

    if Parry.on then
        if not ragdoll and now < Parry.nextFire then return end
        local q = BuildQueue()
