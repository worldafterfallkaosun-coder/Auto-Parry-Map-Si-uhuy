        LockChip.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        LockChip.Text = "🔒 LOCK   OFF"
        LockChip.TextColor3 = Color3.fromRGB(160, 160, 160)
    end

    -- Stroke color = combined state
    if Parry.on and Lock.on then
        HStroke.Color = Color3.fromRGB(0, 210, 150)
    elseif Lock.on then
        HStroke.Color = Color3.fromRGB(20, 100, 200)
    elseif Parry.on then
        HStroke.Color = Color3.fromRGB(22, 140, 55)
    else
        HStroke.Color = Color3.fromRGB(45, 45, 45)
    end

    -- Stat line
    local timing = Adaptive:compute()
    StatLine.Text = string.format("fps:%d p:%dms | P:%d M:%d cap:%d",
        FPS.current, math.floor(Ping:get()),
        Parry.parryCount, Parry.missCount, DynRL:cap())

    -- Score bar
    local pct = math.clamp(RL:count() / math.max(DynRL:cap(), 1), 0, 1)
    BarFill.Size = UDim2.new(pct, 0, 1, 0)
    BarFill.BackgroundColor3 = pct > 0.75
        and Color3.fromRGB(220, 55, 55)
        or  pct > 0.5
        and Color3.fromRGB(220, 155, 25)
        or  Color3.fromRGB(30, 160, 65)

    -- Target line
    if Lock.target and Lock.target.Character then
        local ec = Lock.target.Character
        local er = ec:FindFirstChild("HumanoidRootPart")
        local myR = MC.root
        local d = (er and myR) and math.floor(Dist(myR, er)) or 0
        TargetLine.Text = string.format("🎯 %s  d:%d", Lock.target.Name, d)
        SetTargetVisible(true)
    else
        SetTargetVisible(false)
    end
end

