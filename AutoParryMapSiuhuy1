local function UpdateUI()
    local rdl = RagdollState.active

    -- pill color state
    if rdl and Parry.on then
        Pill.BackgroundColor3 = Color3.fromRGB(180, 40, 120)
        PillStroke.Color = Color3.fromRGB(255, 80, 180)
        Pill.TextColor3  = Color3.fromRGB(255, 200, 240)
