-- ============================================================
--  SCORE SYSTEM v2 — combo weight x2, miss penalty x3
-- ============================================================
local SCORE_TTL = 0.002  -- v10: 2ms cache (fresher)

local function GetSwingBonus(er, root)
    local toMe = root.Position - er.Position
    local d    = toMe.Magnitude
    if d < 0.1 then return 0 end
    local dirN = toMe / d
    local fDot = er.CFrame.LookVector:Dot(dirN)
    local sDot = math.abs(er.CFrame.RightVector:Dot(dirN))
    local b    = 0
    if fDot > 0.32 then b = b + 20 end
    if sDot > 0.25 then b = b + 14 end
    if fDot > 0.68 then b = b + 12 end
    return math.min(b, 46)
end

local function GetVelBonus(ps, er, root)
    local vel  = er.Velocity
    local prev = ps.prevVel
    ps.prevVel = vel
    local acc  = (vel - prev).Magnitude
    if acc < 0.8 then return 0 end
    local toMe = root.Position - er.Position
    if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return 0 end
    local dot = toMe.Unit:Dot(vel.Unit)
    local b   = 0
    if dot > 0.12 then b = b + math.floor(dot * 52) end
    if vel.Unit.Y < -0.20 and dot > 0.05 then b = b + 20 end
    return math.min(b, 68)
end

local function Score(p, ps)
    local now = os.clock()
    if now - ps.cacheTime < SCORE_TTL then return ps.cachedScore, ps.cachedHeavy end
    local ec   = p.Character; local root = MC.root
    if not ec or not root then ps.cachedScore = 0; return 0, false end
    local er   = ec:FindFirstChild("HumanoidRootPart")
    local eh   = ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health <= 0 then ps.cachedScore = 0; return 0, false end
    local d    = Dist(root, er)
    if d > 26 or IsFromBack(er) then ps.cachedScore = 0; return 0, false end

    local sc = 0; local hvy = false

    sc = sc + math.floor((1 - d / 26) * 28)

    local hasAttr, isHAttr = ScanAttrs(ec, eh)
    if isHAttr then sc = sc + 130; hvy = true
    elseif hasAttr then sc = sc + 85 end

    if ec:GetAttribute("InCombat")  == true then sc = sc + 18 end
    if ec:GetAttribute("FightMode") == true then sc = sc + 15 end

    local anim = eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok, tracks = pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n   = t.Animation.Name
                    local pos = t.TimePosition
                    if IsM2Anim(n) then
                        hvy  = true
                        sc   = sc + (pos <= 0.02 and 105 or pos <= 0.05 and 96 or
                                     pos < 0.15 and 78 or 58)
                        break
                    elseif IsM1Anim(n) then
                        sc   = sc + (pos <= 0.02 and 94 or pos <= 0.04 and 78 or
                                     pos < 0.12 and 62 or 42)
                        break
                    end
                end
            end
        end
    end

    if ps.heavyAlert and now < ps.heavyAlertExp then sc = sc + 58; hvy = true end

    -- v10: combo weight doubled
    if ps.combo > 0 then sc = sc + math.min(ps.combo * 28, 140) end

    local avg = ps.avgInterval
    if avg and avg < 0.45 then sc = sc + math.floor((1 - avg / 0.45) * 40) end

    sc = sc + GetSwingBonus(er, root)
    sc = sc + GetVelBonus(ps, er, root)

    if d < 9 then
        local toMe = (root.Position - er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector) > 0.48 then sc = sc + 28 end
    end

    local hpR = eh.Health / math.max(eh.MaxHealth, 1)
    if hpR < 0.28 then sc = sc + 26 elseif hpR < 0.52 then sc = sc + 13 end

    if ps.m2Detected and now < ps.m2DetectedExp then sc = sc + 40; hvy = true end

    -- v10: miss penalty tripled
    if ps.missStreak >= 2 then sc = sc - math.min(ps.missStreak * 22, 88) end

    if Lock.lastAttacker  == p and now - Lock.lastAttackerT  < 10.0 then sc = sc + 36 end
    if Lock.lastHitTarget == p and now - Lock.lastHitTargetT < 10.0 then sc = sc + 26 end

    -- v10: pre-arm bonus
    if ps.preArmActive and now < ps.preArmExp then sc = sc + 45; hvy = true end

    local final = math.min(sc, 380)
    ps.cachedScore = final; ps.cachedHeavy = hvy; ps.cacheTime = now
    return final, hvy
end

-- ============================================================
--  ANIM WINDOW PREDICTOR — v10: speed-corrected
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok, dur = pcall(function() return track.Length end)
    if not ok or not dur or dur <= 0 then return 0 end
    local pos = track.TimePosition
    local spd = track.Speed
    if spd <= 0 then return 0 end
    -- v10: predict to 18% of anim length (was 15%)
    return math.max(0, (dur * 0.18 - pos) / spd)
end

-- ============================================================
--  PRE-ARM SYSTEM — v10 new
--  Detects anim startup FRAME 0 and fires parry before impact
-- ============================================================
local function TryPreArm(ps, uid, animName, isHeavy)
    local now = os.clock()
    -- only pre-arm on heavy or known M1 openers
    if not isHeavy and not IsM1Anim(animName) then return end
    if ps.preArmActive and now < ps.preArmExp then return end
    ps.preArmActive = true
    ps.preArmExp    = now + 0.55
    -- push to highest-priority lane
    local urg = isHeavy and "prearm" or "instant"
    FireQueue:push(urg, isHeavy, nil)
end

-- ============================================================
--  DECOY — timing unchanged
-- ============================================================
local Decoy = { nextT = 0, nextSeqT = 0 }

function Decoy:schedule()    self.nextT    = os.clock() + Gamma(2.5, 4.5) + 6.0 end
function Decoy:scheduleSeq() self.nextSeqT = os.clock() + Gamma(3.0, 5.0) + 10.0 end

function Decoy:tick()
    local now = os.clock()
    if now >= self.nextT and RL:ok() then
        pcall(function()
            task.delay(LogN(-2.80, 0.15, 0.040, 0.140), function()
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end
    if now >= self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                task.wait(ReactionDelay(false, "normal"))
                if not RL:ok() then return end
                RequestBlock:FireServer(true); RL:mark()
                task.wait(AdaptiveTapDuration("normal"))
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

Decoy:schedule()
Decoy:scheduleSeq()

-- ============================================================
--  RAW PARRY
-- ============================================================
local function RawParry(tapOverride, urgency)
    if not RL:ok() then return false end
    local tap   = tapOverride or AdaptiveTapDuration(urgency or "normal")
    local jPre  = LogN(-5.00, 0.12, 0.001, 0.012)
    local jPost = LogN(-5.20, 0.12, 0.001, 0.009)
    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true); RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  SPAM LOCK
-- ============================================================
local spamLock  = false
local spamLockT = 0

local function ClearSpamLock() spamLock = false; spamLockT = 0 end

-- ============================================================
--  DO PARRY BURST — v10 fully adaptive with pre-arm lane
-- ============================================================
local function DoParryBurst(isHeavy, urgency, animTrack, burstOverride)
    if spamLock and os.clock() - spamLockT > 0.50 then ClearSpamLock() end

    local isRagdoll = (urgency == "ragdoll")
    local isInstant = (urgency == "instant" or urgency == "prearm")

    if spamLock and not isRagdoll and not isInstant then return end
    spamLock  = true
    spamLockT = os.clock()

    local pingLead = Ping:lead()
    local burstCap = math.floor(DynRL:cap() * (isRagdoll and 0.90 or 0.70))
    local count    = burstOverride or AdaptiveBurstCount(isHeavy, urgency, burstCap)
    count          = math.max(count, 2)

    task.spawn(function()
        -- === REACTION DELAY ===
        local react = ReactionDelay(isHeavy, urgency)
        if animTrack and not isInstant and not isRagdoll then
            local ahead = AnimWindowPredict(animTrack)
            if ahead > 0.004 and ahead < react then
                react = math.max(0.006, react - ahead)
            end
        end
        react = math.max(0.005, react - pingLead)
        task.wait(react)

        -- === TAP LOOP ===
        for i = 1, count do
            local parryActive = Parry.on or Parry.reactiveMode or isRagdoll or isInstant
            if not parryActive then break end

            if not RL:ok() then
                if isRagdoll then continue end
                task.wait(Gamma(1.4, 0.050))
            end

            local tapT = AdaptiveTapDuration(urgency)
            RawParry(tapT, urgency)

            if i < count then
                local shape = isRagdoll and 1.0 or (1.2 + (i / count) * 0.50)
                local scaleT = isRagdoll and 0.015 or 0.026
                local iv     = Gamma(shape, scaleT)
                iv = math.clamp(iv, isRagdoll and 0.007 or 0.011, 0.070)
                task.wait(iv)
            end
        end

        if isRagdoll then task.delay(0.07, ClearSpamLock)
        else ClearSpamLock() end
    end)
end

-- ============================================================
--  FIRE PARRY — v10: prearm bypasses all gates like ragdoll
-- ============================================================
local function CanFire(ps, urgency)
    local ragdoll  = RagdollState.active
    local isPreArm = (urgency == "prearm")
    local isReact  = (urgency == "reactive")
    local isInst   = (urgency == "instant" or urgency == "ragdoll" or isPreArm)

    if ragdoll or isPreArm then
        return not IsHardKO()
    end
    if isInst then
        if IsHardKO() then return false end
        return not spamLock or (os.clock() - spamLockT > 0.35)
    end
    if isReact then
        if not MC.root then return false end
        return not IsSelfAttacking()
    end
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock() - Parry.firingAt > 0.32 then Parry.firing = false
        else return false end
    end
    if os.clock() < Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    if ps and os.clock() - ps.lastFireT < 0.065 then return false end
    return true
end

local function FireParry(isHeavy, ps, urgency, animTrack)
    local ragdoll  = RagdollState.active
    local isRdl    = ragdoll or (urgency == "ragdoll")
    local isPreArm = (urgency == "prearm")

    if isRdl or isPreArm then
        Parry.firing = false; Parry.firingAt = 0; Parry.nextFire = 0
        spamLock = false; spamLockT = 0
    end

    if not isRdl and not isPreArm and not CanFire(ps, urgency) then return false end

    local cd  = Ping:cd(isHeavy)
    local cdJ = Gamma(1.2, 0.004)

    if urgency ~= "reactive" and not isRdl and not isPreArm then
        Parry.firing   = true
        Parry.firingAt = os.clock()
        Parry.nextFire = os.clock() + cd + cdJ
    end
    if ps then ps.lastFireT = os.clock() end

    local urg = isRdl and "ragdoll" or (urgency or "normal")
    task.spawn(function()
        DoParryBurst(isHeavy, urg, animTrack, nil)
        if urgency ~= "reactive" and not isRdl then
            task.wait(0.22)
            Parry.firing = false
        end
    end)
    return true
end

-- ============================================================
--  QUEUE CONSUMER
-- ============================================================
local queueConsumerT = 0
local function ConsumeQueue()
    local now = os.clock()
    if now - queueConsumerT < FireQueue.minGap then return end
    queueConsumerT = now
    local e = FireQueue:pop()
    if not e then return end
    FireParry(e.isHeavy, nil, e.urgency, e.animTrack)
end

-- ============================================================
--  CONVENIENCE WRAPPERS
-- ============================================================
local lastInstantT = 0
local function SafeFireInstant(isHeavy)
    local now     = os.clock()
    local ragdoll = RagdollState.active
    local minGap  = ragdoll and 0.005 or 0.025
    if now - lastInstantT < minGap then return end
    lastInstantT = now
    Parry.nextFire = 0; Parry.firing = false
    spamLock = false; spamLockT = 0
    local urg = ragdoll and "ragdoll" or "instant"
    FireQueue:push(urg, isHeavy or true, nil)
end

local lastReactT = 0
local function ReactiveParry(isHeavy)
    local now     = os.clock()
    local ragdoll = RagdollState.active
    local minGap  = ragdoll and 0.050 or 0.080
    if now - lastReactT < minGap then return end
    lastReactT = now
    Parry.reactiveMode    = true
    Parry.reactiveModeExp = now + 0.40
    spamLock = false; spamLockT = 0
    local urg = ragdoll and "ragdoll" or "reactive"
    FireQueue:push(urg, isHeavy or false, nil)
    task.delay(0.42, function() Parry.reactiveMode = false end)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now = os.clock()
    table.insert(ps.history, { t = now, h = isHeavy, s = src })
    if #ps.history > 32 then table.remove(ps.history, 1) end
    ps.lastHitTime = now
    if #ps.history >= 3 then
        local sum, n = 0, 0
        for i = 2, #ps.history do
            sum = sum + ps.history[i].t - ps.history[i - 1].t; n = n + 1
        end
        ps.avgInterval = sum / n
    else
        ps.avgInterval = nil
    end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    if os.clock() - ps.lastHitTime > 1.5 then ps.combo = 0 end
    RecordHit(ps, isHeavy, src)
    ps.combo = ps.combo + 1
    return ps.combo
end

local function UpdateThreshold(missed, ps)
    local target = missed and 3 or 8
    Parry.dynThreshold = Parry.dynThreshold * 0.80 + target * 0.20
    Parry.dynThreshold = math.clamp(Parry.dynThreshold, 3, 10)
    if missed then
        Parry.consecMiss  = Parry.consecMiss + 1
        Parry.missStreak  = Parry.missStreak + 1
        if ps then ps.missStreak = (ps.missStreak or 0) + 1 end
        if Parry.consecMiss >= 3 then  -- v10: trigger reset at 3 (was 4)
            ClearSpamLock()
            Parry.consecMiss = 0; Parry.missStreak = 0
            Parry.nextFire   = 0
        end
    else
        Parry.consecMiss = 0; Parry.missStreak = 0
        if ps then ps.missStreak = 0 end
    end
end

-- ============================================================
--  BUILD QUEUE
-- ============================================================
local function BuildQueue()
    local q = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local ps = GetPS(p.UserId)
            local sc, hv = Score(p, ps)
            if sc >= Parry.dynThreshold then
                table.insert(q, { player = p, score = sc, heavy = hv, ps = ps })
            end
        end
    end
    table.sort(q, function(a, b) return a.score > b.score end)
    while #q > 3 do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE — v10: lower acc threshold
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel = er.Velocity
    local acc = (vel - ps.prevVel).Magnitude
    if acc >= 3.5 then  -- v10: was 4.2, more sensitive
        local toMe = MC.root.Position - er.Position
        if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return end
        local dot = toMe.Unit:Dot(vel.Unit)
        if dot > 0.15 then
            local now = os.clock()
            if now - ps.lastVelSpike > 0.065 then  -- v10: tighter cooldown
                ps.lastVelSpike = now
                FireQueue:push("normal", false, nil)
            end
        end
    end
end

