            local urg   = ragdoll and "ragdoll" or "normal"
            local fired = FireParry(top.heavy, ps, urg, nil)
            if fired then UpdateCombo(ps, uid, top.heavy, "HB"); UpdateThreshold(false, ps) end
        end
    end
end)

-- ============================================================
--  WATCH CHAR — v10: pre-arm fires on frame 0 of animation
-- ============================================================
local function WatchChar(p, char)
    if not char then return end
    local er  = char:FindFirstChild("HumanoidRootPart")
    local eh  = char:FindFirstChildWhichIsA("Humanoid")
    local uid = p.UserId; local ps = GetPS(uid)

    local function watchAnim(animator)
        pcall(function()
            animator.AnimationPlayed:Connect(function(track)
                local parryActive = Parry.on or Parry.reactiveMode
                local ragdoll     = RagdollState.active
                if not parryActive then return end
                if not track then return end
                if not ragdoll and IsSelfAttacking() then return end
                local ok, n = pcall(function() return track.Animation.Name end)
                if not ok or not n then return end
                local isH = IsM2Anim(n); local isM = IsM1Anim(n)
                if not isH and not isM then return end
                er = char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root, er) > 26 then return end
                if IsFromBack(er) then return end
                local now = os.clock()
                local cK  = string.format("%d_%s", uid, n)
                if now - (ps.lastAnimFire[cK] or 0) < 0.080 then return end
                ps.lastAnimFire[cK] = now

                -- v10: PRE-ARM on frame 0 (TimePosition ~0)
                if track.TimePosition <= 0.02 then
                    TryPreArm(ps, uid, n, isH)
                end

                UpdateCombo(ps, uid, isH, n)
                if isH then
                    ps.heavyAlert = true; ps.heavyAlertExp = now + 4.0
                    local urg = ragdoll and "ragdoll" or "instant"
                    FireQueue:push(urg, true, nil)
                else
                    local urg = ragdoll and "ragdoll" or "normal"
                    FireQueue:push(urg, false, track)
                end
            end)
        end)
    end

    local function onAttr(obj, attr)
        pcall(function()
            obj:GetAttributeChangedSignal(attr):Connect(function()
                local parryActive = Parry.on or Parry.reactiveMode
                local ragdoll     = RagdollState.active
                if not parryActive then return end
                if not ragdoll and IsSelfAttacking() then return end
                local v = obj:GetAttribute(attr)
                if not (v == true or (type(v) == "string" and
                    (v:lower():find("attack") or v:lower():find("heavy")))) then return end
                er = char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root, er) > 26 then return end
                if IsFromBack(er) then return end
                local isHvy = IsHeavyAttr(attr)
                local now   = os.clock()
                if now - ps.lastFireT < 0.065 then return end
                if isHvy then
                    ps.heavyAlert = true; ps.heavyAlertExp = now + 4.0
                    -- v10: pre-arm on heavy attr
                    ps.preArmActive = true; ps.preArmExp = now + 0.55
                    if not ps.m2Detected or now >= ps.m2DetectedExp then
                        ps.m2Detected = true; ps.m2DetectedExp = now + 2.5
                        UpdateCombo(ps, uid, true, attr)
                        local urg = ragdoll and "ragdoll" or "prearm"
                        FireQueue:push(urg, true, nil)
                        return
                    end
                end
                UpdateCombo(ps, uid, isHvy, attr)
                local urg = ragdoll and "ragdoll" or "normal"
                FireQueue:push(urg, isHvy, nil)
            end)
        end)
    end

    if eh then
        local an = eh:FindFirstChildOfClass("Animator")
        if an then watchAnim(an)
        else
            eh.ChildAdded:Connect(function(c)
                if c:IsA("Animator") then watchAnim(c) end
            end)
        end
    end

    for _, a in ipairs(ALL_ATTR) do
        onAttr(char, a)
        if eh then onAttr(eh, a) end
    end
end

local function Watch(p)
    if not p or p == LP then return end
    local ps = GetPS(p.UserId)
    if ps.watched then return end
    ps.watched = true
    if p.Character then WatchChar(p, p.Character) end
    p.CharacterAdded:Connect(function(c)
        ps.watched = false; CleanPS(p.UserId)
        task.wait(0.25); Watch(p)
    end)
end

local function WatchAll()
    for _, p in pairs(Players:GetPlayers()) do Watch(p) end
end
