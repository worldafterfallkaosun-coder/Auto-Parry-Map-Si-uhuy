        if Lock.alignOri then
            pcall(function() Lock.alignOri:Destroy() end)
            Lock.alignOri = nil
        end
        if Lock.att0 then
            pcall(function() Lock.att0:Destroy() end)
            Lock.att0 = nil
        end
