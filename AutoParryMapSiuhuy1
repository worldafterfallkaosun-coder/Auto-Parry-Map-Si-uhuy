local function Dist(a,b) if not a or not b then return 9999 end return (a.Position-b.Position).Magnitude end
local function IsSelfAtk()
    if CFG.ParryWhileSwinging then return false end
    local c=MC.char; local h=MC.hum; if not c then return false end
    for _,a in ipairs(SELF_ATKS) do
        if c:GetAttribute(a)==true then return true end
