--  HP WATCH — deteksi incoming hit via HP turun
--  v9.1: trigger CombatLock:onIncoming() saat HP drop
-- ============================================================
local HPWatch = {
    lastHP   = nil,
    lastHum  = nil,
}

local function SetupHPWatch()
    local hum = MC.hum
    if not hum or hum == HPWatch.lastHum then return end
    HPWatch.lastHum = hum
    HPWatch.lastHP  = hum.Health

    hum:GetPropertyChangedSignal("Health"):Connect(function()
        local cur = hum.Health
        local prev = HPWatch.lastHP or cur
        if cur < prev then
            -- HP turun = kita kena hit
            CombatLock:onIncoming()
            -- Arm auto block (kalau parry ga tangkep)
            AutoBlock:arm(false)
            MarkCombat()
        end
        HPWatch.lastHP = cur
    end)
end

