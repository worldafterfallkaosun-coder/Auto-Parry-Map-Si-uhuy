-- ============================================================
--  HOLD MANAGER (v13)
--  Satu block ditahan selama jendela hit, bukan tap-lepas-tap.
--  win = daftar {s=mulai, e=selesai} (os.clock). Loop per-frame
--  nahan/refresh block selama ada jendela aktif, lepas kalau habis.
-- ============================================================
local Hold = { win = {}, loop = false, down = false, lastTrue = 0 }

local function HoldRelease()
    if not Hold.down then return end
    Hold.down = false
    pcall(function() RequestBlock:FireServer(false) end)
end

local function HoldInterval()
    local cap = math.max(DynRL:cap(), 4)
    return math.max(0.040, 1 / (cap * 0.85))
end

local function HoldActive(now)
    local act = false
    for k = #Hold.win, 1, -1 do
        local w = Hold.win[k]
        if now >= w.e then
            table.remove(Hold.win, k)
        elseif now >= w.s then
            act = true
        end
    end
    return act
end

local function HoldSend()
    if CFG.RefreshMode == "cycle" and Hold.down then
        pcall(function()
            RequestBlock:FireServer(false)
            RequestBlock:FireServer(true)
        end)
        RL:mark(); RL:mark()
    else
        pcall(function() RequestBlock:FireServer(true) end)
        RL:mark()
    end
    Hold.lastTrue = os.clock()
    Hold.down = true
end

local function HoldLoop()
    if Hold.loop then return end
    Hold.loop = true
    task.spawn(function()
        while #Hold.win > 0 do
            if not (Parry.on or Parry.reactMode or RDL.on) then
                Hold.win = {}
                break
            end
            local now = os.clock()
            local act = HoldActive(now)
            local char = LP.Character
            local broken = char and char:GetAttribute("GuardBroken") == true
            if act and not broken then
                local gap = 0
                if Hold.down then gap = CFG.HoldRefresh and HoldInterval() or 9e9 end
                if now - Hold.lastTrue >= gap and RL:ok() then
                    HoldSend()
                end
            elseif Hold.down and #Hold.win > 0 and not act then
                -- jeda antar dua jendela: lepas kalau jendela berikutnya masih jauh
                local nextS = math.huge
                for _, w in ipairs(Hold.win) do
                    if w.s < nextS then nextS = w.s end
                end
                if nextS - now > 0.20 then HoldRelease() end
            end
            task.wait()
        end
        HoldRelease()
        Hold.loop = false
    end)
end

local function HoldRequest(s, e)
    for _, w in ipairs(Hold.win) do
        if math.abs(w.s - s) < 0.010 and math.abs(w.e - e) < 0.010 then return end
    end
    Hold.win[#Hold.win + 1] = { s = s, e = e }
    HoldLoop()
end

-- parry sukses: buang jendela yang lagi aktif/sudah mulai, sisakan yang di masa depan
local function HoldParried()
    local now = os.clock()
    for k = #Hold.win, 1, -1 do
        if Hold.win[k].s <= now + 0.05 then table.remove(Hold.win, k) end
    end
end

-- ============================================================
--  SPAM LOCK (dipertahankan buat kompatibilitas; DoBurst gak pakai lagi)
-- ============================================================
local spamLock=false; local spamLockT=0
local function ClearSL() spamLock=false; spamLockT=0 end

-- ============================================================
--  DO BURST (v13) — jadwalin jendela hold
--  Prediksi ada (hit-delay udah dipelajari):
--      mulai  = animStart + hitDelay - RTT - lead(Thompson)
--      selesai = animStart + hitDelay + HoldTail
--  Belum ada: mulai sekarang, tahan HoldUnknown/HoldHeavy/HoldRagdoll.
-- ============================================================
local function DoBurst(heavy, urg, track, ovr, name, t0)
    local isRDL = RDL.on or urg == "ragdoll"
    local now   = os.clock()
    local hd    = name and HD[name]
    local predicted = (not isRDL and hd and hd.n >= CFG.MinSamples and t0) and (t0 + hd.d) or nil

    local s, e
    if predicted then
        local leadV = 0.04
        local pend = PendFor(name, predicted)
        if pend then
            leadV = CFG.LeadSet[pend.i] or leadV
        else
            local li, lv = Lead:pick()
            leadV = lv
            PendAdd(li, predicted, name)
        end
        s = predicted - GetPing() / 1000 - leadV
        e = predicted + CFG.HoldTail
        Parry.nextFire = math.max(Parry.nextFire, now + CFG.RefireGap)
    else
        local dur = isRDL and CFG.HoldRagdoll or (heavy and CFG.HoldHeavy or CFG.HoldUnknown)
        s = now + 0.004
        e = s + dur
    end

    HoldRequest(math.max(s, now + 0.002), math.max(e, now + 0.05))
    if isRDL then task.delay(0.065, ClearSL) else ClearSL() end
end

-- ============================================================
--  CAN FIRE / FIRE PARRY
-- ============================================================
local function CanFire(ps, urg)
    local rdl=RDL.on
    if urg=="prearm" or urg=="ragdoll" or rdl then return not IsHardKO() end
    if urg=="instant" then
        if IsHardKO() then return false end
        return not spamLock or (os.clock()-spamLockT>0.32)
    end
    if urg=="reactive" then return MC.root~=nil and not IsSelfAtk() end
    if not Parry.on then return false end
    if Parry.firing and os.clock()-Parry.fireAt<CFG.RefireGap then return false end
    if os.clock()<Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAtk() then return false end
    if ps and os.clock()-ps.lastFireT<0.060 then return false end
    return true
end

local function FireParry(heavy, ps, urg, track, name, t0)
    local rdl=RDL.on or urg=="ragdoll"
    local fast=rdl or urg=="prearm"
    if fast then Parry.firing=false;Parry.fireAt=0;Parry.nextFire=0;spamLock=false;spamLockT=0 end
    if not fast and not CanFire(ps,urg) then return false end
    local cd=BurstCD(heavy)
    if urg~="reactive" and not fast then
        Parry.firing=true; Parry.fireAt=os.clock()
        Parry.nextFire=os.clock()+cd+gamma(1.2,0.004)
    end
    if ps then ps.lastFireT=os.clock() end
    local u=rdl and "ragdoll" or (urg or "normal")
    task.spawn(function()
        DoBurst(heavy, u, track, nil, name, t0)
        if urg~="reactive" and not rdl then task.wait(0.20); Parry.firing=false end
    end)
    return true
end

