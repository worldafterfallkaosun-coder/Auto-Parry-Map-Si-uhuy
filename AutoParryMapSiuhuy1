-- ============================================================
RunService.Heartbeat:Connect(function()
    if not Parry or not AutoBlock then return end

    MaybeRotateNames()
    RefreshChar()
    AutoBlock:tick()

    if not MC.root or not MC.hum then return end
    if MC.hum.Health <= 0 then return end

    SetupHPWatch()

    if Parry.on then
        for _,p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local ec = p.Character
                if ec then
                    local er = ec:FindFirstChild("HumanoidRootPart")
                    local eh = ec:FindFirstChildWhichIsA("Humanoid")
                    if er and eh and eh.Health > 0 then
                        local ps = GetPS(p.UserId)
                        local sc, hvy, atk = Score(p, ps)
                        if atk then AutoBlock:threat(hvy) end
                        if sc >= Parry.dynThreshold then
                            FireParry(p.UserId, hvy, ps)
                        end
                    end
                end
            end
        end
    end

    Decoy:tick()
end)

print(string.format(
    "[HSA v9.1 SPECTER] Loaded | FPS:%d Ping:%dms | Cap:%d | RShift=Parry RCtrl=Lock",
    FPS.current, math.floor(Ping:get()), DynRL:cap()))
