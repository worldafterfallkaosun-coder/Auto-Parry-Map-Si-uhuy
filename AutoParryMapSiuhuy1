local function WatchOutgoing(char)
    if not char then return end
    for _,attrName in ipairs(SELF_ATKS) do
        pcall(function()
            char:GetAttributeChangedSignal(attrName):Connect(function()
                if char:GetAttribute(attrName) == true then
                    CombatLock:onOutgoing()
                end
            end)
        end)
    end
end


-- ============================================================
--  RAW PARRY — fully lognormal, variance per call
-- ============================================================
local function RawParry(tapOverride)
    if not RL:ok() then return false end
    local p  = Ping:get()
    -- v9: each tap has unique lognormal duration (no two same)
    local tap = tapOverride or LogN(-3.00, 0.09, 0.022, 0.082)
    if p>150 then tap=math.max(0.022, tap-(p-150)/6000) end

    -- lognormal pre/post jitter — different each call
    local jPre  = LogN(-4.85, 0.14, 0.003, 0.016)
    local jPost = LogN(-5.10, 0.14, 0.002, 0.012)

    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true); RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  PRIORITY PARRY — v9: single-path, reaction delay first
--
--  Anti-detect key: no simultaneous multi-path burst.
--  One path fires per attack event, with human reaction delay.
--  Burst size randomized 3–8 (never fixed).
--  Inter-tap: gamma distributed (fatigue pattern).
-- ============================================================
local spamLock  = false
local spamLockT = 0

local function DoParryBurst(isHeavy, urgency, animTrack, burstOverride)
    -- auto-release stale lock
    if spamLock and os.clock()-spamLockT > 0.65 then spamLock=false end
    if spamLock then return end
    spamLock=true; spamLockT=os.clock()

    local pingLead = Ping:lead()

    -- v9: randomized burst size 3–8 (no pattern fingerprint)
    local minB = isHeavy and 5 or 3
    local maxB = isHeavy and 8 or 6
    local count = burstOverride or math.random(minB, maxB)
    -- cap by rate
    count = math.min(count, math.floor(DynRL:cap()/2))
    count = math.max(count, 2)

    task.spawn(function()
        -- === HUMAN REACTION DELAY (key anti-detect) ===
        if urgency ~= "instant" then
            local react = ReactionDelay(isHeavy)
            -- subtract anim window time if we have it
            if animTrack then
                local ahead = AnimWindowPredict(animTrack)
                if ahead > 0.005 and ahead < react then
                    react = math.max(0.010, react - ahead)
                end
            end
            -- subtract ping lead
            react = math.max(0.008, react - pingLead)
            task.wait(react)
        else
            -- instant: minimal delay (50–80ms still, not 0)
            task.wait(LogN(-3.10, 0.08, 0.050, 0.080))
        end

        -- === TAP LOOP ===
        for i=1,count do
            local parryActive = Parry.on or Parry.reactiveMode
            if not parryActive and urgency ~= "reactive" and urgency ~= "instant" then break end
            if not RL:ok() then
                -- rate limit hit: pause with gamma delay (looks like lag)
                task.wait(Gamma(1.5, 0.08))
            end
            -- each tap unique lognormal
            local tapT = LogN(-3.02, 0.085, 0.020, 0.078)
            RawParry(tapT)
            if i < count then
                -- gamma inter-tap (human fatigue: slight slowdown mid-burst)
                local shape = 1.2 + (i/count)*0.6
                local iv = Gamma(shape, 0.030)
                iv = math.clamp(iv, 0.018, 0.095)
                task.wait(iv)
            end
        end

        spamLock=false
    end)
end

-- ============================================================
--  FIRE PARRY — gated with per-enemy reaction gate
-- ============================================================
local function CanFire(ps, reactive)
    if reactive then
        return MC.root ~= nil and not IsSelfAttacking()
    end
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock()-Parry.firingAt > 0.42 then Parry.firing=false
        else return false end
    end
    if os.clock() < Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    -- v9: per-enemy reaction gate 95ms
    if ps and os.clock()-ps.lastFireT < 0.095 then return false end
    return true
end

local function FireParry(isHeavy, ps, urgency, animTrack)
    local isReactive = (urgency=="reactive")
    if not CanFire(ps, isReactive) then return false end
    local cd  = Ping:cd(isHeavy)
    -- v9: gamma cooldown jitter (not gaussian, harder to fingerprint)
    local cdJ = Gamma(1.2, 0.008)

    if not isReactive then
        Parry.firing   = true
        Parry.firingAt = os.clock()
        Parry.nextFire = os.clock()+cd+cdJ
    end
    if ps then ps.lastFireT=os.clock() end

    task.spawn(function()
        DoParryBurst(isHeavy, urgency or "normal", animTrack, nil)
        if not isReactive then
            task.wait(0.35)
            Parry.firing=false
        end
    end)
    return true
end

-- v9: instant — still has 50–80ms delay (human minimum)
local lastInstantT=0
local function SafeFireInstant(isHeavy)
    local now=os.clock()
    if now-lastInstantT < 0.045 then return end
    lastInstantT=now
    Parry.nextFire=0; Parry.firing=false
    spamLock=false; spamLockT=0
    DoParryBurst(isHeavy or true, "instant", nil, nil)
end

-- v9: reactive (fires even parry off, on taking damage)
local lastReactT=0
local function ReactiveParry(isHeavy)
    local now=os.clock()
    if now-lastReactT < 0.10 then return end
    lastReactT=now
    Parry.reactiveMode=true
    Parry.reactiveModeExp=now+0.40
    spamLock=false; spamLockT=0
    DoParryBurst(isHeavy or false, "reactive", nil, nil)
    task.delay(0.45, function() Parry.reactiveMode=false end)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now=os.clock()
    table.insert(ps.history, {t=now,h=isHeavy,s=src})
    if #ps.history>28 then table.remove(ps.history,1) end
    ps.lastHitTime=now
    if #ps.history>=3 then
        local sum,n=0,0
        for i=2,#ps.history do
            sum=sum+ps.history[i].t-ps.history[i-1].t; n=n+1
        end
        ps.avgInterval=sum/n
    else ps.avgInterval=nil end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    if os.clock()-ps.lastHitTime>1.5 then ps.combo=0 end
    RecordHit(ps,isHeavy,src)
    ps.combo=ps.combo+1
    return ps.combo
end

local function UpdateThreshold(missed, ps)
    local target=missed and 3 or 8
    Parry.dynThreshold=Parry.dynThreshold*0.82+target*0.18
    Parry.dynThreshold=math.clamp(Parry.dynThreshold,3,10)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1
        Parry.missStreak=Parry.missStreak+1
        if ps then ps.missStreak=(ps.missStreak or 0)+1 end
        -- v9: 4+ miss streak: full state reset, wider next burst
        if Parry.consecMiss>=4 then
            spamLock=false; spamLockT=0
            Parry.consecMiss=0
            Parry.missStreak=0
            Parry.nextFire=0
        end
    else
        Parry.consecMiss=0
        Parry.missStreak=0
        if ps then ps.missStreak=0 end
    end
end

-- ============================================================
--  BUILD QUEUE — top 3 by score
-- ============================================================
local function BuildQueue()
    local q={}
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local ps=GetPS(p.UserId)
            local sc,hv=Score(p,ps)
            if sc>=Parry.dynThreshold then
                table.insert(q,{player=p,score=sc,heavy=hv,ps=ps})
            end
        end
    end
    table.sort(q,function(a,b) return a.score>b.score end)
    while #q>3 do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel=er.Velocity
    local acc=(vel-ps.prevVel).Magnitude
    if acc>=4.5 then
        local toMe=MC.root.Position-er.Position
        if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return end
        local dot=toMe.Unit:Dot(vel.Unit)
        if dot>0.18 then
            local now=os.clock()
            if now-ps.lastVelSpike>0.09 then
                ps.lastVelSpike=now
                FireParry(false,ps,"normal",nil)
            end
        end
    end
end

