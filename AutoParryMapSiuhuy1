-- panel open/close
local panelOpen=false
local function OpenP()
    panelOpen=true; Panel.Visible=true; Panel.Size=UDim2.new(0,0,0,0)
    TweenSvc:Create(Panel,TweenInfo.new(0.08,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
        {Size=UDim2.new(0,160,0,110)}):Play()
end
local function CloseP()
    panelOpen=false
    TweenSvc:Create(Panel,TweenInfo.new(0.07,Enum.EasingStyle.Quad,Enum.EasingDirection.In),
        {Size=UDim2.new(0,0,0,0)}):Play()
    task.delay(0.08,function() Panel.Visible=false end)
end
Pill.MouseButton1Click:Connect(function() if panelOpen then CloseP() else OpenP() end end)

-- UI update 4fps
local _uiT=0
local function UpdUI()
    local rdl=RDL.on
    -- pill color
    if rdl and Parry.on then
        Pill.BackgroundColor3=Color3.fromRGB(160,30,100); PS2.Color=Color3.fromRGB(240,60,160); Pill.TextColor3=Color3.fromRGB(255,180,230); Pill.Text="◈"
    elseif Parry.on and Lock.on then
        Pill.BackgroundColor3=Color3.fromRGB(0,120,88); PS2.Color=Color3.fromRGB(0,200,140); Pill.TextColor3=Color3.fromRGB(180,255,220); Pill.Text="◈"
    elseif Parry.on then
        Pill.BackgroundColor3=Color3.fromRGB(14,100,36); PS2.Color=Color3.fromRGB(22,180,65); Pill.TextColor3=Color3.fromRGB(160,255,160); Pill.Text="◈"
    elseif Lock.on then
        Pill.BackgroundColor3=Color3.fromRGB(12,60,155); PS2.Color=Color3.fromRGB(22,110,225); Pill.TextColor3=Color3.fromRGB(140,190,255); Pill.Text="◈"
    else
        Pill.BackgroundColor3=Color3.fromRGB(14,14,14); PS2.Color=Color3.fromRGB(45,45,45); Pill.TextColor3=Color3.fromRGB(140,140,140); Pill.Text="◈"
    end
    if not Panel.Visible then return end

    -- parry chip
    if Parry.on then
        PC.BackgroundColor3=rdl and Color3.fromRGB(120,16,78) or Color3.fromRGB(16,110,42)
        PC.Text=rdl and "PARRY  ⚡RDL" or "PARRY  ON"
        PC.TextColor3=rdl and Color3.fromRGB(255,140,210) or Color3.fromRGB(120,255,140)
    else
        PC.BackgroundColor3=Color3.fromRGB(22,22,22); PC.Text="PARRY  OFF"; PC.TextColor3=Color3.fromRGB(140,140,140)
    end

    -- lock chip
    if not Lock.on then
        LC.BackgroundColor3=Color3.fromRGB(22,22,22); LC.Text="LOCK   OFF"; LC.TextColor3=Color3.fromRGB(140,140,140)
    elseif not Lock.target then
        LC.BackgroundColor3=Color3.fromRGB(20,20,50); LC.Text="LOCK  NEUTRAL"; LC.TextColor3=Color3.fromRGB(80,100,165)
    elseif Lock.inCombat then
        LC.BackgroundColor3=Color3.fromRGB(140,26,26); LC.Text="LOCK  ⚔COMBAT"; LC.TextColor3=Color3.fromRGB(255,130,130)
    else
        LC.BackgroundColor3=Color3.fromRGB(14,68,152); LC.Text="LOCK  ACTIVE"; LC.TextColor3=Color3.fromRGB(120,185,255)
    end

    -- info
    Info.Text=string.format("fps:%d  p:%dms  j:%dms  |  P:%d M:%d",
        FPS.v, math.floor(GetPing()), math.floor(GetJitter()), Parry.parryN, Parry.missN)

    -- status
    if CL.active then
        local left=math.max(0,math.floor((CL.lastT+EXCHANGE_TTL-os.clock())*10)/10)
        SL.TextColor3=Color3.fromRGB(60,105,60)
        local tName=Lock.target and Lock.target.Name or "?"
        SL.Text=string.format("exchange %.1fs · %s", left, tName)
    else
        SL.TextColor3=Color3.fromRGB(40,40,40); SL.Text="idle · neutral"
    end

    -- panel stroke
    PStr.Color=Parry.on and Lock.on and Color3.fromRGB(0,190,135)
        or Parry.on and Color3.fromRGB(16,130,48)
        or Lock.on and Color3.fromRGB(16,88,198)
        or Color3.fromRGB(38,38,38)
end

RunService.RenderStepped:Connect(function()
    local now=os.clock(); if now-_uiT<0.25 then return end; _uiT=now; UpdUI()
end)

-- chip buttons
PC.MouseButton1Click:Connect(function()
    Parry.on=not Parry.on; Parry.nextFire=0; Parry.firing=false; ClearSL(); UpdUI()
end)
LC.MouseButton1Click:Connect(function()
    Lock.on=not Lock.on
    if not Lock.on then FullOff()
    else
        -- manual enable: only lock if exchange already live
        if CL.active then
            local best=GetBest(true); if best then LockOn(best); MarkCombat() end
        end
    end
    UpdUI()
end)

-- keybinds
UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode==Enum.KeyCode.RightShift then
        Parry.on=not Parry.on; Parry.nextFire=0; Parry.firing=false; ClearSL(); UpdUI()
    end
    if i.KeyCode==Enum.KeyCode.RightControl then
        Lock.on=not Lock.on
        if not Lock.on then FullOff()
        else if CL.active then local best=GetBest(true); if best then LockOn(best);MarkCombat() end end end
        UpdUI()
    end
end)

-- drag pill
do
    local dg,ds,sp=false,nil,nil
    Pill.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dg=true;ds=i.Position;sp=Pill.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then dg=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not dg then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-ds; Pill.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=false end
    end)
end

-- drag panel
do
    local dg,ds,sp=false,nil,nil
    DH.InputBegan:Connect(function(i)
