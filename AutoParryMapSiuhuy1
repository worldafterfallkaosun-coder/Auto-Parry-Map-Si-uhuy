-- chip builder
local function Chip(txt,y)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-12,0,24); b.Position=UDim2.new(0,6,0,y)
    b.BackgroundColor3=Color3.fromRGB(22,22,22)
    b.TextColor3=Color3.fromRGB(160,160,160); b.TextSize=10
    b.Font=Enum.Font.GothamBold; b.Text=txt
    b.BorderSizePixel=0; b.Parent=Panel
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    return b
end

