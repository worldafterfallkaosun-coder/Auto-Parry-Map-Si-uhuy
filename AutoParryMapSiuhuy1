    end
end)

-- ============================================================
--  PING MONITOR — expanded variance tracking
-- ============================================================
local Ping = {
    current  = 80,
    variance = 0,
    samples  = {},
    maxSamp  = 24,
    lastT    = 0,
    ema      = 80,   -- exponential moving average
}

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.18 then return end
    self.lastT = now
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples, 1) end
        local sum, sum2 = 0, 0
        for _, s in ipairs(self.samples) do sum = sum + s; sum2 = sum2 + s*s end
        local avg       = sum / #self.samples
        self.current    = avg
        self.variance   = math.sqrt(math.max(0, sum2/#self.samples - avg*avg))
        self.ema        = self.ema * 0.80 + v * 0.20
    end
end

function Ping:get()    self:update(); return self.current end
function Ping:jitter() self:update(); return self.variance end
function Ping:stable() return self.variance < 15 end

-- v10: tighter lead formula, accounts for EMA spike
function Ping:lead()
    local p = self:get()
    local j = self:jitter()
    local e = self.ema
    local spike = math.max(0, e - p)
    local base  = math.clamp((p - 25) / 900 * 3.8, 0.003, 0.24)
    local extra = math.clamp(j / 1800, 0, 0.030)
    local spikeB = math.clamp(spike / 2000, 0, 0.012)
    return base + extra + spikeB
end

function Ping:cd(heavy)
    local p    = self:get()
    local base = heavy and 0.08 or 0.11
    if p > 250 then return math.max(base * 0.22, base - 0.085)
    elseif p > 180 then return math.max(base * 0.35, base - 0.065)
    elseif p > 120 then return math.max(base * 0.50, base - 0.045)
    elseif p > 70  then return math.max(base * 0.70, base - 0.022) end
    return base
end

-- ============================================================
--  ADAPTIVE TAP DURATION — v10 tighter range
-- ============================================================
local function AdaptiveTapDuration(urgency)
    local fps  = math.max(FPS.current, 10)
    local ping = Ping:get()
    local jit  = Ping:jitter()

    local fpsBonus  = math.clamp((fps - 30) / 1000, 0, 0.022)
    local pingBonus = math.clamp((ping - 50) / 2000, 0, 0.024)
    local jitBonus  = math.clamp(jit / 2800, 0, 0.009)

    local lo = math.max(0.010, 0.018 - fpsBonus)
    local hi = math.min(0.092, 0.060 + pingBonus + jitBonus)

    if urgency == "ragdoll" or urgency == "instant" then
        lo = lo * 0.58; hi = hi * 0.68
    elseif urgency == "reactive" then
        lo = lo * 0.78; hi = hi * 0.85
    elseif urgency == "prearm" then
        -- prearm: extra tight (fire before attack lands)
        lo = lo * 0.50; hi = hi * 0.60
    end

    return lo + (hi - lo) * math.random()
end

-- ============================================================
--  ADAPTIVE BURST COUNT — v10: higher floor
-- ============================================================
local function AdaptiveBurstCount(isHeavy, urgency, capOverride)
    local fps  = FPS.current
    local ping = Ping:get()
    local jit  = Ping:jitter()
    local cap  = capOverride or math.huge

    local minB, maxB
    if urgency == "ragdoll" then
        minB = 9; maxB = 15
    elseif urgency == "instant" or urgency == "prearm" then
        minB = isHeavy and 7 or 6
        maxB = isHeavy and 14 or 11
    elseif isHeavy then
        minB = fps > 90 and 6 or 5
        maxB = fps > 90 and 12 or 9
    else
        minB = fps > 90 and 5 or 4
        maxB = fps > 90 and 9 or 7
    end

    if jit > 35 then maxB = math.max(minB, maxB - 2) end
    if ping > 200 then maxB = math.max(minB, maxB - 1) end

    return math.min(math.random(minB, maxB), cap)
end

-- ============================================================
--  MATH — lognormal + gamma
-- ============================================================
local _TWO_PI = 2 * math.pi

local function _gauss()
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    return math.sqrt(-2 * math.log(u1)) * math.cos(_TWO_PI * u2)
end

local function LogN(mu, sigma, lo, hi)
    return math.clamp(math.exp(mu + sigma * _gauss()), lo, hi)
end

local function Gamma(k, theta)
    k = math.max(k, 1.0)
    local d = k - 1/3
    local c = 1 / math.sqrt(9 * d)
    while true do
        local x, v
        repeat x = _gauss(); v = 1 + c * x until v > 0
        v = v * v * v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331 * (x*x) * (x*x) then return d * v * theta end
        if math.log(u) < 0.5*x*x + d*(1 - v + math.log(v)) then return d * v * theta end
    end
end

-- v10: prearm urgency added
local function ReactionDelay(isHeavy, urgency)
    local fpsScale = math.clamp((FPS.current - 30) / 120, 0, 0.50)
    if urgency == "prearm" then
        -- fires before attack fully lands: ultra fast
        return LogN(-4.20, 0.09, 0.005, 0.022)
    elseif urgency == "instant" or urgency == "ragdoll" then
        return LogN(-4.00, 0.10, 0.006, 0.028)
    elseif urgency == "reactive" then
        return LogN(-3.20, 0.09, 0.028, 0.060)
    elseif isHeavy then
        local lo = math.max(0.016, 0.038 * (1 - fpsScale))
        local hi = math.max(0.040, 0.078 * (1 - fpsScale * 0.5))
        return LogN(-2.45, 0.26, lo, hi)
    else
        local lo = math.max(0.028, 0.068 * (1 - fpsScale * 0.5))
        local hi = math.max(0.065, 0.150 * (1 - fpsScale * 0.3))
        return LogN(-1.92, 0.24, lo, hi)
    end
end

-- ============================================================
--  DYNAMIC RATE CAP — v10: ceiling 20, tighter probe
-- ============================================================
local DynRL = {
    floor = 5, ceiling = 20, current = 10,
    probeT = 0, probeCd = 15.0,
    hitCap = false, hardBack = false,
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hardBack then
        self.current  = math.max(self.floor, self.current - 2)
        self.hardBack = false
    elseif self.hitCap then
        self.current  = math.max(self.floor, self.current - 1)
        self.hardBack = true
    else
        self.current = math.min(self.ceiling, self.current + 1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls = {} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _, t in ipairs(self.calls) do
        if now - t < 1.0 then table.insert(fresh, t) end
    end
    self.calls = fresh
    local cap  = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap = true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

