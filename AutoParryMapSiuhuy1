-- ============================================================
--  LEARNED HIT DELAY (per animation name)
--  HD[name] = {d = ema of (hit time - anim start), n = samples}
--  Fed by: my HP drops (failed/no parry) and ParryFX (success).
-- ============================================================
local HD = {}
local _dirty = false
local function LearnDelay(name, obs)
    if not name or not obs or obs < 0.03 or obs > 0.90 then return end
    local e = HD[name]
    if not e then
        HD[name] = {d = obs, n = 1}
    else
        if e.n >= 3 and math.abs(obs - e.d) > 0.22 then return end -- outlier (combo chain etc.)
        if e.n < 3 and math.abs(obs - e.d) > 0.40 then return end
        local w = (e.n < 3) and 0.50 or 0.35
        e.d = e.d * (1 - w) + obs * w
        e.n = math.min(e.n + 1, 50)
    end
    _dirty = true
end

-- ============================================================
--  PERSISTENCE — hit-delay + statistik lead disimpen ke file
-- ============================================================
local _saveT = 0
local function HDLoad()
    if not (readfile and isfile) then return end
    local ok, data = pcall(function()
        if not isfile(CFG.SaveFile) then return nil end
        return HttpService:JSONDecode(readfile(CFG.SaveFile))
    end)
    if not ok or type(data) ~= "table" then return end
    if type(data.hd) == "table" then
        for name, e in pairs(data.hd) do
            if type(name) == "string" and type(e) == "table" and tonumber(e.d) and tonumber(e.n) then
                HD[name] = { d = tonumber(e.d), n = math.clamp(math.floor(tonumber(e.n)), 1, 50) }
            end
        end
    end
    local L = data.lead
    if type(L) == "table" and type(L.a) == "table" and type(L.b) == "table"
       and #L.a == #CFG.LeadSet and #L.b == #CFG.LeadSet then
        for i = 1, #CFG.LeadSet do
            Lead.a[i] = math.max(1, tonumber(L.a[i]) or 1)
            Lead.b[i] = math.max(1, tonumber(L.b[i]) or 1)
        end
        Lead.n = tonumber(L.n) or 0
    end
end
local function HDSave(force)
    if not writefile or not _dirty then return end
    local now = os.clock()
    if not force and now - _saveT < 20 then return end
    _saveT = now; _dirty = false
    pcall(function()
        writefile(CFG.SaveFile, HttpService:JSONEncode({ hd = HD, lead = { a = Lead.a, b = Lead.b, n = Lead.n } }))
    end)
end
HDLoad()

