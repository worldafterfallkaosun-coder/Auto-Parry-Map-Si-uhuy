    local parryActive = Parry.on or Parry.reactiveMode
    if not parryActive then Decoy:tick(); return end
    if not MC.root then RefreshChar(); return end
    if IsSelfAttacking() then return end

    local now      = os.clock()
    local scanRate = math.max(0.004, FPS.frametime * 1.0)  -- v8: 1× frametime
    if now - lastHBTime < scanRate then return end
    lastHBTime = now

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
