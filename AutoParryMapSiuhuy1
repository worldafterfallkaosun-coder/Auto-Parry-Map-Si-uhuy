local function GetSwingBonus(er, root)
    local toMe = root.Position - er.Position
    local d    = toMe.Magnitude
    if d < 0.1 then return 0 end
    local dirN = toMe / d
    local fDot = er.CFrame.LookVector:Dot(dirN)
    local sDot = math.abs(er.CFrame.RightVector:Dot(dirN))
    local b    = 0
    if fDot > 0.35 then b = b + 18 end
    if sDot > 0.28 then b = b + 12 end
    if fDot > 0.70 then b = b + 10 end
    return math.min(b, 40)
end

local function GetVelBonus(ps, er, root)
    local vel  = er.Velocity
    local prev = ps.prevVel
    ps.prevVel = vel
    local acc  = (vel - prev).Magnitude
    if acc < 1.0 then return 0 end
    local toMe = root.Position - er.Position
    if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return 0 end
    local dot = toMe.Unit:Dot(vel.Unit)
    local b   = 0
    if dot > 0.15 then b = b + math.floor(dot * 48) end
    if vel.Unit.Y < -0.22 and dot > 0.06 then b = b + 18 end
    return math.min(b, 60)
end

local function Score(p, ps)
    local now = os.clock()
    if now - ps.cacheTime < SCORE_TTL then return ps.cachedScore, ps.cachedHeavy end
    local ec   = p.Character; local root = MC.root
    if not ec or not root then ps.cachedScore = 0; return 0, false end
    local er   = ec:FindFirstChild("HumanoidRootPart")
    local eh   = ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health <= 0 then ps.cachedScore = 0; return 0, false end
    local d    = Dist(root, er)
    if d > 24 or IsFromBack(er) then ps.cachedScore = 0; return 0, false end

    local sc = 0; local hvy = false

    sc = sc + math.floor((1 - d / 24) * 24)

    local hasAttr, isHAttr = ScanAttrs(ec, eh)
    if isHAttr then sc = sc + 120; hvy = true
    elseif hasAttr then sc = sc + 78 end

    if ec:GetAttribute("InCombat")  == true then sc = sc + 16 end
    if ec:GetAttribute("FightMode") == true then sc = sc + 13 end

    local anim = eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok, tracks = pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n   = t.Animation.Name
                    local pos = t.TimePosition
                    if IsM2Anim(n) then
                        hvy  = true
                        sc   = sc + (pos <= 0.02 and 98 or pos <= 0.05 and 90 or
                                     pos < 0.15 and 72 or 54)
                        break
                    elseif IsM1Anim(n) then
                        sc   = sc + (pos <= 0.02 and 88 or pos <= 0.04 and 72 or
                                     pos < 0.12 and 58 or 38)
                        break
                    end
                end
            end
        end
    end

    if ps.heavyAlert and now < ps.heavyAlertExp then sc = sc + 52; hvy = true end
    if ps.combo > 0 then sc = sc + math.min(ps.combo * 15, 70) end

    local avg = ps.avgInterval
    if avg and avg < 0.45 then sc = sc + math.floor((1 - avg / 0.45) * 34) end

    sc = sc + GetSwingBonus(er, root)
    sc = sc + GetVelBonus(ps, er, root)

    if d < 9 then
        local toMe = (root.Position - er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector) > 0.50 then sc = sc + 24 end
    end

    local hpR = eh.Health / math.max(eh.MaxHealth, 1)
    if hpR < 0.28 then sc = sc + 22 elseif hpR < 0.52 then sc = sc + 11 end

    if ps.m2Detected and now < ps.m2DetectedExp then sc = sc + 34; hvy = true end
    if ps.missStreak >= 3 then sc = sc - math.min(ps.missStreak * 8, 42) end

    if Lock.lastAttacker  == p and now - Lock.lastAttackerT  < 8.0 then sc = sc + 32 end
    if Lock.lastHitTarget == p and now - Lock.lastHitTargetT < 8.0 then sc = sc + 22 end

    local final = math.min(sc, 320)
    ps.cachedScore = final; ps.cachedHeavy = hvy; ps.cacheTime = now
    return final, hvy
end

-- ============================================================
--  ANIM WINDOW PREDICTOR
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok, dur = pcall(function() return track.Length end)
    if not ok or not dur or dur <= 0 then return 0 end
    local pos = track.TimePosition; local spd = track.Speed
    if spd <= 0 then return 0 end
    return math.max(0, (dur * 0.15 - pos) / spd)
end

-- ============================================================
--  DECOY
-- ============================================================
local Decoy = { nextT = 0, nextSeqT = 0 }

function Decoy:schedule()    self.nextT    = os.clock() + Gamma(2.5, 4.5) + 6.0 end
function Decoy:scheduleSeq() self.nextSeqT = os.clock() + Gamma(3.0, 5.0) + 10.0 end

function Decoy:tick()
    local now = os.clock()
    if now >= self.nextT and RL:ok() then
        pcall(function()
            task.delay(LogN(-2.80, 0.15, 0.040, 0.140), function()
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end
    if now >= self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                task.wait(ReactionDelay(false, "normal"))
                if not RL:ok() then return end
                RequestBlock:FireServer(true); RL:mark()
                task.wait(AdaptiveTapDuration("normal"))
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

Decoy:schedule()
Decoy:scheduleSeq()

-- ============================================================
--  RAW PARRY — single tap press+release
-- ============================================================
local function RawParry(tapOverride, urgency)
    if not RL:ok() then return false end
    local tap   = tapOverride or AdaptiveTapDuration(urgency or "normal")
    local jPre  = LogN(-4.85, 0.13, 0.002, 0.014)
    local jPost = LogN(-5.10, 0.13, 0.002, 0.010)
    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true); RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  SPAM LOCK — prevents re-entry during burst
-- ============================================================
local spamLock  = false
local spamLockT = 0

local function ClearSpamLock() spamLock = false; spamLockT = 0 end

-- ============================================================
--  DO PARRY BURST — core firing function, v9.3 fully adaptive
-- ============================================================
local function DoParryBurst(isHeavy, urgency, animTrack, burstOverride)
    -- stale spamLock cleanup
    if spamLock and os.clock() - spamLockT > 0.55 then ClearSpamLock() end

    local isRagdoll = (urgency == "ragdoll")
    local isInstant = (urgency == "instant")

    -- ragdoll/instant bypass spamLock
    if spamLock and not isRagdoll and not isInstant then return end
    spamLock  = true
    spamLockT = os.clock()

    local pingLead = Ping:lead()
    local burstCap = math.floor(DynRL:cap() * (isRagdoll and 0.88 or 0.68))
    local count    = burstOverride or AdaptiveBurstCount(isHeavy, urgency, burstCap)
    count          = math.max(count, 2)

    task.spawn(function()
        -- === REACTION DELAY ===
        local react = ReactionDelay(isHeavy, urgency)
        if animTrack and not isInstant and not isRagdoll then
            local ahead = AnimWindowPredict(animTrack)
            if ahead > 0.005 and ahead < react then
                react = math.max(0.008, react - ahead)
            end
        end
        react = math.max(0.006, react - pingLead)
        task.wait(react)

        -- === TAP LOOP ===
        for i = 1, count do
            local parryActive = Parry.on or Parry.reactiveMode or isRagdoll or isInstant
            if not parryActive then break end

            if not RL:ok() then
                if isRagdoll then continue end
                task.wait(Gamma(1.4, 0.055))
            end

            local tapT = AdaptiveTapDuration(urgency)
            RawParry(tapT, urgency)

            if i < count then
                local shape = isRagdoll and 1.0 or (1.2 + (i / count) * 0.55)
                local scaleT = isRagdoll and 0.016 or 0.028
                local iv     = Gamma(shape, scaleT)
                iv = math.clamp(iv, isRagdoll and 0.008 or 0.013, 0.075)
                task.wait(iv)
            end
        end

        if isRagdoll then task.delay(0.08, ClearSpamLock)
        else ClearSpamLock() end
    end)
end

-- ============================================================
--  FIRE PARRY — v9.3 gating, ragdoll bypasses ALL gates
-- ============================================================
local function CanFire(ps, urgency)
    local ragdoll  = RagdollState.active
    local isReact  = (urgency == "reactive")
    local isInst   = (urgency == "instant" or urgency == "ragdoll")

    if ragdoll then
        return not IsHardKO()
    end
    if isInst then
        if IsHardKO() then return false end
        return not spamLock or (os.clock() - spamLockT > 0.40)
    end
    if isReact then
        if not MC.root then return false end
        return not IsSelfAttacking()
    end
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock() - Parry.firingAt > 0.35 then Parry.firing = false
        else return false end
    end
    if os.clock() < Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    if ps and os.clock() - ps.lastFireT < 0.075 then return false end
    return true
end

local function FireParry(isHeavy, ps, urgency, animTrack)
    local ragdoll  = RagdollState.active
    local isRdl    = ragdoll or (urgency == "ragdoll")

    if isRdl then
        Parry.firing = false; Parry.firingAt = 0; Parry.nextFire = 0
        spamLock = false; spamLockT = 0
    end

    if not isRdl and not CanFire(ps, urgency) then return false end

    local cd  = Ping:cd(isHeavy)
    local cdJ = Gamma(1.2, 0.005)

    if urgency ~= "reactive" and not isRdl then
        Parry.firing   = true
        Parry.firingAt = os.clock()
        Parry.nextFire = os.clock() + cd + cdJ
    end
    if ps then ps.lastFireT = os.clock() end

    local urg = isRdl and "ragdoll" or (urgency or "normal")
    task.spawn(function()
        DoParryBurst(isHeavy, urg, animTrack, nil)
        if urgency ~= "reactive" and not isRdl then
            task.wait(0.25)
            Parry.firing = false
        end
    end)
    return true
end

-- ============================================================
--  QUEUE CONSUMER — pops highest-priority entry and fires
-- ============================================================
local queueConsumerT = 0
local function ConsumeQueue()
    local now = os.clock()
    if now - queueConsumerT < FireQueue.minGap then return end
    queueConsumerT = now
    local e = FireQueue:pop()
    if not e then return end
    FireParry(e.isHeavy, nil, e.urgency, e.animTrack)
end

-- ============================================================
--  CONVENIENCE WRAPPERS
-- ============================================================
local lastInstantT = 0
local function SafeFireInstant(isHeavy)
    local now     = os.clock()
    local ragdoll = RagdollState.active
    local minGap  = ragdoll and 0.006 or 0.030
    if now - lastInstantT < minGap then return end
    lastInstantT = now
    Parry.nextFire = 0; Parry.firing = false
    spamLock = false; spamLockT = 0
    local urg = ragdoll and "ragdoll" or "instant"
    FireQueue:push(urg, isHeavy or true, nil)
end

local lastReactT = 0
local function ReactiveParry(isHeavy)
    local now     = os.clock()
    local ragdoll = RagdollState.active
    local minGap  = ragdoll and 0.055 or 0.085
    if now - lastReactT < minGap then return end
    lastReactT = now
    Parry.reactiveMode    = true
    Parry.reactiveModeExp = now + 0.40
    spamLock = false; spamLockT = 0
    local urg = ragdoll and "ragdoll" or "reactive"
    FireQueue:push(urg, isHeavy or false, nil)
    task.delay(0.45, function() Parry.reactiveMode = false end)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now = os.clock()
    table.insert(ps.history, { t = now, h = isHeavy, s = src })
    if #ps.history > 28 then table.remove(ps.history, 1) end
    ps.lastHitTime = now
    if #ps.history >= 3 then
        local sum, n = 0, 0
        for i = 2, #ps.history do
            sum = sum + ps.history[i].t - ps.history[i - 1].t; n = n + 1
        end
        ps.avgInterval = sum / n
    else
        ps.avgInterval = nil
    end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    if os.clock() - ps.lastHitTime > 1.5 then ps.combo = 0 end
    RecordHit(ps, isHeavy, src)
    ps.combo = ps.combo + 1
    return ps.combo
end

local function UpdateThreshold(missed, ps)
    local target = missed and 3 or 8
    Parry.dynThreshold = Parry.dynThreshold * 0.82 + target * 0.18
    Parry.dynThreshold = math.clamp(Parry.dynThreshold, 3, 10)
    if missed then
        Parry.consecMiss  = Parry.consecMiss + 1
        Parry.missStreak  = Parry.missStreak + 1
        if ps then ps.missStreak = (ps.missStreak or 0) + 1 end
        if Parry.consecMiss >= 4 then
            ClearSpamLock()
            Parry.consecMiss = 0; Parry.missStreak = 0
            Parry.nextFire   = 0
        end
    else
        Parry.consecMiss = 0; Parry.missStreak = 0
        if ps then ps.missStreak = 0 end
    end
end

-- ============================================================
--  BUILD QUEUE
-- ============================================================
local function BuildQueue()
    local q = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local ps = GetPS(p.UserId)
            local sc, hv = Score(p, ps)
            if sc >= Parry.dynThreshold then
                table.insert(q, { player = p, score = sc, heavy = hv, ps = ps })
            end
        end
    end
    table.sort(q, function(a, b) return a.score > b.score end)
    while #q > 3 do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel = er.Velocity
    local acc = (vel - ps.prevVel).Magnitude
    if acc >= 4.2 then
        local toMe = MC.root.Position - er.Position
        if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return end
        local dot = toMe.Unit:Dot(vel.Unit)
        if dot > 0.18 then
            local now = os.clock()
            if now - ps.lastVelSpike > 0.075 then
                ps.lastVelSpike = now
                FireQueue:push("normal", false, nil)
            end
        end
    end
end

-- ============================================================
--  HEARTBEAT — parry scan + queue consumer
-- ============================================================
local lastHBTime = 0

RunService.Heartbeat:Connect(function()
    if not Parry then return end
    if not CombatLock then return end

    CombatLock:tick()
    MaybeRotateNames()
    PollRagdoll()

    -- consume fire queue every frame (low cost)
    if Parry.on or Parry.reactiveMode or RagdollState.active then
        ConsumeQueue()
    end

    local parryActive = Parry.on or Parry.reactiveMode
    if not parryActive then Decoy:tick(); return end

    local ragdoll = RagdollState.active
    if not ragdoll and not MC.root then RefreshChar(); return end
    if not ragdoll and IsSelfAttacking() then return end

    local now = os.clock()
    -- scan rate: faster when high fps, or ragdoll
    local scanRate = ragdoll and 0.002 or math.max(0.003, FPS.frametime * 0.82)
    if now - lastHBTime < scanRate then return end
    lastHBTime = now

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
            if er and Dist(MC.root or er, er) <= 24 and not IsFromBack(er) then
                CheckVelPreFire(p, GetPS(p.UserId), er)
            end
        end
    end

    if Parry.on then
        if not ragdoll and now < Parry.nextFire then return end
        local q = BuildQueue()
        if #q > 0 then
            local top = q[1]; local ps = top.ps; local uid = top.player.UserId
            if top.heavy then ps.heavyAlert = true; ps.heavyAlertExp = now + 3.5 end
            local urg   = ragdoll and "ragdoll" or "normal"
            local fired = FireParry(top.heavy, ps, urg, nil)
            if fired then UpdateCombo(ps, uid, top.heavy, "HB"); UpdateThreshold(false, ps) end
        end
    end
end)

-- ============================================================
--  WATCH CHAR — priority: anim > attr > HB
-- ============================================================
local function WatchChar(p, char)
    if not char then return end
    local er  = char:FindFirstChild("HumanoidRootPart")
    local eh  = char:FindFirstChildWhichIsA("Humanoid")
    local uid = p.UserId; local ps = GetPS(uid)

    local function watchAnim(animator)
        pcall(function()
            animator.AnimationPlayed:Connect(function(track)
                local parryActive = Parry.on or Parry.reactiveMode
                local ragdoll     = RagdollState.active
                if not parryActive then return end
                if not track then return end
                if not ragdoll and IsSelfAttacking() then return end
                local ok, n = pcall(function() return track.Animation.Name end)
                if not ok or not n then return end
                local isH = IsM2Anim(n); local isM = IsM1Anim(n)
                if not isH and not isM then return end
                er = char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root, er) > 24 then return end
                if IsFromBack(er) then return end
                local now = os.clock()
                local cK  = string.format("%d_%s", uid, n)
                if now - (ps.lastAnimFire[cK] or 0) < 0.085 then return end
                ps.lastAnimFire[cK] = now
                UpdateCombo(ps, uid, isH, n)
                if isH then
                    ps.heavyAlert = true; ps.heavyAlertExp = now + 3.5
                    local urg = ragdoll and "ragdoll" or "instant"
                    FireQueue:push(urg, true, nil)
                else
                    local urg = ragdoll and "ragdoll" or "normal"
                    FireQueue:push(urg, false, track)
                end
            end)
        end)
    end

    local function onAttr(obj, attr)
        pcall(function()
            obj:GetAttributeChangedSignal(attr):Connect(function()
                local parryActive = Parry.on or Parry.reactiveMode
                local ragdoll     = RagdollState.active
                if not parryActive then return end
                if not ragdoll and IsSelfAttacking() then return end
                local v = obj:GetAttribute(attr)
                if not (v == true or (type(v) == "string" and
                    (v:lower():find("attack") or v:lower():find("heavy")))) then return end
                er = char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root, er) > 24 then return end
                if IsFromBack(er) then return end
                local isHvy = IsHeavyAttr(attr)
                local now   = os.clock()
                if now - ps.lastFireT < 0.075 then return end
                if isHvy then
                    ps.heavyAlert = true; ps.heavyAlertExp = now + 3.5
                    if not ps.m2Detected or now >= ps.m2DetectedExp then
                        ps.m2Detected = true; ps.m2DetectedExp = now + 2.2
                        UpdateCombo(ps, uid, true, attr)
                        local urg = ragdoll and "ragdoll" or "instant"
                        FireQueue:push(urg, true, nil)
                        return
                    end
                end
                UpdateCombo(ps, uid, isHvy, attr)
                local urg = ragdoll and "ragdoll" or "normal"
                FireQueue:push(urg, isHvy, nil)
            end)
        end)
    end

    if eh then
        local an = eh:FindFirstChildOfClass("Animator")
        if an then watchAnim(an)
        else
            eh.ChildAdded:Connect(function(c)
                if c:IsA("Animator") then watchAnim(c) end
            end)
        end
    end

    for _, a in ipairs(ALL_ATTR) do
        onAttr(char, a)
        if eh then onAttr(eh, a) end
    end
end

local function Watch(p)
    if not p or p == LP then return end
    local ps = GetPS(p.UserId)
    if ps.watched then return end
    ps.watched = true
