-- ============================================================
--  SCORE — 2ms cache
-- ============================================================
local function Score(p, ps)
    local now=os.clock()
    if now-ps.scT < 0.002 then return ps.sc, ps.scHvy end
    local ec=p.Character; local root=MC.root
    if not ec or not root then ps.sc=0; return 0,false end
    local er=ec:FindFirstChild("HumanoidRootPart")
    local eh=ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health<=0 then ps.sc=0; return 0,false end
    local d=Dist(root,er)
    if d>26 or FromBack(er) then ps.sc=0; return 0,false end

    local sc=0; local hvy=false
    sc = sc + math.floor((1-d/26)*28)
    local ha,hA=ScanAttrs(ec,eh)
    if hA then sc=sc+130;hvy=true elseif ha then sc=sc+85 end
    if ec:GetAttribute("InCombat")==true then sc=sc+18 end
    if ec:GetAttribute("FightMode")==true then sc=sc+15 end

    local anim=eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok,tracks=pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _,t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n=t.Animation.Name; local pos=t.TimePosition
                    if isM2(n) then hvy=true; sc=sc+(pos<=0.02 and 110 or pos<=0.05 and 98 or pos<0.15 and 80 or 60); break
                    elseif isM1(n) then sc=sc+(pos<=0.02 and 96 or pos<=0.04 and 80 or pos<0.12 and 64 or 44); break end
                end
            end
        end
    end

    if ps.heavyAlert and now<ps.heavyAlertExp then sc=sc+58;hvy=true end
    if ps.combo>0 then sc=sc+math.min(ps.combo*28,140) end
    local avg=ps.avgIv; if avg and avg<0.45 then sc=sc+math.floor((1-avg/0.45)*40) end
    if ps.m2Det and now<ps.m2DetExp then sc=sc+40;hvy=true end
    if ps.missStreak>=2 then sc=sc-math.min(ps.missStreak*22,88) end
    if Lock.lastAtk==p and now-Lock.lastAtkT<10 then sc=sc+36 end
    if Lock.lastHitTgt==p and now-Lock.lastHitTgtT<10 then sc=sc+26 end
    if ps.preArmActive and now<ps.preArmExp then sc=sc+45;hvy=true end

    -- vel approach bonus
    local vel=er.Velocity; local acc=(vel-ps.prevVel).Magnitude; ps.prevVel=vel
    if acc>=3.5 then
        local toMe=root.Position-er.Position
        if toMe.Magnitude>0.1 and vel.Magnitude>0.1 then
            local dot=toMe.Unit:Dot(vel.Unit)
            if dot>0.12 then sc=sc+math.floor(dot*52) end
        end
    end

    local hpR=eh.Health/math.max(eh.MaxHealth,1)
    if hpR<0.28 then sc=sc+26 elseif hpR<0.52 then sc=sc+13 end

    ps.sc=math.min(sc,380); ps.scHvy=hvy; ps.scT=now
    return ps.sc, ps.scHvy
end

