-- UI update
local UILast=0
local function UpdateUI()
    if Parry.on and Lock.on then
        Pill.BackgroundColor3=Color3.fromRGB(0,140,100)
        PillStroke.Color=Color3.fromRGB(0,220,155)
        Pill.TextColor3=Color3.fromRGB(200,255,230)
    elseif Parry.on then
        Pill.BackgroundColor3=Color3.fromRGB(18,120,45)
        PillStroke.Color=Color3.fromRGB(30,200,75)
        Pill.TextColor3=Color3.fromRGB(180,255,180)
    elseif Lock.on then
        Pill.BackgroundColor3=Color3.fromRGB(15,75,175)
        PillStroke.Color=Color3.fromRGB(30,120,240)
        Pill.TextColor3=Color3.fromRGB(160,200,255)
    else
        Pill.BackgroundColor3=Color3.fromRGB(16,16,16)
        PillStroke.Color=Color3.fromRGB(55,55,55)
        Pill.TextColor3=Color3.fromRGB(130,130,130)
    end
    if not Panel.Visible then return end
    if Parry.on then
        ParryChip.BackgroundColor3=Color3.fromRGB(20,130,50)
        ParryChip.Text="⚔  PARRY  ON"
        ParryChip.TextColor3=Color3.fromRGB(140,255,160)
    else
        ParryChip.BackgroundColor3=Color3.fromRGB(32,32,32)
        ParryChip.Text="⚔  PARRY  OFF"
        ParryChip.TextColor3=Color3.fromRGB(150,150,150)
    end
    if Lock.on then
        if Lock.inCombat then
            LockChip.BackgroundColor3=Color3.fromRGB(160,35,35)
            LockChip.Text="🔒  LOCK ⚔ CMB"
            LockChip.TextColor3=Color3.fromRGB(255,150,150)
        else
            LockChip.BackgroundColor3=Color3.fromRGB(18,80,168)
            LockChip.Text="🔒  LOCK  ON"
            LockChip.TextColor3=Color3.fromRGB(140,200,255)
        end
    else
        LockChip.BackgroundColor3=Color3.fromRGB(32,32,32)
        LockChip.Text="🔒  LOCK   OFF"
        LockChip.TextColor3=Color3.fromRGB(150,150,150)
    end
    -- v9.1: AutoBlock chip
    if AutoBlock then
        if AutoBlock.active then
            BlockChip.BackgroundColor3=Color3.fromRGB(20,80,155)
            BlockChip.Text="🛡  BLOCK HOLD"
            BlockChip.TextColor3=Color3.fromRGB(120,200,255)
        elseif AutoBlock.fallbackArmed then
            BlockChip.BackgroundColor3=Color3.fromRGB(120,90,10)
            BlockChip.Text="🛡  BLOCK ARM"
            BlockChip.TextColor3=Color3.fromRGB(255,210,80)
        else
            BlockChip.BackgroundColor3=Color3.fromRGB(32,32,32)
            BlockChip.Text="🛡  BLOCK  OFF"
            BlockChip.TextColor3=Color3.fromRGB(150,150,150)
        end
    end
    if Parry.on and Lock.on then PanelStroke.Color=Color3.fromRGB(0,210,150)
    elseif Lock.on then PanelStroke.Color=Color3.fromRGB(20,100,210)
    elseif Parry.on then PanelStroke.Color=Color3.fromRGB(20,140,55)
    else PanelStroke.Color=Color3.fromRGB(45,45,45) end
    StatLine.Text=string.format("fps:%d p:%dms | P:%d M:%d cap:%d",
        FPS.current,math.floor(Ping:get()),
        Parry.parryCount,Parry.missCount,DynRL:cap())
    local pct=math.clamp(RL:count()/math.max(DynRL:cap(),1),0,1)
    BarFill.Size=UDim2.new(pct,0,1,0)
    BarFill.BackgroundColor3=pct>0.75 and Color3.fromRGB(210,50,50)
        or pct>0.5 and Color3.fromRGB(215,145,20)
        or Color3.fromRGB(30,160,65)
    if Lock.target and Lock.target.Character then
        local er=Lock.target.Character:FindFirstChild("HumanoidRootPart")
        local myR=MC.root
        local d=(er and myR) and math.floor(Dist(myR,er)) or 0
        TargetLine.Text=string.format("🎯 %s  d:%d",Lock.target.Name,d)
        SetTargetVis(true)
    else
        SetTargetVis(false)
    end
end

