--  PARRY FIRE — v9.1: disarm block fallback saat parry fire
-- ============================================================
local function FireParry(uid, isHeavy, ps)
    local now = os.clock()

    -- Per-enemy gate
    if now - ps.lastFireT < 0.095 then return end
    ps.lastFireT = now

    if not RL:ok() then return end

    -- DISARM block fallback — parry yang handle, bukan block
    AutoBlock:disarm()

    local delay = ReactionDelay(isHeavy)
    task.delay(delay, function()
        if not RL:ok() then return end
        pcall(function()
            RequestBlock:FireServer(true)
            RL:mark()
            Parry.parryCount = Parry.parryCount + 1
        end)
        -- Release setelah window parry
        local hold = isHeavy and
            LogN(-2.75, 0.18, 0.055, 0.150) or
            LogN(-2.90, 0.15, 0.040, 0.130)
        task.delay(hold, function()
            pcall(function()
                if RL:ok() then
                    RequestBlock:FireServer(false)
                    RL:mark()
                end
            end)
        end)
    end)
end

-- ============================================================
--  OUTGOING HIT DETECTION
--  v9.1: deteksi saat kita ngehit — trigger CombatLock
--  Cek via attribute IsPunching, dll yang flip ke true
-- ============================================================
local OutgoingWatch = { lastAtks={} }

local function WatchOutgoing(char)
    if not char then return end
    for _,attrName in ipairs(SELF_ATKS) do
        char:GetAttributeChangedSignal(attrName):Connect(function()
            local v = char:GetAttribute(attrName)
            if v == true then
                -- kita lagi menyerang = potensi outgoing hit
                -- lock aktif
                CombatLock:onOutgoing()
                MarkCombat()
            end
        end)
    end
end

LP.CharacterAdded:Connect(function(c)
    task.wait(0.12)
    WatchOutgoing(c)
end)

