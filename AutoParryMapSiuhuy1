-- ============================================================
--  AUTO BLOCK / HOLD — v9.1 rewrite
--  Flow: parry tap (FireParry) → kalau serangan musuh masih jalan
--  setelah holdAfter, atau kita kena hit → press block & HOLD
--  sampai sinyal serangan hilang (grace) atau maxHold.
--  Selama pending/active: FireParry + Decoy diem.
-- ============================================================
local STRIKE_SELF = { "IsPunching","IsHeavyPunching","IsHitRunning","IsKickCombo","IsFiring" }

-- sengaja tanpa IsActionLocked / IsStartingBattle: itu bisa nyala pas kita sendiri lagi block/stun
local function IsSelfStriking()
    local c,h = MC.char, MC.hum
    if not c then return false end
    for _,a in ipairs(STRIKE_SELF) do
        if c:GetAttribute(a)==true then return true end
        if h and h:GetAttribute(a)==true then return true end
    end
    return false
end

local AutoBlock = {
    active=false, pending=false, token=0,
    pressT=0, cooldown=0,
    lastAtkT=-10, lastHitT=-10, episodeT=0, holdAfter=0.28, heavy=false,
    grace=0.25, minHold=0.18, maxHold=1.0,
}

local function BlockSend(v)
    pcall(function() RequestBlock:FireServer(v) end)
    RL:mark()
end

-- dipanggil tiap frame selama ada musuh nyerang
function AutoBlock:threat(isHeavy)
    local now = os.clock()
    if now - self.lastAtkT > 0.40 then          -- episode serangan baru
        self.episodeT  = now
        self.holdAfter = isHeavy and LogN(-2.15, 0.25, 0.07, 0.20)
                                  or LogN(-1.35, 0.25, 0.18, 0.42)
        self.heavy = false
    end
    self.lastAtkT = now
    if isHeavy then self.heavy = true end
end

-- HP turun + ada musuh <=16 stud = parry miss → hold langsung
function AutoBlock:onHit()
    local root = MC.root; if not root then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
            local eh = p.Character:FindFirstChildWhichIsA("Humanoid")
            if er and eh and eh.Health > 0
               and (er.Position - root.Position).Magnitude <= 16 then
                self.lastHitT = os.clock()
                return
            end
        end
    end
end

function AutoBlock:release()
    if self.active then BlockSend(false) end
    self.active   = false
    self.cooldown = os.clock() + LogN(-1.55, 0.20, 0.14, 0.32)
    self.heavy    = false
end

function AutoBlock:reset()
    self.token = self.token + 1
    if self.active then BlockSend(false) end
    self.active, self.pending = false, false
    self.lastAtkT, self.lastHitT = -10, -10
end

function AutoBlock:press(urgent)
    if not RL:ok() then self.cooldown = os.clock() + 0.05; return end
    self.pending = true
    self.token   = self.token + 1
    local tok    = self.token
    local react  = ReactionDelay(self.heavy) * (urgent and 0.35 or 0.5)
    task.delay(react, function()
        if tok ~= self.token then return end
        self.pending = false
        local alive = MC.hum and MC.hum.Health > 0
        if not Parry.on or not alive or IsSelfStriking() then
            BlockSend(false)    -- parry tap yang kena skip bisa masih nahan, lepas
            return
        end
        BlockSend(true)
        self.active  = true
        self.pressT  = os.clock()
        self.grace   = LogN(-1.45, 0.20, 0.16, 0.36)
        self.minHold = LogN(-1.75, 0.20, 0.12, 0.30)
        self.maxHold = LogN( 0.10, 0.22, 0.75, 1.60)
    end)
end

function AutoBlock:tick()
    local now = os.clock()
    if not Parry.on then
        if self.active then self:release() end
        return
    end
    local alive = MC.hum and MC.hum.Health > 0

    if self.active then
        local held = now - self.pressT
        local last = math.max(self.lastAtkT, self.lastHitT)
        if held >= self.maxHold
        or (held >= self.minHold and now - last > self.grace)
        or not alive or IsSelfStriking() then
            self:release()
        end
        return
    end

    if self.pending or now < self.cooldown then return end
    if not alive or IsSelfStriking() then return end

    local byHit = (now - self.lastHitT) < 0.15
    local byAtk = (now - self.lastAtkT) < 0.10 and (now - self.episodeT) >= self.holdAfter
    if byHit or byAtk then self:press(byHit) end
end

