env.WRAITH_DUMP = function()
    local lines = { string.format("sukses=%d gagal=%d hasil=%d", Stat.ok, Stat.fail, Lead.n) }
    for i, v in ipairs(CFG.LeadSet) do
        lines[#lines+1] = string.format("lead %.2f  a=%.1f b=%.1f  mean=%.2f",
            v, Lead.a[i], Lead.b[i], Lead.a[i] / (Lead.a[i] + Lead.b[i]))
    end
    for k, e in pairs(HD) do lines[#lines+1] = string.format("HD %s d=%.3f n=%d", k, e.d, e.n) end
    local s = table.concat(lines, "\n")
    if setclipboard then pcall(setclipboard, s) end
    print(s)
    return s
end

