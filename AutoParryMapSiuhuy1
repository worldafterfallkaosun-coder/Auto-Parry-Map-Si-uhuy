    if not self or not self.active then return end
    local now = os.clock()
    if now - self.lastExchangeT > HIT_EXCHANGE_TTL then
        self.active      = false
        self.incomingHit = false
        self.outgoingHit = false
        Lock.on          = false
        Lock.target      = nil
