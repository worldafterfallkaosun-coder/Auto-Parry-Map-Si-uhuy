-- ============================================================
local function TryPreArm(ps, uid, animName, heavy)
    if not heavy and not isM1(animName) then return end
    local now=os.clock()
    if ps.preArmActive and now<ps.preArmExp then return end
    ps.preArmActive=true; ps.preArmExp=now+0.55
    FQ:push(heavy and "prearm" or "instant", heavy, nil)
end

-- ============================================================
--  HEARTBEAT — parry scan
--  NOTE: BuildQueue only feeds FireParry, NEVER calls LockOn
-- ============================================================
local _hbT=0
RunService.Heartbeat:Connect(function()
    CL:tick(); MaybeRotate(); PollRDL()
    if Parry.on or Parry.reactMode or RDL.on then ConsumeQ() end
    local parryOn=Parry.on or Parry.reactMode
    if not parryOn then Decoy:tick(); return end
    local rdl=RDL.on
    if not rdl and not MC.root then RefreshChar(); return end
    if not rdl and IsSelfAtk() then return end
    local now=os.clock()
    local sr=rdl and 0.001 or math.max(0.002, FPS.ft*0.80)
    if now-_hbT<sr then return end; _hbT=now

    -- vel pre-fire scan (parry only, no lock)
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP and p.Character then
            local er=p.Character:FindFirstChild("HumanoidRootPart")
            if er then
                local root=MC.root or er
                if Dist(root,er)<=26 and not FromBack(er) then
                    local ps2=GPS(p.UserId)
                    local vel=er.Velocity; local acc=(vel-ps2.prevVel).Magnitude
                    if acc>=3.2 then
                        local toMe=root.Position-er.Position
                        if toMe.Magnitude>0.1 and vel.Magnitude>0.1 then
                            local dot=toMe.Unit:Dot(vel.Unit)
                            if dot>0.14 and now-ps2.lastVelSpike>0.060 then
                                ps2.lastVelSpike=now; FQ:push("normal",false,nil)
                            end
                        end
                    end
                end
            end
        end
    end

    if not Parry.on then return end
    if not rdl and now<Parry.nextFire then return end

    -- build score queue (parry targeting only)
    local q={}
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local ps2=GPS(p.UserId); local sc,hv=Score(p,ps2)
            if sc>=Parry.dynThr then q[#q+1]={p=p,sc=sc,hv=hv,ps=ps2} end
        end
    end
    table.sort(q,function(a,b) return a.sc>b.sc end)

    if #q>0 then
        local top=q[1]; local ps2=top.ps; local uid=top.p.UserId
        if top.hv then ps2.heavyAlert=true; ps2.heavyAlertExp=now+4.0 end
        local u=rdl and "ragdoll" or "normal"
        local fired=FireParry(top.hv, ps2, u, nil)
        if fired then UpdateCombo(ps2,uid,top.hv,"HB"); UpdateThr(false,ps2) end
    end
end)

-- ============================================================
--  WATCH CHAR — anim + attr listeners
-- ============================================================
local function WatchChar(p, char)
    if not char then return end
    local eh=char:FindFirstChildWhichIsA("Humanoid")
    local uid=p.UserId; local ps=GPS(uid)

    local function watchAnim(anim)
        pcall(function()
            anim.AnimationPlayed:Connect(function(track)
                if not (Parry.on or Parry.reactMode) then return end
                if not track then return end
                if not RDL.on and IsSelfAtk() then return end
                local ok,n=pcall(function() return track.Animation.Name end)
                if not ok or not n then return end
                local H=isM2(n); local M=isM1(n)
                if not H and not M then return end
                local er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>26 or FromBack(er) then return end
                local now=os.clock()
                local ck=uid.."_"..n
                if now-(ps.lastAnimFire[ck] or 0)<0.075 then return end
                ps.lastAnimFire[ck]=now
                -- pre-arm on frame 0
                if track.TimePosition<=0.020 then TryPreArm(ps,uid,n,H) end
                UpdateCombo(ps,uid,H,n)
                if H then
                    ps.heavyAlert=true; ps.heavyAlertExp=now+4.0
                    FQ:push(RDL.on and "ragdoll" or "instant", true, nil)
                else
                    FQ:push(RDL.on and "ragdoll" or "normal", false, track)
                end
            end)
        end)
    end

    local function onAttr(obj, a)
        pcall(function()
            obj:GetAttributeChangedSignal(a):Connect(function()
                if not (Parry.on or Parry.reactMode) then return end
                if not RDL.on and IsSelfAtk() then return end
                local v=obj:GetAttribute(a)
                if not (v==true or (type(v)=="string" and (v:lower():find("attack") or v:lower():find("heavy")))) then return end
                local er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>26 or FromBack(er) then return end
                local hvy=isHeavyAttr(a)
                local now=os.clock()
                if now-ps.lastFireT<0.060 then return end
                if hvy then
                    ps.heavyAlert=true; ps.heavyAlertExp=now+4.0
                    ps.preArmActive=true; ps.preArmExp=now+0.55
                    if not ps.m2Det or now>=ps.m2DetExp then
                        ps.m2Det=true; ps.m2DetExp=now+2.5
                        UpdateCombo(ps,uid,true,a)
                        FQ:push(RDL.on and "ragdoll" or "prearm", true, nil)
                        return
                    end
                end
                UpdateCombo(ps,uid,hvy,a)
                FQ:push(RDL.on and "ragdoll" or "normal", hvy, nil)
            end)
        end)
    end

    if eh then
        local an=eh:FindFirstChildOfClass("Animator")
        if an then watchAnim(an)
        else eh.ChildAdded:Connect(function(c) if c:IsA("Animator") then watchAnim(c) end end) end
    end
    for _,a in ipairs(ALL_ATTR) do
        onAttr(char,a); if eh then onAttr(eh,a) end
    end
end

