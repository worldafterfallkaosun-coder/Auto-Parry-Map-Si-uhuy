-- ============================================================
--  SCORE SYSTEM v9 — threshold 3, cache 4ms
-- ============================================================
local SCORE_TTL = 0.004

local function GetSwingBonus(er,root)
    local toMe=root.Position-er.Position
    local d=toMe.Magnitude
    if d<0.1 then return 0 end
    local dirN=toMe/d
    local fDot=er.CFrame.LookVector:Dot(dirN)
    local sDot=math.abs(er.CFrame.RightVector:Dot(dirN))
    local b=0
    if fDot>0.35 then b=b+18 end
    if sDot>0.28 then b=b+12 end
    if fDot>0.70 then b=b+10 end
    return math.min(b,40)
end

local function GetVelBonus(ps,er,root)
    local vel=er.Velocity
    local prev=ps.prevVel
    ps.prevVel=vel
    local acc=(vel-prev).Magnitude
    if acc<1.0 then return 0 end
    local toMe=root.Position-er.Position
    if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return 0 end
    local dot=toMe.Unit:Dot(vel.Unit)
    local b=0
    if dot>0.15 then b=b+math.floor(dot*46) end
    if vel.Unit.Y<-0.22 and dot>0.06 then b=b+18 end
    return math.min(b,58)
end

local function Score(p,ps)
    local now=os.clock()
    if now-ps.cacheTime<SCORE_TTL then return ps.cachedScore,ps.cachedHeavy end
    local ec=p.Character; local root=MC.root
    if not ec or not root then ps.cachedScore=0; return 0,false end
    local er=ec:FindFirstChild("HumanoidRootPart")
    local eh=ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health<=0 then ps.cachedScore=0; return 0,false end
    local d=Dist(root,er)
    if d>24 or IsFromBack(er) then ps.cachedScore=0; return 0,false end

    local sc=0; local hvy=false

    sc=sc+math.floor((1-d/24)*22)

    local hasAttr,isHAttr=ScanAttrs(ec,eh)
    if isHAttr then sc=sc+115; hvy=true
    elseif hasAttr then sc=sc+75 end

    if ec:GetAttribute("InCombat")==true  then sc=sc+16 end
    if ec:GetAttribute("FightMode")==true then sc=sc+13 end

    local anim=eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok,tracks=pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _,t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n=t.Animation.Name; local pos=t.TimePosition
                    if IsM2Anim(n) then
                        hvy=true
                        -- v9: 15% mark (earlier than v8)
                        sc=sc+(pos<=0.02 and 95 or pos<=0.05 and 88 or
                               pos<0.15 and 70 or 52)
                        break
                    elseif IsM1Anim(n) then
                        sc=sc+(pos<=0.02 and 85 or pos<=0.04 and 70 or
                               pos<0.12 and 56 or 36)
                        break
                    end
                end
            end
        end
    end

    if ps.heavyAlert and now<ps.heavyAlertExp then sc=sc+50; hvy=true end
    if ps.combo>0 then sc=sc+math.min(ps.combo*15,68) end

    local avg=ps.avgInterval
    if avg and avg<0.45 then sc=sc+math.floor((1-avg/0.45)*32) end

    sc=sc+GetSwingBonus(er,root)
    sc=sc+GetVelBonus(ps,er,root)

    if d<9 then
        local toMe=(root.Position-er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector)>0.50 then sc=sc+24 end
    end

    local hpR=eh.Health/math.max(eh.MaxHealth,1)
    if hpR<0.28 then sc=sc+20 elseif hpR<0.52 then sc=sc+10 end

    if ps.m2Detected and now<ps.m2DetectedExp then sc=sc+32; hvy=true end

    -- v9: miss streak penalty prevents over-eagerness on wrong target
    if ps.missStreak >= 3 then sc=sc-math.min(ps.missStreak*8,40) end

    local final=math.min(sc,300)
    ps.cachedScore=final; ps.cachedHeavy=hvy; ps.cacheTime=now
    return final,hvy
end

-- ============================================================
--  ANIM WINDOW PREDICTOR — v9: 15% mark
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok,dur=pcall(function() return track.Length end)
    if not ok or not dur or dur<=0 then return 0 end
    local pos=track.TimePosition; local spd=track.Speed
    if spd<=0 then return 0 end
    return math.max(0, (dur*0.15 - pos)/spd)
end

-- ============================================================
--  DECOY — v9: full human-timed sequences + timing variety
-- ============================================================
local Decoy = { nextT=0, nextSeqT=0 }

function Decoy:schedule()
    self.nextT = os.clock() + Gamma(2.5, 4.5) + 6.0
end

function Decoy:scheduleSeq()
    self.nextSeqT = os.clock() + Gamma(3.0, 5.0) + 10.0
end

function Decoy:tick()
    local now=os.clock()
    if now>=self.nextT and RL:ok() then
        pcall(function()
            -- random neutral ping
            task.delay(LogN(-2.80, 0.15, 0.040, 0.140), function()
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end
    if now>=self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                -- full human press→release with reaction delay
                local react = ReactionDelay(false)
                task.wait(react)
                if not RL:ok() then return end
                RequestBlock:FireServer(true); RL:mark()
                -- tap hold: lognormal human press
                local tap = LogN(-2.90, 0.10, 0.032, 0.095)
                task.wait(tap)
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

Decoy:schedule()
Decoy:scheduleSeq()

-- ============================================================
--  AUTO BLOCK FALLBACK — v9.1 NEW
--  Priority: Parry > AutoBlock
--  Block turun hanya kalau parry ga fire dalam armTTL window
--  Block hold lognormal: manusiawi, bukan robot-constant
-- ============================================================
local AutoBlock = {
    active        = false,
    holdUntil     = 0,
    fallbackArmed = false,
    armTime       = 0,
    armTTL        = 0.18,
    cooldown      = 0,
    cdDuration    = 0.22,
}

function AutoBlock:arm(isHeavy)
    if self.active then return end
    if os.clock() < self.cooldown then return end
    self.fallbackArmed = true
    self.armTime       = os.clock()
    self.armTTL        = isHeavy and 0.10 or 0.18
end

function AutoBlock:disarm()
    self.fallbackArmed = false
    self.active        = false
    self.holdUntil     = 0
end

function AutoBlock:tick()
    if not self then return end
    local now = os.clock()
    if self.active and now >= self.holdUntil then
        pcall(function() RequestBlock:FireServer(false) end)
        self.active   = false
        self.cooldown = now + self.cdDuration
        return
    end
    if self.fallbackArmed and not self.active then
        if now - self.armTime >= self.armTTL then
            if RL:ok() then
                local react = ReactionDelay(false) * 0.5
                task.delay(react, function()
                    if self.fallbackArmed and not self.active then
                        pcall(function()
                            RequestBlock:FireServer(true)
                            RL:mark()
                        end)
                        self.active        = true
                        self.holdUntil     = os.clock() + LogN(-1.60, 0.25, 0.12, 0.38)
                        self.fallbackArmed = false
                    end
                end)
            end
        end
    end
end

