--  COMBO / THRESHOLD (dari v9.0 — sebelumnya mati di 9.1)
--  Miss turunin threshold (lebih sensitif), sukses naikin pelan.
--  Miss SENGAJA ga nge-penalti skor per-musuh (itu kebalikan dari tujuan).
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now = os.clock()
    table.insert(ps.history, {t=now, h=isHeavy, s=src})
    if #ps.history > 28 then table.remove(ps.history, 1) end
    ps.lastHitTime = now
    if #ps.history >= 3 then
        local sum, n = 0, 0
        for i = 2, #ps.history do
            sum = sum + ps.history[i].t - ps.history[i-1].t; n = n + 1
        end
        ps.avgInterval = sum / n
    else ps.avgInterval = nil end
end

local function UpdateCombo(ps, isHeavy, src)
    if os.clock() - ps.lastHitTime > 1.5 then ps.combo = 0 end
    RecordHit(ps, isHeavy, src)
    ps.combo = ps.combo + 1
end

local function UpdateThreshold(missed, ps)
    local target = missed and 3 or 8
    Parry.dynThreshold = math.clamp(Parry.dynThreshold*0.82 + target*0.18, 3, 10)
    if missed then
        Parry.consecMiss = Parry.consecMiss + 1
        if Parry.consecMiss >= 4 then Parry.consecMiss = 0; Parry.nextFire = 0 end
    else
        Parry.consecMiss = 0
        if ps then ps.missStreak = 0 end
    end
end

-- ============================================================
--  PARRY FIRE
--  normal : reaction delay lognormal 80–220ms, dikurangi ping lead
--  urgent : 50–80ms (recovery abis dihit / FX event)
--  release SELALU dikirim (ga kena rate limit → block ga bisa nyangkut)
-- ============================================================
local FXPS = { lastFireT = 0 }

local function FireParry(uid, isHeavy, ps, urgent)
    local now = os.clock()
    if now - ps.lastFireT < 0.095 then return false end
    ps.lastFireT = now
    if not RL:ok() then return false end
    Parry.lastFireUid = uid

    local delay
    if urgent then
        delay = LogN(-2.75, 0.10, PCFG.urgentLo, PCFG.urgentHi)
    else
        delay = ReactionDelay(isHeavy)
        delay = math.max(isHeavy and PCFG.floorHeavy or PCFG.floorLight,
                         delay - Ping:lead() * PCFG.pingLeadScale)
    end

    task.delay(delay, function()
        if not RL:ok() then return end
        pcall(function() RequestBlock:FireServer(true) end)
        RL:mark()
        Parry.attempts   = Parry.attempts + 1
        Parry.parryCount = Parry.parryCount + 1
        Parry.lastFireAt = os.clock()
        local hold = isHeavy and
            LogN(-2.75, 0.18, 0.055, 0.150) or
            LogN(-2.90, 0.15, 0.040, 0.130)
        task.delay(hold, function()
            pcall(function() RequestBlock:FireServer(false) end)
            RL:mark()
        end)
    end)
    return true
end

local lastReactT = 0
local function ReactiveParry(isHeavy)
    if not Parry.on then return end
    local now = os.clock()
    if now - lastReactT < PCFG.recoverGate then return end
    lastReactT = now
    FireParry(0, isHeavy, FXPS, true)
end

-- ============================================================
--  PRECISE PARRY — 1 press per swing, timing dipelajari
--  HitOff[anim]  = kapan hit mendarat (detik sejak anim start), dipelajari pas kena hit
--  GoodOff[anim] = kapan press kita sukses (ParryFX), dipelajari pas parry berhasil
--  prioritas: GoodOff > HitOff - pressLead - ping > default sempit
--  press ga lewat rate cap (cuma 1 per swing) → ga kelaparan lagi
-- ============================================================
local HitOff, GoodOff, SeenAnim = {}, {}, {}

local function dbg(...)
    if PCFG.debug then print("[HSA]", ...) end
end

local function Learn(tbl, key, v)
    local old = tbl[key]
    tbl[key] = old and (old*(1-PCFG.learnAlpha) + v*PCFG.learnAlpha) or v
end

local function SchedulePress(name, startT)
    local now   = os.clock()
    local pingS = Ping:get() / 1000
    local age   = now - startT
    local tgt, src
    if GoodOff[name] then
        tgt, src = GoodOff[name], "good"
    elseif HitOff[name] then
        tgt, src = HitOff[name] - PCFG.pressLead - pingS, "hit"
    else
        local react = LogN(-2.25, 0.18, PCFG.defaultLo, PCFG.defaultHi)
        tgt, src = age + math.max(PCFG.floorLight, react - pingS*PCFG.pingLeadScale), "default"
    end
    tgt = tgt + (math.random() - 0.5) * 2 * PCFG.jitter
    local delay = math.max(0.012, startT + tgt - now)
    local hold  = PCFG.pressLead + LogN(-2.75, 0.15, 0.05, 0.10)
    dbg(string.format("swing %s age=%.3f src=%s press@+%.3f (delay %.3f) ping=%dms",
        name, age, src, tgt, delay, math.floor(pingS*1000)))

    task.delay(delay, function()
        if not Parry.on then return end
        pcall(function() RequestBlock:FireServer(true) end)
        RL:mark()
        Parry.attempts   = Parry.attempts + 1
        Parry.parryCount = Parry.parryCount + 1
        Parry.lastFireAt = os.clock()
        Parry.lastPressName, Parry.lastPressOff = name, os.clock() - startT
        task.delay(hold, function()
            pcall(function() RequestBlock:FireServer(false) end)
            RL:mark()
        end)
    end)
end

