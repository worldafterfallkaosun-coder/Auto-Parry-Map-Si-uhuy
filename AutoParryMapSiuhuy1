local FPS = { current=60, frametime=1/60, samples={}, maxSamp=30, lastT=os.clock() }

RunService.Heartbeat:Connect(function(dt)
    table.insert(FPS.samples, dt)
    if #FPS.samples > FPS.maxSamp then table.remove(FPS.samples,1) end
    local now = os.clock()
    if now - FPS.lastT > 0.35 then
        local sum = 0
        for _,s in ipairs(FPS.samples) do sum=sum+s end
        FPS.frametime = sum/#FPS.samples
        FPS.current   = math.floor(1/math.max(FPS.frametime,0.001))
        FPS.lastT     = now
    end
end)

-- ============================================================
--  PING MONITOR
-- ============================================================
local Ping = { current=80, samples={}, maxSamp=14, lastT=0 }

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.22 then return end
    self.lastT = now
    local ok,v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples,1) end
        local sum = 0
        for _,s in ipairs(self.samples) do sum=sum+s end
        self.current = sum/#self.samples
    end
end

function Ping:get()  self:update(); return self.current end

-- v9.2: ping lead — lebih agresif, clamp bawah dikurangi
function Ping:lead()
    local p = self:get()
    -- 50ms base lead, tambah 3ms per 10ms ping di atas 50
    return math.min(0.18, math.max(0.005, (p-30)/1000*3.2))
end

-- v9.2: cooldown adaptif — makin tinggi ping makin pendek cooldown (kompensasi latency)
function Ping:cd(heavy)
    local p    = self:get()
    local base = heavy and 0.10 or 0.14
    -- tinggi ping = parry perlu lebih awal = CD lebih pendek
    if p > 250 then return math.max(base*0.28, base-0.08)
    elseif p > 180 then return math.max(base*0.40, base-0.06)
    elseif p > 120 then return math.max(base*0.55, base-0.04)
    elseif p > 70  then return math.max(base*0.75, base-0.02) end
    return base
end

-- ============================================================
--  v9.2: ADAPTIVE TAP DURATION — scale ke FPS & Ping
--  FPS tinggi = tap lebih presisi (lebih pendek)
--  Ping tinggi = tap lebih panjang (server butuh lebih lama detect)
-- ============================================================
local function AdaptiveTapDuration()
    local fps  = math.max(FPS.current, 10)
    local ping = Ping:get()
    -- base range 22–78ms, dikurangi saat fps tinggi, ditambah saat ping besar
    local fpsBonus  = math.clamp((fps - 30) / 1000, 0, 0.018)   -- kurangi 0–18ms
    local pingBonus = math.clamp((ping - 60) / 2000, 0, 0.020)  -- tambah 0–20ms
    local lo = math.max(0.014, 0.022 - fpsBonus)
    local hi = math.min(0.095, 0.068 + pingBonus)
    return lo + (hi - lo) * math.random()
end

-- ============================================================
--  MATH — lognormal + gamma (human timing models)
-- ============================================================
local _TWO_PI = 2*math.pi

local function _gauss()
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    return math.sqrt(-2*math.log(u1)) * math.cos(_TWO_PI*u2)
end

local function LogN(mu, sigma, lo, hi)
    local v = math.exp(mu + sigma * _gauss())
    return math.clamp(v, lo, hi)
end

local function Gamma(k, theta)
    k = math.max(k, 1.0)
    local d = k - 1/3
    local c = 1 / math.sqrt(9*d)
    while true do
        local x, v
        repeat
            x = _gauss()
            v = 1 + c*x
        until v > 0
        v = v*v*v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331*(x*x)*(x*x) then
            return d*v*theta
        end
        if math.log(u) < 0.5*x*x + d*(1 - v + math.log(v)) then
            return d*v*theta
        end
    end
end

-- v9.2: reaction delay adaptif — lebih cepat saat fps tinggi
local function ReactionDelay(isHeavy)
    local fpsScale = math.clamp((FPS.current - 30) / 120, 0, 0.4)
    if isHeavy then
        -- 30–90ms, dikurangi sampai 40% saat fps tinggi
        local lo = math.max(0.020, 0.045 * (1 - fpsScale))
        local hi = math.max(0.050, 0.090 * (1 - fpsScale * 0.5))
        return LogN(-2.41, 0.30, lo, hi)
    else
        -- 55–180ms (lebih cepat dari v9.1)
        local lo = math.max(0.035, 0.080 * (1 - fpsScale * 0.5))
        local hi = math.max(0.080, 0.180 * (1 - fpsScale * 0.3))
        return LogN(-1.90, 0.28, lo, hi)
    end
end

-- ============================================================
--  DYNAMIC RATE CAP — v9.2: floor 5, ceiling 14
-- ============================================================
local DynRL = {
    floor=5, ceiling=14, current=7,
    probeT=0, probeCd=22.0,
    hitCap=false, hardBack=false,
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hardBack then
        self.current  = math.max(self.floor, self.current-2)
        self.hardBack = false
    elseif self.hitCap then
        self.current  = math.max(self.floor, self.current-1)
        self.hardBack = true
    else
        self.current = math.min(self.ceiling, self.current+1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls={} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _,t in ipairs(self.calls) do
        if now-t < 1.0 then table.insert(fresh,t) end
    end
    self.calls = fresh
    local cap = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap=true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

