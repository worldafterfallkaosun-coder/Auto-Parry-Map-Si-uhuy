local _NC = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local function RandName(len)
    local t = {}
    for i = 1, len do
        t[i] = _NC:sub(math.random(1,#_NC), math.random(1,#_NC))
    end
    return table.concat(t)
end

