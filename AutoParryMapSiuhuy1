    if not AutoBlock then return end
    if not CombatLock then return end
    MaybeRotateNames()
    -- v9.1: tick AutoBlock fallback + CombatLock neutral
    AutoBlock:tick()
    CombatLock:tick()
    -- v9.1: arm AutoBlock for any nearby threat
    if MC.root then
        for _,p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local er = p.Character:FindFirstChild("HumanoidRootPart")
                local eh = p.Character:FindFirstChildWhichIsA("Humanoid")
                if er and eh and eh.Health > 0 then
                    local ps = GetPS(p.UserId)
