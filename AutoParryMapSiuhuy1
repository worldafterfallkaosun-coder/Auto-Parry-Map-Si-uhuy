-- ============================================================
--  HELPERS
-- ============================================================
local function Dist(a,b)
    if not a or not b then return 9999 end
    return (a.Position-b.Position).Magnitude
end

local function IsSelfAttacking()
    if not CFG.SelfGuard then return false end
    local c=MC.char; local h=MC.hum
    if not c then return false end
    for _,a in ipairs(SELF_ATKS) do
        if c:GetAttribute(a)==true then return true end
        if h and h:GetAttribute(a)==true then return true end
    end
    return false
end

local function IsFromBack(er)
    if not CFG.BackParryGuard then return false end
    local root=MC.root
    if not root or not er then return false end
    local toE = er.Position-root.Position
    toE = Vector3.new(toE.X,0,toE.Z)
    if toE.Magnitude<0.1 then return false end
    local look = root.CFrame.LookVector
    look = Vector3.new(look.X,0,look.Z)
    if look.Magnitude<0.1 then return false end
    return look.Unit:Dot(toE.Unit) < CFG.BackAngleThresh
end

local function IsM2Anim(n)
    n=n:lower()
    for k in pairs(M2_KW_SET) do if n:find(k,1,true) then return true end end
    return false
end
local function IsM1Anim(n)
    n=n:lower()
    for _,k in ipairs(M1_KW) do if n:find(k,1,true) then return true end end
    return false
end
local function IsHeavyAttr(a) return M2_ATTR_SET[a]==true end

local function ScanAttrs(char, eh)
    for _,a in ipairs(ALL_ATTR) do
        local v=char:GetAttribute(a)
        if v==true then return true,IsHeavyAttr(a),a end
        if type(v)=="string" and (v:lower():find("attack") or v:lower():find("heavy")) then
            return true,IsHeavyAttr(a),a
        end
        if eh then
            v=eh:GetAttribute(a)
            if v==true then return true,IsHeavyAttr(a),a end
        end
    end
    return false,false,nil
end

-- ============================================================
--  COMBAT LOCK HELPERS (for smart lock)
-- ============================================================
local function MarkCombat()
    -- called whenever we hit or get hit
    Lock.combatTime = os.clock()
    Lock.inCombat   = true
end

local function CheckCombatNeutral()
    -- called every frame — neutralizes lock after timeout
    if not Lock.inCombat then return end
    if os.clock() - Lock.combatTime > CFG.NeutralTimeout then
        Lock.inCombat = false
        -- unlock aim when idle
        if Lock.target then
            Lock.target   = nil
            Lock.prevPos  = nil
            Lock.vel      = Vector3.zero
            if Lock.alignOri then
                pcall(function() Lock.alignOri:Destroy() end); Lock.alignOri=nil
            end
            if Lock.att0 then
                pcall(function() Lock.att0:Destroy() end); Lock.att0=nil
            end
        end
    end
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now=os.clock()
    local h=ps.history
    table.insert(h,{t=now,h=isHeavy,s=src})
    if #h>CFG.HistoryDepth then table.remove(h,1) end
    ps.lastHitTime=now
    if #h>=3 then
        local sum,n=0,0
        for i=2,#h do sum=sum+h[i].t-h[i-1].t; n=n+1 end
        ps.avgInterval=sum/n
    else ps.avgInterval=nil end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    local now=os.clock()
    if now-ps.lastHitTime>CFG.ChainWindow then
        ps.combo=0
    end
    RecordHit(ps,isHeavy,src)
    ps.combo=ps.combo+1
    return ps.combo
end

local function UpdateThreshold(missed)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1
        Parry.dynThreshold=math.max(
            CFG.ThresholdFloor,
            Parry.dynThreshold - CFG.MissDecay*math.min(Parry.consecMiss,3)
        )
    else
        Parry.consecMiss=0
        Parry.dynThreshold=math.min(CFG.ScoreThreshold, Parry.dynThreshold+1)
    end
end

-- ============================================================
--  RAW PARRY — single fire with humanized timing
-- ============================================================
local function RawParry()
    if not RL:ok() then return false end
    local p   = Ping:get()
    local tap = TapWindow()
    if p>150 then tap=math.max(CFG.TapMin, tap-(p-150)/7000) end
    local jPre  = Jitter()
    local jPost = Jitter()
    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true)
        RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  SPAM PARRY — fires SpamCount times like manual block spam
--  This is what guarantees the parry window gets hit
--  Even if timing is slightly off, one of the N fires lands
-- ============================================================
local function SpamParry(isHeavy)
    if Parry.spamActive then return end
    Parry.spamActive = true

    local count = CFG.SpamCount
    -- Heavy attacks: more fires, tighter interval
    if isHeavy then
        count = CFG.SpamCount + 2
    end

    -- Pre-fire lead: start slightly before confirmed detection
    local lead = Ping:lead()
    if CFG.PreFireLead and lead > 0.003 then
        task.wait(lead * 0.5)
    end

    task.spawn(function()
        for i = 1, count do
            if not Parry.on then break end
            if not RL:ok() then
                task.wait(0.04)  -- brief wait if rate limited, then continue
            end
            RawParry()
            if i < count then
                task.wait(CFG.SpamInterval + Jitter())
            end
        end
        Parry.spamActive = false
    end)
end

-- ============================================================
--  FIRE PARRY — main trigger with spam underneath
-- ============================================================
local function CanFire()
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock()-Parry.firingAt > CFG.FiringTimeout then
            Parry.firing=false
        else return false end
    end
    if os.clock()<Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    return true
end

local function FireParry(isHeavy, ps)
    if not CanFire() then return false end
    local cd = Ping:cd(isHeavy)
    -- cooldown jitter so period isn't perfectly regular
    local cdJ = math.random(-12,18)/1000
    Parry.firing   = true
    Parry.firingAt = os.clock()
    Parry.nextFire = os.clock() + cd + cdJ

    task.spawn(function()
        SpamParry(isHeavy)
        task.wait(CFG.SpamCount * CFG.SpamInterval + 0.05)
        Parry.firing = false
    end)
    return true
end

-- M2 instant: force-fire spam immediately, bypass cooldown check
local function FireM2Instant()
    -- reset cooldown so spam fires right now
    Parry.nextFire = 0
    Parry.firing   = false
    if Parry.spamActive then return end
    Parry.spamActive = true
    task.spawn(function()
        for i = 1, CFG.SpamCount + 2 do
            if not RL:ok() then task.wait(0.03) end
            RawParry()
            if i < CFG.SpamCount+2 then
                task.wait(CFG.SpamInterval * 0.8 + Jitter())
            end
        end
        Parry.spamActive = false
    end)
end

-- ============================================================
--  SCORE SYSTEM — lowered thresholds for max coverage
-- ============================================================
local function GetSwingBonus(er, root)
    if not CFG.AnglePredict or not root or not er then return 0 end
    local toMe = root.Position-er.Position
    local d    = toMe.Magnitude
    if d<0.1 then return 0 end
    local dirN = toMe/d
    local fDot = er.CFrame.LookVector:Dot(dirN)
    local sDot = math.abs(er.CFrame.RightVector:Dot(dirN))
    local b=0
    if fDot>0.5  then b=b+14 end
    if sDot>0.4  then b=b+10 end
    if fDot>0.78 then b=b+8  end
    return b
end

local function GetVelBonus(ps, er, root)
    if not CFG.VelSharpening or not root or not er then return 0 end
    local vel=er.Velocity; local prev=ps.prevVel
    ps.prevVel=vel
    local acc=(vel-prev).Magnitude
    if acc<2 then return 0 end
    local toMe=root.Position-er.Position
    if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return 0 end
    local dot=toMe.Unit:Dot(vel.Unit)
    local b=0
    if dot>0.25 then b=b+math.floor(dot*30) end
    if math.abs(vel.Unit.Y)>0.35 and dot>0.1 then b=b+12 end
    return math.min(b,42)
end

local SCORE_TTL = 0.018

local function Score(p, ps)
    local now=os.clock()
    if now-ps.cacheTime < SCORE_TTL then
        return ps.cachedScore, ps.cachedHeavy
    end
    local ec=p.Character; local root=MC.root
    if not ec or not root then ps.cachedScore=0; return 0,false end
    local er=ec:FindFirstChild("HumanoidRootPart")
    local eh=ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health<=0 then ps.cachedScore=0; return 0,false end
    local d=Dist(root,er)
    if d>CFG.ParryRange or IsFromBack(er) then ps.cachedScore=0; return 0,false end

    local sc=0; local hvy=false

    -- distance bonus
    sc=sc+math.floor((1-d/CFG.ParryRange)*15)

    -- attribute detection — highest weight
    local hasAttr,isHAttr=ScanAttrs(ec,eh)
    if isHAttr then sc=sc+85; hvy=true
    elseif hasAttr then sc=sc+55 end

    -- combat state
    if ec:GetAttribute("InCombat")==true  then sc=sc+12 end
    if ec:GetAttribute("FightMode")==true then sc=sc+10 end

    -- animation detection — catches what attributes miss
    local anim=eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok,tracks=pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _,t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n=t.Animation.Name; local pos=t.TimePosition
                    if IsM2Anim(n) then
                        hvy=true
                        -- score is higher at earlier positions (pre-fire)
                        sc=sc+(pos<=0.05 and 80 or pos<=0.12 and 70 or pos<0.25 and 55 or 38)
                        break
                    elseif IsM1Anim(n) then
                        sc=sc+(pos<=0.05 and 70 or pos<=0.10 and 60 or pos<0.18 and 48 or 25)
                        break
                    end
                end
            end
        end
    end

    -- heavy alert (set by FX events)
    if ps.heavyAlert and os.clock()<ps.heavyAlertExp then sc=sc+35; hvy=true end

    -- combo history
    local combo=ps.combo
    if combo>0 then sc=sc+math.min(combo*12,55) end
    local avg=ps.avgInterval
    if avg and avg<0.4 then sc=sc+math.floor((1-avg/0.4)*20) end

    -- geometry bonuses
    sc=sc+GetSwingBonus(er,root)
    sc=sc+GetVelBonus(ps,er,root)

    if d<8 then
        local toMe=(root.Position-er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector)>0.62 then sc=sc+15 end
    end

    local final=math.min(sc, CFG.ScoreMax)
    ps.cachedScore=final; ps.cachedHeavy=hvy; ps.cacheTime=now
    return final, hvy
end

-- ============================================================
--  BUILD QUEUE
-- ============================================================
local function BuildQueue()
    local q={}
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local ps=GetPS(p.UserId)
            local sc,hv=Score(p,ps)
            if sc>=Parry.dynThreshold then
                table.insert(q,{player=p,score=sc,heavy=hv,ps=ps})
            end
        end
    end
    table.sort(q,function(a,b) return a.score>b.score end)
    while #q>CFG.MaxQueueTargets do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not CFG.VelPreFire or not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel=er.Velocity; local prev=ps.prevVel
    local acc=(vel-prev).Magnitude
    if acc>=CFG.VelPreFireThresh then
        local toMe=MC.root.Position-er.Position
        if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return end
        local dot=toMe.Unit:Dot(vel.Unit)
        if dot>0.28 then
            local now=os.clock()
            if now-ps.lastVelSpike>0.14 then
                ps.lastVelSpike=now
                FireParry(false,ps)
            end
        end
    end
end

-- ============================================================
--  HEARTBEAT — main scan loop
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not Parry.on then return end
    if not MC.root then RefreshChar() end
    if not MC.root then return end
    if IsSelfAttacking() then return end

    local now=os.clock()
    if now-Parry.lastHB < CFG.HeartbeatRate then return end
    Parry.lastHB=now

    -- vel pre-fire scan
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP and p.Character then
            local er=p.Character:FindFirstChild("HumanoidRootPart")
            if er and Dist(MC.root,er)<=CFG.ParryRange then
                if not IsFromBack(er) then
                    local ps=GetPS(p.UserId)
                    CheckVelPreFire(p,ps,er)
                end
            end
        end
    end

    if now<Parry.nextFire then return end
    local q=BuildQueue()
    if #q>0 then
        local top=q[1]; local ps=top.ps; local uid=top.player.UserId
        if top.heavy then
            ps.heavyAlert=true
            ps.heavyAlertExp=now+3
        end
        local fired=FireParry(top.heavy,ps)
        if fired then UpdateCombo(ps,uid,top.heavy,"HB"); UpdateThreshold(false) end
    end
end)

-- ============================================================
--  WATCH CHAR — attribute + animation listeners
--  These fire instantly on state change = zero latency detection
-- ============================================================
local function WatchChar(p, char)
    if not char then return end
    local er=char:FindFirstChild("HumanoidRootPart")
    local eh=char:FindFirstChildWhichIsA("Humanoid")
    local uid=p.UserId
    local ps=GetPS(uid)

    local function onAttrChange(obj, attr)
        pcall(function()
            obj:GetAttributeChangedSignal(attr):Connect(function()
                if not Parry.on or IsSelfAttacking() then return end
                local v=obj:GetAttribute(attr)
                if not (v==true or (type(v)=="string" and
                    (v:lower():find("attack") or v:lower():find("heavy")))) then return end
                er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>CFG.ParryRange then return end
                if IsFromBack(er) then return end
                local isHvy=IsHeavyAttr(attr)
                if isHvy then
                    ps.heavyAlert=true
                    ps.heavyAlertExp=os.clock()+3
                    if not ps.m2Detected or os.clock()>=ps.m2DetectedExp then
                        ps.m2Detected=true
                        ps.m2DetectedExp=os.clock()+2
                        FireM2Instant(); return
                    end
                end
                UpdateCombo(ps,uid,isHvy,attr)
                FireParry(isHvy,ps)
            end)
        end)
    end

    for _,a in ipairs(ALL_ATTR) do
        onAttrChange(char,a)
        if eh then onAttrChange(eh,a) end
    end

    -- animation listener: catches anim-only attacks with no attribute
    local function watchAnim(animator)
        pcall(function()
            animator.AnimationPlayed:Connect(function(track)
                if not Parry.on or not track then return end
                if IsSelfAttacking() then return end
                local ok,n=pcall(function() return track.Animation.Name end)
                if not ok or not n then return end
                local isH=IsM2Anim(n); local isM=IsM1Anim(n)
                if not isH and not isM then return end
                er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>CFG.ParryRange then return end
                if IsFromBack(er) then return end
                local now=os.clock()
                local cK=string.format("%d_%s",uid,n)
                if now-(ps.lastAnimFire[cK] or 0) < 0.16 then return end
                ps.lastAnimFire[cK]=now
                UpdateCombo(ps,uid,isH,n)
                if isH then
                    ps.heavyAlert=true; ps.heavyAlertExp=now+3
                    FireM2Instant()
                else
                    FireParry(false,ps)
                end
            end)
        end)
    end

    if eh then
        local an=eh:FindFirstChildOfClass("Animator")
        if an then watchAnim(an)
        else eh.ChildAdded:Connect(function(c)
            if c:IsA("Animator") then watchAnim(c) end
        end) end
    end
end

