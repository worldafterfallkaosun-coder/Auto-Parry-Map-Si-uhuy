    -- target
    if Lock.target and Lock.target.Character then
        local er  = Lock.target.Character:FindFirstChild("HumanoidRootPart")
        local myR = MC.root
        local d   = (er and myR) and math.floor(Dist(myR, er)) or 0
        TargetLine.Text = string.format("🎯 %s  d:%d", Lock.target.Name, d)
        TargetLine.Visible = true
    else
        TargetLine.Visible = false
    end

    -- exchange TTL
    local exLeft = CombatLock.active and
        math.max(0, math.floor((CombatLock.lastExchangeT + HIT_EXCHANGE_TTL - os.clock()) * 10) / 10) or 0
    if CombatLock.active then
        StatusLine.TextColor3 = Color3.fromRGB(75, 115, 75)
        StatusLine.Text = string.format("exchange: %.1fs  hits:%d", exLeft, CombatLock.exchangeCount)
    else
        StatusLine.TextColor3 = Color3.fromRGB(40, 40, 40)
        StatusLine.Text = "idle — neutral"
    end

    -- queue
    QueueLine.TextColor3 = qd > 2 and Color3.fromRGB(195, 115, 28) or Color3.fromRGB(40, 40, 40)
    QueueLine.Text = qd > 0
        and string.format("queue:%d cap:%d xchg:%d", qd, DynRL:cap(), CombatLock.exchangeCount)
        or string.format("cap:%d", DynRL:cap())
end

RunService.RenderStepped:Connect(function()
    local now = os.clock()
    if now - UILast < 0.25 then return end
    UILast = now; UpdateUI()
end)

