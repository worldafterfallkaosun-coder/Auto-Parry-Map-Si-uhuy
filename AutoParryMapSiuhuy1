-- ============================================================
--  COMBAT LOCK — v9.2: Neutral vs Active
--  Neutral: Lock.on=true, Lock.target=nil (no constraint, no align)
--  Active:  Lock.on=true, Lock.target=X (full lock + align)
--  Off:     Lock.on=false (manual atau KO)
-- ============================================================
local HIT_EXCHANGE_TTL = 3.5  -- idle > 3.5s = kembali ke neutral (target nil)

local CombatLock = {
    active        = false,
    lastExchangeT = 0,
    incomingHit   = false,
    outgoingHit   = false,
}

-- Forward declarations
local LockOn, UnlockTarget, FullOff, GetBestTarget

-- v9.2: incoming hit → cari attacker terdekat dan lock ke dia
function CombatLock:onIncoming(attackerHint)
    self.incomingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
    task.defer(function()
        if not Lock.on then return end
        -- priority: attacker hint (dari FX) > attacker terdekat > best score
        local target = attackerHint
        if not target then
            -- cari player paling dekat yang sedang menyerang
            local root = MC.root
            if root then
                local closest, cd = nil, LockCFG.Range
                for _,p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local er = p.Character:FindFirstChild("HumanoidRootPart")
                        local eh = p.Character:FindFirstChild("Humanoid")
                        if er and eh and eh.Health > 0 then
                            local d = (root.Position - er.Position).Magnitude
                            -- prioritaskan yang sedang ada anim/attr attack
                            local ps = GetPS(p.UserId)
                            local sc = ps.cachedScore or 0
                            if d < cd or (d < LockCFG.Range and sc > 30) then
                                if d < LockCFG.Range then
                                    closest = p
                                    cd = d
                                end
                            end
                        end
                    end
                end
                target = closest
            end
        end
        if not target then target = GetBestTarget(true) end
        if target then
            Lock.lastAttacker  = target
            Lock.lastAttackerT = os.clock()
            LockOn(target)
        end
    end)
end

-- v9.2: outgoing hit → lock ke siapapun yang kena hit
function CombatLock:onOutgoing(targetHint)
    self.outgoingHit   = true
    self.lastExchangeT = os.clock()
    self.active        = true
    task.defer(function()
        if not Lock.on then return end
        local target = targetHint
        if not target then target = GetBestTarget(true) end
        if target then
            Lock.lastHitTarget  = target
            Lock.lastHitTargetT = os.clock()
            LockOn(target)
        end
    end)
end

-- v9.2: tick — saat idle > TTL, netral (target nil) tapi Lock.on tetap
function CombatLock:tick()
    if not self or not self.active then return end
    local now = os.clock()
    if now - self.lastExchangeT > HIT_EXCHANGE_TTL then
        self.active      = false
        self.incomingHit = false
        self.outgoingHit = false
        -- kembali ke NEUTRAL: hapus target tapi jangan matiin lock
        if Lock.on and Lock.target then
            UnlockTarget()
        end
    end
end

-- ============================================================
--  HP WATCH — detect incoming hit via HP drop (v9.1+)
-- ============================================================
local HPWatch = { lastHP=nil, lastHum=nil }

local function SetupHPWatch()
    local hum = MC.hum
    if not hum or hum == HPWatch.lastHum then return end
    HPWatch.lastHum = hum
    HPWatch.lastHP  = hum.Health
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        local cur  = hum.Health
        local prev = HPWatch.lastHP or cur
        if cur < prev then
            CombatLock:onIncoming(nil)
        end
        HPWatch.lastHP = cur
    end)
end

-- ============================================================
--  OUTGOING WATCH — detect saat kita ngehit (v9.1+)
