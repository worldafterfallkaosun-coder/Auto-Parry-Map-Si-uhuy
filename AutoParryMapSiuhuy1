-- ============================================================
--  KALMAN FILTER — v10: variance-weighted alpha
-- ============================================================
local function KalmanUpdate(ps, pos, now)
    local dt = now - ps.kalmanTime
    ps.kalmanTime = now
    if ps.kalmanPos and dt > 0 and dt < 0.30 then
        local rawVel = (pos - ps.kalmanPos) / dt
        local ping   = Ping:get()
        local jit    = Ping:jitter()
        -- v10: lower alpha when jitter is high (noisy network = trust model more)
        local alpha  = math.clamp(0.60 - (ping - 50) / 2000 - (jit / 500), 0.15, 0.75)
        local newVel = ps.kalmanVel:Lerp(rawVel, alpha)
        local rawAcc = (newVel - ps.kalmanVel) / dt
        ps.kalmanAcc = ps.kalmanAcc:Lerp(rawAcc, 0.20)
        ps.kalmanVel = newVel
        ps.isJumping = newVel.Y > 10
    end
    ps.kalmanPos = pos
end

