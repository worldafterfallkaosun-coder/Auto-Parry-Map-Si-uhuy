LockChip.MouseButton1Click:Connect(function()
    Lock.on = not Lock.on
    if not Lock.on then
        FullOff()
    else
        local best = GetBestTarget(true)
        if best then
            LockOn(best); MarkCombat()
            CombatLock.active        = true
            CombatLock.lastExchangeT = os.clock()
        end
    end
    UpdateUI()
end)

UIS.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        Parry.on = not Parry.on
        Parry.nextFire = 0; Parry.firing = false; ClearSpamLock()
        lastInstantT = 0; UpdateUI()
    end
    if i.KeyCode == Enum.KeyCode.RightControl then
        if Lock.on then
            FullOff()
        else
            Lock.on = true
            local best = GetBestTarget(true)
            if best then
                LockOn(best); MarkCombat()
                CombatLock.active        = true
                CombatLock.lastExchangeT = os.clock()
            end
        end
        UpdateUI()
    end
end)

