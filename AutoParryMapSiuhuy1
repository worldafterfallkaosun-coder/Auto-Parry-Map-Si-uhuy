        val.TextSize         = 12
        val.Font             = Enum.Font.GothamBold
        val.TextXAlignment   = Enum.TextXAlignment.Right
        val.Parent           = row

        return val
    end

    local R_Parry  = MakeRow(34,  "◈", "Parry",    "OFF",    Color3.fromRGB(200,80,80))
    local R_Block  = MakeRow(57,  "⬡", "AutoBlk",  "IDLE",   Color3.fromRGB(140,140,140))
    local R_Lock   = MakeRow(80,  "◎", "Lock",     "IDLE",   Color3.fromRGB(140,140,140))
    local R_Exch   = MakeRow(103, "↯", "Exchange", "NONE",   Color3.fromRGB(140,140,140))
    local R_Ping   = MakeRow(126, "◉", "Ping",     "—ms",    Color3.fromRGB(180,180,180))
    local R_Rate   = MakeRow(146, "⧖", "Rate",     "0/6",    Color3.fromRGB(180,180,180))

    -- Watermark
    local wm = Instance.new("TextLabel")
    wm.Size             = UDim2.new(1, -8, 0, 14)
    wm.Position         = UDim2.new(0, 4, 1, -16)
    wm.BackgroundTransparency = 1
    wm.Text             = "by Nono | discord.gg/nullstate"
    wm.TextColor3       = Color3.fromRGB(80,80,80)
    wm.TextSize         = 10
    wm.Font             = Enum.Font.Gotham
    wm.TextXAlignment   = Enum.TextXAlignment.Center
    wm.Parent           = frame

    -- Update loop
    RunService.Heartbeat:Connect(function()
        -- Parry
        if Parry and Parry.on then
            R_Parry.Text       = "ON"
            R_Parry.TextColor3 = Color3.fromRGB(80,255,120)
        else
            R_Parry.Text       = "OFF"
            R_Parry.TextColor3 = Color3.fromRGB(200,80,80)
        end

        -- AutoBlock
        if AutoBlock then
            if AutoBlock.active then
                R_Block.Text       = "HOLD"
                R_Block.TextColor3 = Color3.fromRGB(80,180,255)
            elseif AutoBlock.fallbackArmed then
                R_Block.Text       = "ARM"
                R_Block.TextColor3 = Color3.fromRGB(255,200,50)
            else
                R_Block.Text       = "IDLE"
                R_Block.TextColor3 = Color3.fromRGB(140,140,140)
            end
        end

        -- Lock
        if Lock then
            if Lock.on then
                R_Lock.Text       = "LOCKED"
                R_Lock.TextColor3 = Color3.fromRGB(255,80,80)
            elseif CombatLock and CombatLock.active then
                R_Lock.Text       = "COMBAT"
                R_Lock.TextColor3 = Color3.fromRGB(255,180,60)
            else
                R_Lock.Text       = "IDLE"
                R_Lock.TextColor3 = Color3.fromRGB(140,140,140)
            end
        end

        -- Exchange
        if CombatLock then
            if CombatLock.incomingHit and CombatLock.outgoingHit then
                R_Exch.Text       = "2-WAY"
                R_Exch.TextColor3 = Color3.fromRGB(255,100,100)
            elseif CombatLock.incomingHit then
                R_Exch.Text       = "IN"
                R_Exch.TextColor3 = Color3.fromRGB(255,150,50)
            elseif CombatLock.outgoingHit then
                R_Exch.Text       = "OUT"
                R_Exch.TextColor3 = Color3.fromRGB(100,220,100)
            else
                R_Exch.Text       = "NONE"
                R_Exch.TextColor3 = Color3.fromRGB(100,100,100)
            end
        end

        -- Ping
        R_Ping.Text = math.floor(Ping:get()) .. "ms"

        -- Rate
        local cur = RL:count()
        local cap = DynRL:cap()
        R_Rate.Text = cur .. "/" .. cap
        if cur >= cap then
            R_Rate.TextColor3 = Color3.fromRGB(255,80,80)
        elseif cur >= cap*0.7 then
            R_Rate.TextColor3 = Color3.fromRGB(255,200,50)
        else
            R_Rate.TextColor3 = Color3.fromRGB(120,220,120)
        end
    end)
end

