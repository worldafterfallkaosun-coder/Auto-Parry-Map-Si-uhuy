-- ============================================================
--  SMART LOCK — AUTO AIM SYSTEM
--  Activates: you hit or get hit → auto lock nearest/attacker
--  Deactivates: NeutralTimeout seconds of no combat → unlock
-- ============================================================

local function LockIsBlocked()
    local c=LP.Character; if not c then return true end
    for _,s in ipairs(LOCK_BLOCKED) do
        if c:GetAttribute(s)==true then return true end
    end
    return false
end

local function ValidTarget(t)
    if not t or not t.Parent then return false end
    local c=t.Character; if not c then return false end
    local h=c:FindFirstChild("Humanoid")
    if not h or h.Health<=0 then return false end
    local r=c:FindFirstChild("HumanoidRootPart"); if not r then return false end
    local myR=MC.root; if not myR then return false end
    return Dist(myR,r)<=CFG.LockLeash
end

local function DestroyConstraint()
    pcall(function()
        if Lock.alignOri then Lock.alignOri:Destroy(); Lock.alignOri=nil end
        if Lock.att0     then Lock.att0:Destroy();     Lock.att0=nil     end
    end)
end

local function SetupConstraint()
    local root=MC.root; if not root then return end
    if Lock.alignOri and Lock.alignOri.Parent==root then return end
    DestroyConstraint()
    local att=Instance.new("Attachment")
    att.Name="_AA_A0"; att.Parent=root; Lock.att0=att
    local ao=Instance.new("AlignOrientation")
    ao.Name="_AA_AO"
    ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0=att
    ao.MaxTorque=CFG.LockMaxTorque
    ao.MaxAngularVelocity=math.huge
    ao.Responsiveness=CFG.LockResponsive
    ao.RigidityEnabled=false
    ao.PrimaryAxisOnly=false
    ao.Parent=root; Lock.alignOri=ao
end

local function SetAimDir(pos)
    if not Lock.alignOri or LockIsBlocked() then return end
    local root=MC.root; if not root then return end
    local dir=pos-root.Position
    dir=Vector3.new(dir.X,dir.Y*0.1,dir.Z)
    if dir.Magnitude<0.05 then return end
    dir=dir.Unit
    local up=Vector3.new(0,1,0)
    local right=dir:Cross(up)
    if right.Magnitude<0.01 then return end
    right=right.Unit
    Lock.alignOri.CFrame=CFrame.fromMatrix(Vector3.zero,right,right:Cross(dir).Unit)
end

local function UpdateLockVel(pos)
    local now=os.clock(); local dt=now-Lock.lastVelT
    if Lock.prevPos and dt>0 and dt<0.3 then
        Lock.vel=Lock.vel:Lerp((pos-Lock.prevPos)/dt, Ping:vellerp())
    end
    Lock.prevPos=pos; Lock.lastVelT=now
end

local function PredictPos(pos, dt)
    local hv=Vector3.new(Lock.vel.X,0,Lock.vel.Z)
    return pos+hv*CFG.LockPredictFactor*dt
end

local function GetNearestEnemy(inRange)
    local root=MC.root; if not root then return nil end
    local best,bestD=nil, inRange or CFG.LockRange
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local c=p.Character; if not c then continue end
            local r=c:FindFirstChild("HumanoidRootPart")
            local h=c:FindFirstChild("Humanoid")
            if not r or not h or h.Health<=0 then continue end
            local d=Dist(root,r)
            if d<=bestD then bestD=d; best=p end
        end
    end
    return best
end

local function AutoLockOn(target)
    if not target then return end
    Lock.target=target
    Lock.expireTime=os.clock()+CFG.LockDuration
    Lock.prevPos=nil; Lock.vel=Vector3.zero
    SetupConstraint()
end

-- These are called from combat events to trigger auto-lock
local function OnYouHitSomeone(target)
    MarkCombat()
    if not Lock.on then return end  -- only auto-lock if lock mode is ON
    if target and ValidTarget(target) then
        AutoLockOn(target)
    elseif not Lock.target or not ValidTarget(Lock.target) then
        local near=GetNearestEnemy()
        if near then AutoLockOn(near) end
    end
end

local function OnYouGotHit(attacker)
    MarkCombat()
    if not Lock.on then return end
    if attacker and ValidTarget(attacker) then
        AutoLockOn(attacker)
    elseif not Lock.target or not ValidTarget(Lock.target) then
        local near=GetNearestEnemy()
        if near then AutoLockOn(near) end
    end
end

-- Hook into own character attributes to detect when YOU hit/get-hit
LP.CharacterAdded:Connect(function(c)
    local hum=c:WaitForChild("Humanoid")
    -- Watch self attack attributes
    for _,attr in ipairs(SELF_ATKS) do
        pcall(function()
            c:GetAttributeChangedSignal(attr):Connect(function()
                local v=c:GetAttribute(attr)
                if v==true then
                    -- you started attacking — mark combat + lock nearest
                    OnYouHitSomeone(Lock.target or GetNearestEnemy())
                end
            end)
        end)
    end
    -- Health decrease = got hit
    if hum then
        local prevHP=hum.Health
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health < prevHP then
                -- you got hit — find nearest attacker to lock
                OnYouGotHit(GetNearestEnemy(CFG.LockRange))
            end
            prevHP=hum.Health
        end)
    end
end)

-- Lock heartbeat: track target + neutral check
RunService.Heartbeat:Connect(function(dt)
    if Camera.CameraType~=Enum.CameraType.Custom then
        Camera.CameraType=Enum.CameraType.Custom
    end

    -- neutral decay check — unlock if been idle
    CheckCombatNeutral()

    -- if lock mode OFF and not in combat, skip aim
    if not Lock.on and not Lock.inCombat then
        if Lock.target then
            DestroyConstraint()
            Lock.target=nil
        end
        return
    end

    -- expire check
    if Lock.target and os.clock()>Lock.expireTime then
        Lock.target=nil; DestroyConstraint(); return
    end
    if Lock.target and not ValidTarget(Lock.target) then
        Lock.target=nil; DestroyConstraint(); return
    end

    -- no target? try to find one if in combat
    if not Lock.target and Lock.inCombat then
        local near=GetNearestEnemy()
        if near then AutoLockOn(near) end
        return
    end

    if not Lock.target then return end

    local ec=Lock.target.Character; if not ec then return end
    local er=ec:FindFirstChild("HumanoidRootPart"); if not er then return end
    UpdateLockVel(er.Position)
    SetAimDir(PredictPos(er.Position,dt))
end)

