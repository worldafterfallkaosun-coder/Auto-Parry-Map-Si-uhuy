-- ============================================================
--  PING MONITOR
-- ============================================================
local Ping = { current=80, samples={}, maxSamp=14, lastT=0 }

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.22 then return end
    self.lastT = now
    local ok,v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples,1) end
        local sum = 0
        for _,s in ipairs(self.samples) do sum=sum+s end
        self.current = sum / #self.samples
    end
end

function Ping:get()  self:update(); return self.current end
function Ping:lead()
    local p = self:get()
    return math.min(0.13, math.max(0, (p-50)/1000*2.6))
end
function Ping:cd(heavy)
    local p    = self:get()
    local base = heavy and 0.13 or 0.18
    if p > 200 then return math.max(base*0.40, base-0.10)
    elseif p > 130 then return math.max(base*0.55, base-0.05) end
    return base
end

-- ============================================================
--  MATH — lognormal + gamma (human timing models)
-- ============================================================
local _TWO_PI = 2 * math.pi

local function _gauss()
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    return math.sqrt(-2 * math.log(u1)) * math.cos(_TWO_PI * u2)
end

local function LogN(mu, sigma, lo, hi)
    local v = math.exp(mu + sigma * _gauss())
    return math.clamp(v, lo, hi)
end

local function Gamma(k, theta)
    k = math.max(k, 1.0)
    local d = k - 1/3
    local c = 1 / math.sqrt(9*d)
    while true do
        local x, v
        repeat
            x = _gauss()
            v = 1 + c*x
        until v > 0
        v = v*v*v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331*(x*x)*(x*x) then
            return d*v*theta
        end
        if math.log(u) < 0.5*x*x + d*(1 - v + math.log(v)) then
            return d*v*theta
        end
    end
end

local function ReactionDelay(isHeavy)
    if isHeavy then
        return LogN(-2.41, 0.30, 0.045, 0.110)  -- 45–110ms
    else
        return LogN(-1.90, 0.28, 0.080, 0.220)  -- 80–220ms
    end
end

-- ============================================================
--  DYNAMIC RATE CAP — floor 4, ceiling 12
-- ============================================================
local DynRL = {
    floor=4, ceiling=12, current=6,
    probeT=0, probeCd=28.0,
    hitCap=false, hardBack=false,
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hardBack then
        self.current  = math.max(self.floor, self.current-3)
        self.hardBack = false
    elseif self.hitCap then
        self.current  = math.max(self.floor, self.current-2)
        self.hardBack = true
    else
        self.current = math.min(self.ceiling, self.current+1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls={} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _,t in ipairs(self.calls) do
        if now-t < 1.0 then table.insert(fresh,t) end
    end
    self.calls = fresh
    local cap = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap=true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

