--  ANIM WINDOW PREDICTOR — 15% mark
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok,dur=pcall(function() return track.Length end)
    if not ok or not dur or dur<=0 then return 0 end
    local pos=track.TimePosition; local spd=track.Speed
    if spd<=0 then return 0 end
    return math.max(0, (dur*0.15 - pos)/spd)
end

-- ============================================================
--  DECOY — full human-timed sequences
-- ============================================================
local Decoy = { nextT=0, nextSeqT=0 }

function Decoy:schedule()
    self.nextT = os.clock() + Gamma(2.5, 4.5) + 6.0
end

function Decoy:scheduleSeq()
    self.nextSeqT = os.clock() + Gamma(3.0, 5.0) + 10.0
end

function Decoy:tick()
    local now=os.clock()
    if AutoBlock.active or AutoBlock.pending then return end
    if now>=self.nextT and RL:ok() then
        pcall(function()
            task.delay(LogN(-2.80, 0.15, 0.040, 0.140), function()
                if RL:ok() and not (AutoBlock.active or AutoBlock.pending) then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end
    if now>=self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                local react = ReactionDelay(false)
                task.wait(react)
                if not RL:ok() or AutoBlock.active or AutoBlock.pending then return end
                RequestBlock:FireServer(true); RL:mark()
                local tap = LogN(-2.90, 0.18, 0.055, 0.160)
                task.wait(tap)
                if RL:ok() and not (AutoBlock.active or AutoBlock.pending) then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

-- ============================================================
--  PARRY FIRE — logic sama, tapi pause pas hold block aktif
--  (release selalu dikirim, ga kena rate limit → ga bisa nyangkut)
-- ============================================================
local function FireParry(uid, isHeavy, ps)
    if AutoBlock.active or AutoBlock.pending then return end
    local now = os.clock()
    if now - ps.lastFireT < 0.095 then return end
    ps.lastFireT = now
    if not RL:ok() then return end

    local delay = ReactionDelay(isHeavy)
    task.delay(delay, function()
        if AutoBlock.active or AutoBlock.pending then return end
        if not RL:ok() then return end
        pcall(function()
            RequestBlock:FireServer(true)
            RL:mark()
            Parry.parryCount = Parry.parryCount + 1
        end)
        local hold = isHeavy and
            LogN(-2.75, 0.18, 0.055, 0.150) or
            LogN(-2.90, 0.15, 0.040, 0.130)
        task.delay(hold, function()
            if AutoBlock.active or AutoBlock.pending then return end  -- hold yang ngelepas nanti
            pcall(function() RequestBlock:FireServer(false) end)
            RL:mark()
        end)
    end)
end

