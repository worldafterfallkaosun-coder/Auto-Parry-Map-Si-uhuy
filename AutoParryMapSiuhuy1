    -- parry chip
    if Parry.on then
        local rdlTag = rdl and " ⚡RDL" or ""
        ParryChip.BackgroundColor3 = rdl and Color3.fromRGB(140, 20, 90) or Color3.fromRGB(20, 130, 50)
        ParryChip.Text      = "⚔  PARRY  ON" .. rdlTag
        ParryChip.TextColor3 = rdl and Color3.fromRGB(255, 160, 220) or Color3.fromRGB(140, 255, 160)
    else
        ParryChip.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        ParryChip.Text       = "⚔  PARRY  OFF"
        ParryChip.TextColor3 = Color3.fromRGB(150, 150, 150)
    end

    -- lock chip: OFF / NEUTRAL / ACTIVE
    if not Lock.on then
        LockChip.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        LockChip.Text       = "🔒  LOCK   OFF"
        LockChip.TextColor3 = Color3.fromRGB(150, 150, 150)
    elseif not Lock.target then
        LockChip.BackgroundColor3 = Color3.fromRGB(30, 30, 65)
        LockChip.Text       = "🔒  LOCK ◌ NTR"
        LockChip.TextColor3 = Color3.fromRGB(100, 120, 185)
    elseif Lock.inCombat then
        LockChip.BackgroundColor3 = Color3.fromRGB(160, 35, 35)
        LockChip.Text       = "🔒  LOCK ⚔ CMB"
        LockChip.TextColor3 = Color3.fromRGB(255, 150, 150)
    else
        LockChip.BackgroundColor3 = Color3.fromRGB(18, 80, 168)
        LockChip.Text       = "🔒  LOCK  ON"
        LockChip.TextColor3 = Color3.fromRGB(140, 200, 255)
    end

    if Parry.on and Lock.on then
        PanelStroke.Color = rdl and Color3.fromRGB(200, 60, 150) or Color3.fromRGB(0, 210, 150)
    elseif Lock.on then PanelStroke.Color = Color3.fromRGB(20, 100, 210)
    elseif Parry.on then PanelStroke.Color = Color3.fromRGB(20, 140, 55)
    else PanelStroke.Color = Color3.fromRGB(45, 45, 45) end

    local rdlTag = rdl and " RDL" or ""
    local ntrTag = (Lock.on and not Lock.target) and " NTR" or ""
    StatLine.Text = string.format("fps:%d p:%dms j:%dms | P:%d M:%d%s%s",
        FPS.current, math.floor(Ping:get()), math.floor(Ping:jitter()),
        Parry.parryCount, Parry.missCount, rdlTag, ntrTag)

    local pct = math.clamp(RL:count() / math.max(DynRL:cap(), 1), 0, 1)
    BarFill.Size = UDim2.new(pct, 0, 1, 0)
