-- ============================================================
--  AUTO BLOCK FALLBACK — v9.1
--  Priority: Parry > AutoBlock
--  Block turun hanya kalau parry ga fire dalam armTTL window
-- ============================================================
local AutoBlock = {
    active        = false,
    holdUntil     = 0,
    fallbackArmed = false,
    armTime       = 0,
    armTTL        = 0.18,
    cooldown      = 0,
    cdDuration    = 0.22,
}

function AutoBlock:arm(isHeavy)
    if self.active then return end
    if os.clock() < self.cooldown then return end
    self.fallbackArmed = true
    self.armTime       = os.clock()
    self.armTTL        = isHeavy and 0.10 or 0.18
end

function AutoBlock:disarm()
    self.fallbackArmed = false
    self.active        = false
    self.holdUntil     = 0
end

function AutoBlock:tick()
    if not self then return end
    local now = os.clock()

    if self.active and now >= self.holdUntil then
        pcall(function() RequestBlock:FireServer(false) end)
        self.active   = false
        self.cooldown = now + self.cdDuration
        return
    end

    if self.fallbackArmed and not self.active then
        if now - self.armTime >= self.armTTL then
            if RL:ok() then
                local react = ReactionDelay(false) * 0.5
                task.delay(react, function()
                    if self.fallbackArmed and not self.active then
                        pcall(function()
                            RequestBlock:FireServer(true)
                            RL:mark()
                        end)
                        self.active        = true
                        self.holdUntil     = os.clock() + LogN(-1.60, 0.25, 0.12, 0.38)
                        self.fallbackArmed = false
                    end
                end)
            end
        end
    end
end

