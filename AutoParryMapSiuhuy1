local RagdollState = {
    active    = false,
    detectedT = 0,
    duration  = 0,
    lastVelY  = 0,
}

local function SetRagdoll(v)
    local now = os.clock()
    if v and not RagdollState.active then
        RagdollState.active    = true
        RagdollState.detectedT = now
        RagdollState.duration  = 0
    elseif not v then
        RagdollState.active   = false
        RagdollState.duration = 0
    else
        RagdollState.duration = now - RagdollState.detectedT
    end
end

local rdlPollT = 0
local function PollRagdoll()
    local now = os.clock()
    if now - rdlPollT < 0.055 then return end
    rdlPollT = now
    local root = MC.root
    if not root then SetRagdoll(false); return end
    local vel  = root.Velocity
    local velY = vel.Y
    local velH = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local c    = MC.char
    local beingHeld = c and (
        c:GetAttribute("IsBeingCarried") == true or
        c:GetAttribute("IsBeingFinished") == true
    )
    SetRagdoll(velY < -5 or velY > 7 or velH > 20 or beingHeld)
    RagdollState.lastVelY = velY
end

-- ============================================================
--  PARRY FIRE QUEUE — v10: pre-arm lane added
-- ============================================================
local FireQueue = {
    pending  = {},
    lastFire = 0,
    minGap   = 0.018,   -- tighter than v9.3
}

function FireQueue:push(urgency, isHeavy, animTrack)
    local now = os.clock()
    -- deduplicate: allow prearm to stack on instant (different lane)
    for _, e in ipairs(self.pending) do
        if e.urgency == urgency and (now - e.t) < 0.025 then return end
    end
    local pri = ({
        ragdoll  = 6,
        prearm   = 5,   -- NEW: fires before impact
        instant  = 4,
        reactive = 3,
        combo    = 3,
        normal   = 2,
        idle     = 1,
    })[urgency] or 1
    table.insert(self.pending, {
        urgency  = urgency, isHeavy = isHeavy,
        animTrack = animTrack, t = now,
        priority = pri,
    })
    table.sort(self.pending, function(a, b) return a.priority > b.priority end)
end

function FireQueue:pop()
    local now   = os.clock()
    local fresh = {}
    for _, e in ipairs(self.pending) do
        -- prearm has a very tight valid window (90ms)
        local ttl = (e.urgency == "prearm") and 0.090 or 0.180
        if now - e.t < ttl then table.insert(fresh, e) end
    end
    self.pending = fresh
    if #self.pending == 0 then return nil end
    local e = self.pending[1]
    table.remove(self.pending, 1)
    return e
end

