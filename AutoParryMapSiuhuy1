local FPS = { current=60, frametime=1/60, samples={}, maxSamp=30, lastT=os.clock() }

RunService.Heartbeat:Connect(function(dt)
    table.insert(FPS.samples, dt)
    if #FPS.samples > FPS.maxSamp then table.remove(FPS.samples,1) end
