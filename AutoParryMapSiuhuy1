-- ============================================================
--  SCORE SYSTEM v8 — range 0–300, threshold 5
--  Added: rapid-combo bonus, wider anim window bonuses
-- ============================================================
local SCORE_TTL = 0.004  -- v8: 4ms cache (tighter)

local function GetSwingBonus(er, root)
    local toMe = root.Position - er.Position
    local d    = toMe.Magnitude
    if d < 0.1 then return 0 end
    local dirN = toMe / d
    local fDot = er.CFrame.LookVector:Dot(dirN)
    local sDot = math.abs(er.CFrame.RightVector:Dot(dirN))
    local b = 0
    if fDot > 0.35 then b = b + 18 end
    if sDot > 0.28 then b = b + 12 end
    if fDot > 0.70 then b = b + 10 end
    return math.min(b, 40)
end

local function GetVelBonus(ps, er, root)
    local vel  = er.Velocity
    local prev = ps.prevVel
    ps.prevVel = vel
    local acc  = (vel - prev).Magnitude
    if acc < 1.0 then return 0 end
    local toMe = root.Position - er.Position
    if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return 0 end
    local dot = toMe.Unit:Dot(vel.Unit)
    local b = 0
    if dot > 0.15 then b = b + math.floor(dot * 46) end
    if vel.Unit.Y < -0.22 and dot > 0.06 then b = b + 18 end
    return math.min(b, 58)
end

local function Score(p, ps)
    local now = os.clock()
    if now - ps.cacheTime < SCORE_TTL then
        return ps.cachedScore, ps.cachedHeavy
    end
    local ec   = p.Character
    local root = MC.root
    if not ec or not root then ps.cachedScore=0; return 0, false end
    local er = ec:FindFirstChild("HumanoidRootPart")
    local eh = ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health <= 0 then ps.cachedScore=0; return 0, false end

    local d = Dist(root, er)
    if d > 24 or IsFromBack(er) then ps.cachedScore=0; return 0, false end

    local sc = 0; local hvy = false

    -- Distance decay
    sc = sc + math.floor((1 - d/24) * 22)

    -- Attr scan
    local hasAttr, isHAttr = ScanAttrs(ec, eh)
    if isHAttr     then sc = sc + 115; hvy = true
    elseif hasAttr then sc = sc + 75 end

    -- State flags
    if ec:GetAttribute("InCombat") == true  then sc = sc + 16 end
    if ec:GetAttribute("FightMode") == true then sc = sc + 13 end

    -- Animation track
    local anim = eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok, tracks = pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n   = t.Animation.Name
                    local pos = t.TimePosition
                    if IsM2Anim(n) then
                        hvy = true
                        -- v8: earlier window (18% instead of 26% for pre-hitbox)
                        sc = sc + (pos <= 0.02 and 95 or pos <= 0.06 and 85 or
                                   pos < 0.18  and 68 or 50)
                        break
                    elseif IsM1Anim(n) then
                        sc = sc + (pos <= 0.02 and 85 or pos <= 0.05 and 68 or
                                   pos < 0.14  and 55 or 35)
                        break
                    end
                end
            end
        end
    end

    -- Heavy alert carryover
    if ps.heavyAlert and now < ps.heavyAlertExp then sc = sc + 48; hvy = true end

    -- Combo depth
    if ps.combo > 0 then sc = sc + math.min(ps.combo * 15, 68) end

    -- Avg interval (rapid combo pressure)
    local avg = ps.avgInterval
    if avg and avg < 0.45 then
        sc = sc + math.floor((1 - avg/0.45) * 32)
    end

    -- Swing vector
    sc = sc + GetSwingBonus(er, root)

    -- Velocity approach
    sc = sc + GetVelBonus(ps, er, root)

    -- Facing angle
    if d < 9 then
        local toMe = (root.Position - er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector) > 0.50 then sc = sc + 24 end
    end

    -- HP pressure
    local hpRatio = eh.Health / math.max(eh.MaxHealth, 1)
    if hpRatio < 0.28 then sc = sc + 20
    elseif hpRatio < 0.52 then sc = sc + 10 end

    -- M2 confirmed burst
    if ps.m2Detected and now < ps.m2DetectedExp then sc = sc + 32; hvy = true end

    local final = math.min(sc, 300)
    ps.cachedScore=final; ps.cachedHeavy=hvy; ps.cacheTime=now
    return final, hvy
end

-- ============================================================
--  DECOY SCATTER — v8: mimics actual parry pattern
--  Fires occasional false→true→false sequences to mask real ones
-- ============================================================
local Decoy = {
    nextT      = 0,
    nextSeqT   = 0,  -- decoy full press-release sequence
}

function Decoy:schedule()
    local base = 8.0 + math.abs(GaussJitter(0, 2.5))
    self.nextT = os.clock() + base + math.random() * 8.0
end

function Decoy:scheduleSeq()
    self.nextSeqT = os.clock() + math.abs(GaussJitter(14.0, 4.0)) + math.random() * 6
end

function Decoy:tick()
    local now = os.clock()

    -- Simple decoy false ping
    if now >= self.nextT and RL:ok() then
        pcall(function()
            task.delay(math.abs(GaussJitter(0.075, 0.015)), function()
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end

    -- Full press-release decoy sequence (looks like a real parry attempt)
    if now >= self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                local jPre = math.abs(GaussJitter(0.010, 0.003))
                task.wait(jPre)
                if not RL:ok() then return end
                RequestBlock:FireServer(true); RL:mark()
                local tap = LogNormal(-2.90, 0.09, 0.030, 0.090)
                task.wait(tap)
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

Decoy:schedule()
Decoy:scheduleSeq()

-- ============================================================
--  ANIM WINDOW PREDICTOR — v8: earlier trigger (18%)
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok, dur = pcall(function() return track.Length end)
    if not ok or not dur or dur <= 0 then return 0 end
    local pos = track.TimePosition
    local spd = track.Speed
    if spd <= 0 then return 0 end
    local hitCenter = dur * 0.18  -- v8: earlier than v7's 0.26
    return math.max(0, (hitCenter - pos) / spd)
end

-- ============================================================
--  RAW PARRY — lognormal tap timing
-- ============================================================
local function RawParry(tapOverride)
    if not RL:ok() then return false end
    local p   = Ping:get()
    local tap = tapOverride or LogNormal(-3.00, 0.08, 0.022, 0.080)
    if p > 150 then tap = math.max(0.022, tap - (p-150)/5800) end

    -- lognormal pre/post jitter
    local jPre  = LogNormal(-4.80, 0.12, 0.004, 0.018)
    local jPost = LogNormal(-5.00, 0.12, 0.003, 0.014)

    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true)
        RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  ADAPTIVE SPAM PARRY — v8: lognormal spacing
-- ============================================================
local spamLock  = false
local spamLockT = 0

local function AdaptiveSpamParry(isHeavy, urgency, animTrack)
    if spamLock and os.clock() - spamLockT > 0.70 then
        spamLock = false
    end
    if spamLock then return end
    spamLock  = true
    spamLockT = os.clock()
    Parry.lastSpamT = os.clock()

    local timing = Adaptive:compute()
    local count  = timing.spamCount
    if isHeavy              then count = math.min(count + 5, 15) end  -- v8: +5 on heavy
    if urgency == "instant" then count = math.min(count + 4, 15) end  -- v8: +4 on instant

    local pingLead = Ping:leadMs()

    task.spawn(function()
        -- EarlyPreFire: v8 fires before hitbox center using anim predictor
        if animTrack then
            local ahead = AnimWindowPredict(animTrack)
            if ahead > 0.001 and ahead < 0.18 then
                -- Wait to the predicted hitbox window
                task.wait(math.max(0, ahead - pingLead))
            elseif pingLead > 0.001 and urgency ~= "instant" then
                task.wait(pingLead * 0.40)
            end
        elseif pingLead > 0.001 and urgency ~= "instant" then
            task.wait(pingLead * 0.40)
        end

        for i = 1, count do
            if not Parry.on and urgency ~= "reactive" then break end
            if not RL:ok() then
                task.wait(timing.interval * 0.90)
            end
            RawParry(timing.tapTime)
            if i < count then
                -- lognormal inter-arrival (human reaction model)
                local rate = 1 / timing.interval
                local iv   = PoissonWait(rate)
                iv = math.clamp(iv, timing.interval * 0.32, timing.interval * 2.0)
                -- small lognormal micro-jitter on top
                iv = iv + math.abs(GaussJitter(0, 0.0018))
                task.wait(math.max(iv, 0.002))
            end
        end

        spamLock = false
    end)
end

-- ============================================================
--  FIRE PARRY — gated
-- ============================================================
local function CanFire(reactive)
    if reactive then
        -- reactive: skip parry-on check but still respect rate
        return MC.root ~= nil and not IsSelfAttacking()
    end
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock() - Parry.firingAt > 0.45 then
            Parry.firing = false
        else return false end
    end
    if os.clock() < Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    return true
end

local function FireParry(isHeavy, ps, urgency, animTrack)
    local isReactive = (urgency == "reactive")
    if not CanFire(isReactive) then return false end
    local cd  = Ping:cooldown(isHeavy)
    local cdJ = math.abs(GaussJitter(0, 0.008))

    if not isReactive then
        Parry.firing   = true
        Parry.firingAt = os.clock()
        Parry.nextFire = os.clock() + cd + cdJ
    end

    local timing        = Adaptive:compute()
    local totalSpamTime = timing.spamCount * (timing.tapTime + timing.interval)

    task.spawn(function()
        AdaptiveSpamParry(isHeavy, urgency or "normal", animTrack)
        if not isReactive then
            task.wait(totalSpamTime + 0.025)
            Parry.firing = false
        end
    end)

    return true
end

-- v8: instant fire — always bypasses gate
local lastInstantT = 0
local function SafeFireInstant(isHeavy, src)
    local now = os.clock()
    if now - lastInstantT < 0.048 then return end
    lastInstantT = now
    Parry.nextFire = 0
    Parry.firing   = false
    spamLock       = false
    spamLockT      = 0
    AdaptiveSpamParry(isHeavy or true, "instant", nil)
end

-- v8: reactive parry — fires even when parry off (we just got hit)
local lastReactT = 0
local function ReactiveParry(isHeavy)
    local now = os.clock()
    if now - lastReactT < 0.12 then return end
    lastReactT = now
    -- enable reactive mode window
    Parry.reactiveMode    = true
    Parry.reactiveModeExp = now + 0.45
    spamLock  = false
    spamLockT = 0
    AdaptiveSpamParry(isHeavy or false, "reactive", nil)
    task.delay(0.50, function() Parry.reactiveMode = false end)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now = os.clock()
    table.insert(ps.history, { t=now, h=isHeavy, s=src })
    if #ps.history > 28 then table.remove(ps.history, 1) end
    ps.lastHitTime = now
    if #ps.history >= 3 then
        local sum, n = 0, 0
        for i = 2, #ps.history do
            sum = sum + ps.history[i].t - ps.history[i-1].t; n = n + 1
        end
        ps.avgInterval = sum / n
    else ps.avgInterval = nil end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    if os.clock() - ps.lastHitTime > 1.5 then ps.combo = 0 end
    RecordHit(ps, isHeavy, src)
    ps.combo = ps.combo + 1
    return ps.combo
end

local function UpdateThreshold(missed)
    local target = missed and 4 or 9
    Parry.dynThreshold = Parry.dynThreshold * 0.80 + target * 0.20
    Parry.dynThreshold = math.clamp(Parry.dynThreshold, 4, 11)
    if missed then
        Parry.consecMiss = Parry.consecMiss + 1
        if Parry.consecMiss >= 3 then
            spamLock = false; spamLockT = 0
            Parry.consecMiss = 0
        end
    else
        Parry.consecMiss = 0
    end
end

-- ============================================================
--  BUILD QUEUE — top 3
-- ============================================================
local function BuildQueue()
    local q = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local ps     = GetPS(p.UserId)
            local sc, hv = Score(p, ps)
            if sc >= Parry.dynThreshold then
                table.insert(q, { player=p, score=sc, heavy=hv, ps=ps })
            end
        end
    end
    table.sort(q, function(a,b) return a.score > b.score end)
    while #q > 3 do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE — fires on approach acceleration
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel = er.Velocity
    local acc = (vel - ps.prevVel).Magnitude
    if acc >= 4.5 then
        local toMe = MC.root.Position - er.Position
        if toMe.Magnitude < 0.1 or vel.Magnitude < 0.1 then return end
        local dot = toMe.Unit:Dot(vel.Unit)
        if dot > 0.18 then
            local now = os.clock()
            if now - ps.lastVelSpike > 0.09 then
                ps.lastVelSpike = now
                FireParry(false, ps, "normal", nil)
            end
        end
    end
end

