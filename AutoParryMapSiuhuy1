local _qcT=0
local function ConsumeQ()
    local now=os.clock(); if now-_qcT<FQ.gap then return end; _qcT=now
    local e=FQ:pop(); if not e then return end
    FireParry(e.heavy, nil, e.urg, e.track, e.name, e.t0)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, heavy, src)
    local now=os.clock()
    ps.history[#ps.history+1]={t=now,h=heavy,s=src}
    if #ps.history>32 then table.remove(ps.history,1) end
    ps.lastHitT=now
    if #ps.history>=3 then
        local s,n=0,0
        for i=2,#ps.history do s=s+ps.history[i].t-ps.history[i-1].t;n=n+1 end
        ps.avgIv=s/n
    else ps.avgIv=nil end
end
local function UpdateCombo(ps,uid,heavy,src)
    if os.clock()-ps.lastHitT>1.5 then ps.combo=0 end
    RecordHit(ps,heavy,src); ps.combo=ps.combo+1; return ps.combo
end
local function UpdateThr(missed,ps)
    Parry.dynThr=Parry.dynThr*0.80+(missed and 3 or 8)*0.20
    Parry.dynThr=math.clamp(Parry.dynThr,3,10)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1; Parry.missStreak=Parry.missStreak+1
        if ps then ps.missStreak=(ps.missStreak or 0)+1 end
        if Parry.consecMiss>=3 then ClearSL();Parry.consecMiss=0;Parry.missStreak=0;Parry.nextFire=0 end
    else Parry.consecMiss=0;Parry.missStreak=0; if ps then ps.missStreak=0 end end
end

