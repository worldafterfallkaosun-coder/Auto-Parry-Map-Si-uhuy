local function RawParry(tap, urg)
    if not RL:ok() then return false end
    local jPre  = 0.001 + math.random()*0.011
    local jPost = 0.001 + math.random()*0.008
    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true); RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  SPAM LOCK
-- ============================================================
local spamLock=false; local spamLockT=0
local function ClearSL() spamLock=false; spamLockT=0 end

-- ============================================================
--  DO BURST — core, all timing from live FPS+Ping
-- ============================================================
local function DoBurst(heavy, urg, track, ovr)
    if spamLock and os.clock()-spamLockT>0.48 then ClearSL() end
    local isRDL = RDL.on or urg=="ragdoll"
    local isFst = urg=="instant" or urg=="prearm" or isRDL
    if spamLock and not isFst then return end
    spamLock=true; spamLockT=os.clock()

    local lead  = PingLead()
    local bcap  = math.floor(DynRL:cap()*(isRDL and 0.90 or 0.72))
    local count = ovr or BurstCount(heavy, urg, bcap)
    count = math.max(count, 2)

    task.spawn(function()
        -- reaction delay, offset by ping lead
        local react = ReactDelay(heavy, urg)
        if track and not isFst then
            -- anim window prediction: how far before impact
            local ok,dur=pcall(function() return track.Length end)
            if ok and dur and dur>0 then
                local ahead = math.max(0,(dur*0.18 - track.TimePosition)/math.max(track.Speed,0.01))
                if ahead>0.004 and ahead<react then react=math.max(0.005, react-ahead) end
            end
        end
        react = math.max(0.004, react - lead)
        task.wait(react)

        for i=1,count do
            if not (Parry.on or Parry.reactMode or isRDL) then break end
            if not RL:ok() then
                if isRDL then continue end
                task.wait(gamma(1.4, 0.048))
            end
            RawParry(TapDuration(urg), urg)
            if i < count then
                -- inter-tap interval: gamma distributed, scales with FPS
                local sc = isRDL and 0.013 or 0.024
                local iv = gamma(isRDL and 1.0 or (1.2+(i/count)*0.5), sc)
                task.wait(math.clamp(iv, isRDL and 0.006 or 0.010, 0.068))
            end
        end

        if isRDL then task.delay(0.065,ClearSL) else ClearSL() end
    end)
end

-- ============================================================
--  CAN FIRE / FIRE PARRY
-- ============================================================
local function CanFire(ps, urg)
    local rdl=RDL.on
    if urg=="prearm" or urg=="ragdoll" or rdl then return not IsHardKO() end
    if urg=="instant" then
        if IsHardKO() then return false end
        return not spamLock or (os.clock()-spamLockT>0.32)
    end
    if urg=="reactive" then return MC.root~=nil and not IsSelfAtk() end
    if not Parry.on then return false end
    if Parry.firing and os.clock()-Parry.fireAt<0.30 then return false end
    if os.clock()<Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAtk() then return false end
    if ps and os.clock()-ps.lastFireT<0.060 then return false end
    return true
end

local function FireParry(heavy, ps, urg, track)
    local rdl=RDL.on or urg=="ragdoll"
    local fast=rdl or urg=="prearm"
    if fast then Parry.firing=false;Parry.fireAt=0;Parry.nextFire=0;spamLock=false;spamLockT=0 end
    if not fast and not CanFire(ps,urg) then return false end
    local cd=BurstCD(heavy)
    if urg~="reactive" and not fast then
        Parry.firing=true; Parry.fireAt=os.clock()
        Parry.nextFire=os.clock()+cd+gamma(1.2,0.004)
    end
    if ps then ps.lastFireT=os.clock() end
    local u=rdl and "ragdoll" or (urg or "normal")
    task.spawn(function()
        DoBurst(heavy, u, track, nil)
        if urg~="reactive" and not rdl then task.wait(0.20); Parry.firing=false end
    end)
    return true
end

-- ============================================================
--  QUEUE CONSUMER
-- ============================================================
local _qcT=0
local function ConsumeQ()
    local now=os.clock(); if now-_qcT<FQ.gap then return end; _qcT=now
    local e=FQ:pop(); if not e then return end
    FireParry(e.heavy, nil, e.urg, e.track)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, heavy, src)
    local now=os.clock()
    ps.history[#ps.history+1]={t=now,h=heavy,s=src}
    if #ps.history>32 then table.remove(ps.history,1) end
    ps.lastHitT=now
    if #ps.history>=3 then
        local s,n=0,0
        for i=2,#ps.history do s=s+ps.history[i].t-ps.history[i-1].t;n=n+1 end
        ps.avgIv=s/n
    else ps.avgIv=nil end
end
local function UpdateCombo(ps,uid,heavy,src)
    if os.clock()-ps.lastHitT>1.5 then ps.combo=0 end
    RecordHit(ps,heavy,src); ps.combo=ps.combo+1; return ps.combo
end
local function UpdateThr(missed,ps)
    Parry.dynThr=Parry.dynThr*0.80+(missed and 3 or 8)*0.20
    Parry.dynThr=math.clamp(Parry.dynThr,3,10)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1; Parry.missStreak=Parry.missStreak+1
        if ps then ps.missStreak=(ps.missStreak or 0)+1 end
        if Parry.consecMiss>=3 then ClearSL();Parry.consecMiss=0;Parry.missStreak=0;Parry.nextFire=0 end
    else Parry.consecMiss=0;Parry.missStreak=0; if ps then ps.missStreak=0 end end
end

