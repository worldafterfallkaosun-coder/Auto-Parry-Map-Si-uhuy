local function LockBlocked()
    local c = LP.Character; if not c then return true end
    for _, s in ipairs(KO_ATTRS) do
        if c:GetAttribute(s) == true then return true end
    end
    return false
end

local function ValidTarget(t)
    if not t or not t.Parent then return false end
    local c = t.Character; if not c then return false end
    local h = c:FindFirstChild("Humanoid")
    if not h or h.Health <= 0 then return false end
    local r = c:FindFirstChild("HumanoidRootPart"); if not r then return false end
    return MC.root and Dist(MC.root, r) <= LockCFG.LeashRange
end

local function DestroyConstraint()
    pcall(function()
        if Lock.alignOri then Lock.alignOri:Destroy(); Lock.alignOri = nil end
        if Lock.att0     then Lock.att0:Destroy();     Lock.att0     = nil end
    end)
end

local function SetupConstraint()
    local root = MC.root; if not root then return end
    if Lock.alignOri and Lock.alignOri.Parent == root then return end
    DestroyConstraint()
    local att = Instance.new("Attachment")
    att.Name   = ATT_NAME; att.Parent = root; Lock.att0 = att
    local ao   = Instance.new("AlignOrientation")
    ao.Name    = AO_NAME
    ao.Mode    = Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0 = att; ao.MaxTorque = LockCFG.MaxTorque
    ao.MaxAngularVelocity = math.huge
    ao.Responsiveness     = LockCFG.Responsiveness
    ao.RigidityEnabled    = false
    ao.PrimaryAxisOnly    = false
    ao.Parent             = root
    Lock.alignOri = ao
end

local function UpdateVel(pos)
    local now = os.clock(); local dt = now - Lock.lastVelT
    if Lock.prevPos and dt > 0 and dt < 0.3 then
        local rawVel = (pos - Lock.prevPos) / dt
        local alpha  = math.clamp(0.35 - (Ping:get() - 80) / 2200, 0.12, 0.52)
        Lock.vel = Lock.vel:Lerp(rawVel, alpha)
    end
    Lock.prevPos = pos; Lock.lastVelT = now
end

local function Predict(pos, dt)
    local hv = Vector3.new(Lock.vel.X, Lock.vel.Y * 0.12, Lock.vel.Z)
    return pos + hv * (LockCFG.PredictFactor + dt * 0.5)
end

local function SetAimDir(pos)
    if not Lock.alignOri or LockBlocked() then return end
    local root = MC.root; if not root then return end
    local dir  = pos - root.Position
    dir = Vector3.new(dir.X, dir.Y * 0.12, dir.Z)
    if dir.Magnitude < 0.05 then return end
    dir = dir.Unit
    local up    = Vector3.new(0, 1, 0)
    local right = dir:Cross(up)
    if right.Magnitude < 0.01 then return end
    right = right.Unit
    Lock.alignOri.CFrame = CFrame.fromMatrix(Vector3.zero, right, right:Cross(dir).Unit)
end

-- forward declaration implementations
GetBestTarget = function(rescan)
    local root = MC.root; if not root then return nil end
    if not rescan and Lock.target and ValidTarget(Lock.target) then
        return Lock.target
    end
    Lock.candidates = {}
    local best, bestEff = nil, -1
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character; if not c then continue end
            local r = c:FindFirstChild("HumanoidRootPart")
            local h = c:FindFirstChild("Humanoid")
            if not r or not h or h.Health <= 0 then continue end
            local d = Dist(root, r)
            if d <= LockCFG.Range then
                table.insert(Lock.candidates, { p = p, dist = d })
                local ps     = GetPS(p.UserId)
                local sc, _  = Score(p, ps)
                local eff    = sc - d * 0.14
                if eff > bestEff then bestEff = eff; best = p end
            end
        end
    end
    table.sort(Lock.candidates, function(a, b) return a.dist < b.dist end)
    return best
end

local function ShouldSwitch(newTarget)
    if not Lock.target or not ValidTarget(Lock.target) then return true end
    if newTarget == Lock.target then return false end
    local curSc, _ = Score(Lock.target, GetPS(Lock.target.UserId))
    local newSc, _ = Score(newTarget, GetPS(newTarget.UserId))
    return (newSc - curSc) > LOCK_SWITCH_HYSTERESIS
end

-- v9.3: FullNeutralReset = kill target + constraints, Lock.on untouched
local function FullNeutralReset()
    Lock.target    = nil
    Lock.inCombat  = false; Lock.combatTime = 0
    Lock.prevPos   = nil;   Lock.vel        = Vector3.zero
    Lock.isAtk     = false
    DestroyConstraint()
    Parry.nextFire = 0; Parry.firing = false; Parry.firingAt = 0
    Parry.reactiveMode = false
    ClearSpamLock()
    -- Lock.on UNCHANGED
end

-- v9.3: FullOff = complete disable (manual or KO/death)
FullOff = function()
    Lock.on = false
    FullNeutralReset()
end

-- v9.3: UnlockTarget = neutral (target nil), Lock.on stays
UnlockTarget = function()
    Lock.target  = nil
    Lock.prevPos = nil; Lock.vel = Vector3.zero
    DestroyConstraint()
    -- Lock.on UNCHANGED
end

-- v9.3: LockOn — only activates if Lock.on=true AND we're in a hit exchange
LockOn = function(t)
    if not t or not Lock.on then return end
    -- v9.3: ONLY lock when there's an active exchange OR manual trigger
    -- (CombatLock.active is set by onIncoming/onOutgoing/manual)
    -- lock is ok if we just entered exchange (deferred from onIncoming/onOutgoing)
    local isNew   = (t ~= Lock.target)
    Lock.target   = t
    Lock.expireTime = os.clock() + LockCFG.LockDuration
    Lock.prevPos  = nil; Lock.vel = Vector3.zero
    if isNew then SetupConstraint() end
    MarkCombat()
end

local PROX_ATKS = {
    "IsPunching","IsHeavyPunching","IsHitRunning",
    "IsKickCombo","IsFiring","IsStartingBattle",
}

local function ProxCheck()
    if not Lock.on or not CombatLock.active then return end
    local now = os.clock()
    if now - Lock.lastProx < 0.08 then return end
    Lock.lastProx = now
    local c = LP.Character; if not c then return end
    local isAtk = false
    for _, a in ipairs(PROX_ATKS) do
        if c:GetAttribute(a) == true then isAtk = true; break end
    end
    if isAtk and not Lock.isAtk then
        local root = MC.root; if not root then Lock.isAtk = isAtk; return end
        local closest, cd = nil, LockCFG.ProxRange
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local er = p.Character:FindFirstChild("HumanoidRootPart")
                local eh = p.Character:FindFirstChild("Humanoid")
                if er and eh and eh.Health > 0 then
                    local d = Dist(root, er)
                    if d < cd then cd = d; closest = p end
                end
            end
        end
        if closest then
            MarkCombat()
            LockOn(closest)
            CombatLock:onOutgoing(closest)
        end
    end
    Lock.isAtk = isAtk
end

local function HookSelf(char)
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")

    for _, attr in ipairs(SELF_ATKS) do
        pcall(function()
            char:GetAttributeChangedSignal(attr):Connect(function()
                if char:GetAttribute(attr) == true then
                    MarkCombat()
                    if Lock.on then
                        local best = GetBestTarget(true)
                        if best then LockOn(best) end
                    end
                end
            end)
        end)
    end

    for _, attr in ipairs(KO_ATTRS) do
        pcall(function()
            char:GetAttributeChangedSignal(attr):Connect(function()
                if char:GetAttribute(attr) == true then FullNeutralReset() end
            end)
        end)
    end

    if hum then
        hum.Died:Connect(function() FullOff() end)

        -- ragdoll detection via FloorMaterial (property signal = no poll)
        local ragdollCooldown = 0
        hum:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
            local now = os.clock()
            if hum.FloorMaterial == Enum.Material.Air then
                task.delay(0.04, function()
                    local root = MC.root
                    if not root then return end
                    local vel      = root.Velocity
                    local vy       = vel.Y
                    local c        = MC.char
                    local beingHit = c and (
                        c:GetAttribute("IsBeingCarried") == true or
                        c:GetAttribute("IsBeingFinished") == true
                    )
                    if (vy > 10 or vy < -5 or beingHit) and now > ragdollCooldown then
                        ragdollCooldown = now + 0.22
                        SetRagdoll(true)
                        if Lock.on then CombatLock:onIncoming(nil) end
                        if Parry.on then
                            FireQueue:push("ragdoll", false, nil)
                        else
                            ReactiveParry(false)
                        end
                    end
                end)
            else
                -- back on ground
                task.delay(0.08, function() SetRagdoll(false) end)
            end
        end)

        -- HP-based combo parry interrupt
        local prevHP         = hum.Health
        local comboHitTimes  = {}
        local lastComboParryT = 0
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health < prevHP then
                MarkCombat()
                CombatLock:onIncoming(nil)

                local now = os.clock()
                table.insert(comboHitTimes, now)
                local fresh = {}
                for _, t in ipairs(comboHitTimes) do
                    if now - t < 0.65 then table.insert(fresh, t) end
                end
                comboHitTimes = fresh

                -- 2+ hits in 0.65s = combo burst, bypass all gates
                if #comboHitTimes >= 2 and now - lastComboParryT > 0.12 then
                    lastComboParryT = now
                    task.delay(0.008, function()
                        Parry.nextFire = 0; Parry.firing = false
                        ClearSpamLock()
                        if Parry.on then
                            FireQueue:push("instant", false, nil)
                        else
                            ReactiveParry(false)
                        end
                    end)
                end

                -- lock switch: closest attacker on HP drop
                if Lock.on then
                    local now2 = os.clock()
                    if now2 - Lock.lastSwitch >= LockCFG.SwitchCooldown then
                        Lock.lastSwitch = now2
                        local root      = MC.root
                        local closest, cd = nil, LockCFG.Range
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LP and p.Character then
                                local er = p.Character:FindFirstChild("HumanoidRootPart")
                                local eh = p.Character:FindFirstChild("Humanoid")
                                if er and eh and eh.Health > 0 then
                                    local d = root and Dist(root, er) or 9999
                                    if d < cd then cd = d; closest = p end
                                end
                            end
                        end
                        if closest then LockOn(closest)
                        else
                            local b = GetBestTarget(true); if b then LockOn(b) end
                        end
                    end
                end
            end
            prevHP = hum.Health
        end)
    end
end

