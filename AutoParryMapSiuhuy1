-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls = {} }
function RL:ok()
    local now = os.clock()
    local fresh = {}
    for _,t in ipairs(self.calls) do
        if now - t < 1.0 then table.insert(fresh,t) end
    end
    self.calls = fresh
    return #self.calls < CFG.RateLimitCPS
end
function RL:mark() table.insert(self.calls, os.clock()) end

-- ============================================================
--  HUMANIZER
-- ============================================================
local function Jitter()
    return math.random(CFG.JitterMin, CFG.JitterMax) / 1000
end
local function TapWindow()
    return math.random(
        math.floor(CFG.TapMin*1000),
        math.floor(CFG.TapMax*1000)
    ) / 1000
end

-- ============================================================
--  PING
-- ============================================================
local Ping = { cache=80, lastT=0 }
function Ping:get()
    local now = os.clock()
    if now - self.lastT > 0.25 then
        local ok,v = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        self.cache = (ok and v) or self.cache
        self.lastT = now
    end
    return self.cache
end
function Ping:lead()
    if not CFG.PingCompEnabled then return 0 end
    return math.min(CFG.PingCompMax, (self:get()/1000)*3.0)
end
function Ping:cd(heavy)
    local base = heavy and CFG.CooldownM2 or CFG.CooldownM1
    local p = self:get()
    if p > 150 then
        return math.max(base*0.55, base - math.min(0.07,(p-150)/2000))
    end
    return math.max(base*0.70, base*(1+(p-80)/1400))
end
function Ping:vellerp()
    return math.clamp(CFG.LockVelLerpBase - (self:get()-80)/2000, 0.12, 0.5)
end

