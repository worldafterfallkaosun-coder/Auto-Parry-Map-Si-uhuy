local RagdollState = {
    active    = false,
    detectedT = 0,
    duration  = 0,
    lastVelY  = 0,
}

local function SetRagdoll(v)
    local now = os.clock()
    if v and not RagdollState.active then
        RagdollState.active    = true
        RagdollState.detectedT = now
        RagdollState.duration  = 0
    elseif not v then
        RagdollState.active   = false
        RagdollState.duration = 0
    else
        RagdollState.duration = now - RagdollState.detectedT
    end
end

-- poll for velocity-based ragdoll (still needed as fallback)
local rdlPollT = 0
local function PollRagdoll()
    local now = os.clock()
    if now - rdlPollT < 0.06 then return end  -- only poll every 60ms
    rdlPollT = now
    local root = MC.root
    if not root then SetRagdoll(false); return end
    local vel  = root.Velocity
    local velY = vel.Y
    local velH = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local c    = MC.char
    local beingHeld = c and (
        c:GetAttribute("IsBeingCarried") == true or
        c:GetAttribute("IsBeingFinished") == true
    )
    SetRagdoll(velY < -6 or velY > 8 or velH > 22 or beingHeld)
    RagdollState.lastVelY = velY
end

-- ============================================================
--  PARRY FIRE QUEUE — v9.3: unified priority queue
--  All sources push to this queue, single consumer fires them
-- ============================================================
local FireQueue = {
    pending  = {},   -- { urgency, isHeavy, animTrack, t }
    lastFire = 0,
    minGap   = 0.025,  -- minimum ms between queue pops
}

function FireQueue:push(urgency, isHeavy, animTrack)
    -- deduplicate: don't push same urgency level twice within 30ms
    local now = os.clock()
    for _, e in ipairs(self.pending) do
        if e.urgency == urgency and (now - e.t) < 0.030 then return end
    end
    table.insert(self.pending, {
        urgency = urgency, isHeavy = isHeavy,
        animTrack = animTrack, t = now,
        priority = ({
            ragdoll  = 5,
            instant  = 4,
            reactive = 3,
            combo    = 3,
            normal   = 2,
            idle     = 1,
        })[urgency] or 1,
    })
    -- sort by priority descending
    table.sort(self.pending, function(a, b) return a.priority > b.priority end)
end

function FireQueue:pop()
    -- remove stale entries (>180ms old, too late to be useful)
    local now = os.clock()
    local fresh = {}
    for _, e in ipairs(self.pending) do
        if now - e.t < 0.18 then table.insert(fresh, e) end
    end
    self.pending = fresh
    if #self.pending == 0 then return nil end
    local e = self.pending[1]
    table.remove(self.pending, 1)
    return e
end

