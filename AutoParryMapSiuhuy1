-- ============================================================
--  FPS MONITOR — rolling 30-sample mean
-- ============================================================
local FPS = { current=60, frametime=1/60, samples={}, maxSamp=30, lastT=os.clock() }

RunService.Heartbeat:Connect(function(dt)
    table.insert(FPS.samples, dt)
    if #FPS.samples > FPS.maxSamp then table.remove(FPS.samples, 1) end
    local now = os.clock()
    if now - FPS.lastT > 0.35 then
        local sum = 0
        for _, s in ipairs(FPS.samples) do sum = sum + s end
        FPS.frametime = sum / #FPS.samples
        FPS.current   = math.floor(1 / math.max(FPS.frametime, 0.001))
        FPS.lastT     = now
    end
end)

-- ============================================================
--  PING MONITOR
-- ============================================================
local Ping = { current=80, samples={}, maxSamp=14, lastT=0 }

function Ping:update()
    local now = os.clock()
    if now - self.lastT < 0.22 then return end
    self.lastT = now
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v and v > 0 then
        table.insert(self.samples, v)
        if #self.samples > self.maxSamp then table.remove(self.samples, 1) end
        local sum = 0
        for _, s in ipairs(self.samples) do sum = sum + s end
        self.current = sum / #self.samples
    end
end

function Ping:get()    self:update(); return self.current end
function Ping:leadMs() return math.min(0.14, math.max(0, (self:get() - 50) / 1000 * 2.8)) end
function Ping:cooldown(heavy)
    local p    = self:get()
    local base = heavy and 0.14 or 0.20
    if p > 200 then return math.max(base * 0.40, base - 0.10)
    elseif p > 130 then return math.max(base * 0.58, base - 0.05) end
    return base
end

-- ============================================================
--  MATH UTILITIES
-- ============================================================
local _TWO_PI = 2 * math.pi

local function GaussJitter(mean, sigma)
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    local z  = math.sqrt(-2 * math.log(u1)) * math.cos(_TWO_PI * u2)
    return math.clamp(mean + z * sigma, mean - 4*sigma, mean + 4*sigma)
end

-- Lognormal: models human reaction delay distribution
-- mu/sigma in log-space; result clamped to [lo, hi]
local function LogNormal(mu, sigma, lo, hi)
    local u1 = math.max(1e-12, math.random())
    local u2 = math.random()
    local z  = math.sqrt(-2 * math.log(u1)) * math.cos(_TWO_PI * u2)
    local v  = math.exp(mu + sigma * z)
    return math.clamp(v, lo, hi)
end

local function PoissonWait(rate_hz)
    rate_hz = math.max(rate_hz, 0.1)
    return -math.log(math.max(1e-12, math.random())) / rate_hz
end

-- ============================================================
--  DYNAMIC RATE CAP — v8: floor 4, ceiling 13, probe 25s
--  Backs down immediately and hard at first cap hit
-- ============================================================
local DynRL = {
    floor   = 4,
    ceiling = 13,
    current = 7,
    probeT  = 0,
    probeCd = 25.0,
    hitCap  = false,
    hitCapHard = false,  -- v8: hard back if capped twice in a row
}

function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.probeCd then return end
    self.probeT = now
    if self.hitCapHard then
        self.current   = math.max(self.floor, self.current - 3)
        self.hitCapHard = false
    elseif self.hitCap then
        self.current   = math.max(self.floor, self.current - 2)
        self.hitCapHard = true
    else
        self.current = math.min(self.ceiling, self.current + 1)
    end
    self.hitCap = false
end

function DynRL:cap() self:probe(); return self.current end

-- ============================================================
--  RATE LIMITER
-- ============================================================
local RL = { calls={} }

function RL:ok()
    local now   = os.clock()
    local fresh = {}
    for _, t in ipairs(self.calls) do
        if now - t < 1.0 then table.insert(fresh, t) end
    end
    self.calls = fresh
    local cap = DynRL:cap()
    if #self.calls >= cap then DynRL.hitCap = true end
    return #self.calls < cap
end

function RL:mark()  table.insert(self.calls, os.clock()) end
function RL:count() return #self.calls end

-- ============================================================
--  ADAPTIVE TIMING
-- ============================================================
local Adaptive = {}

function Adaptive:compute()
    local fps = FPS.current
    local p   = Ping:get()
    local windowEst = 0.085 + math.min(0.07, p / 2200)

    -- tap hold: lognormal, tighter than v7
    local tapMu    = fps >= 55 and -3.10 or fps >= 35 and -3.25 or -3.40
    local tapSigma = 0.08
    local tapTime  = LogNormal(tapMu, tapSigma, 0.020, 0.070)

    -- inter-tap: lognormal
    local ivMu    = fps >= 55 and -3.15 or fps >= 35 and -3.30 or -3.45
    local interval = LogNormal(ivMu, 0.10, 0.018, 0.065)

    local fireTime  = tapTime + interval
    local spamCount = math.ceil(windowEst / fireTime)
    spamCount = math.clamp(spamCount, 6, 14)  -- v8: min 6

    local maxByRate = math.floor(DynRL:cap() / 2)
    spamCount = math.min(spamCount, maxByRate)

    return { tapTime=tapTime, interval=interval, spamCount=spamCount, windowEst=windowEst }
end

