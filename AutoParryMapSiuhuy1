-- ============================================================
--  SMART LOCK
-- ============================================================
local function LockBlocked()
    local c=LP.Character; if not c then return true end
    for _,s in ipairs(KO_ATTRS) do
        if c:GetAttribute(s)==true then return true end
    end
    return false
end

local function ValidTarget(t)
    if not t or not t.Parent then return false end
    local c=t.Character; if not c then return false end
    local h=c:FindFirstChild("Humanoid")
    if not h or h.Health<=0 then return false end
    local r=c:FindFirstChild("HumanoidRootPart"); if not r then return false end
    return MC.root and Dist(MC.root,r)<=LockCFG.LeashRange
end

local function DestroyConstraint()
    pcall(function()
        if Lock.alignOri then Lock.alignOri:Destroy(); Lock.alignOri=nil end
        if Lock.att0     then Lock.att0:Destroy();     Lock.att0=nil     end
    end)
end

local function SetupConstraint()
    local root=MC.root; if not root then return end
    if Lock.alignOri and Lock.alignOri.Parent==root then return end
    DestroyConstraint()
    local att=Instance.new("Attachment")
    att.Name=ATT_NAME; att.Parent=root; Lock.att0=att
    local ao=Instance.new("AlignOrientation")
    ao.Name=AO_NAME
    ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0=att; ao.MaxTorque=LockCFG.MaxTorque
    ao.MaxAngularVelocity=math.huge; ao.Responsiveness=LockCFG.Responsiveness
    ao.RigidityEnabled=false; ao.PrimaryAxisOnly=false; ao.Parent=root
    Lock.alignOri=ao
end

local function UpdateVel(pos)
    local now=os.clock(); local dt=now-Lock.lastVelT
    if Lock.prevPos and dt>0 and dt<0.3 then
        local rawVel=(pos-Lock.prevPos)/dt
        local alpha=math.clamp(0.35-(Ping:get()-80)/2000,0.12,0.50)
        Lock.vel=Lock.vel:Lerp(rawVel,alpha)
    end
    Lock.prevPos=pos; Lock.lastVelT=now
end

local function Predict(pos,dt)
    local hv=Vector3.new(Lock.vel.X,Lock.vel.Y*0.15,Lock.vel.Z)
    return pos+hv*(LockCFG.PredictFactor+dt*0.5)
end

local function SetAimDir(pos)
    if not Lock.alignOri or LockBlocked() then return end
    local root=MC.root; if not root then return end
    local dir=pos-root.Position
    dir=Vector3.new(dir.X,dir.Y*0.12,dir.Z)
    if dir.Magnitude<0.05 then return end
    dir=dir.Unit
    local up=Vector3.new(0,1,0)
    local right=dir:Cross(up)
    if right.Magnitude<0.01 then return end
    right=right.Unit
    Lock.alignOri.CFrame=CFrame.fromMatrix(Vector3.zero,right,right:Cross(dir).Unit)
end

local function GetBestTarget(rescan)
    local root=MC.root; if not root then return nil end
    if not rescan and Lock.target and ValidTarget(Lock.target) then
        return Lock.target
    end
    Lock.candidates={}
    local best,bestEff=nil,-1
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local c=p.Character; if not c then continue end
            local r=c:FindFirstChild("HumanoidRootPart")
            local h=c:FindFirstChild("Humanoid")
            if not r or not h or h.Health<=0 then continue end
            local d=Dist(root,r)
            if d<=LockCFG.Range then
                table.insert(Lock.candidates,{p=p,dist=d})
                local ps=GetPS(p.UserId)
                local sc,_=Score(p,ps)
                local eff=sc-d*0.20
                if eff>bestEff then bestEff=eff; best=p end
            end
        end
    end
    table.sort(Lock.candidates,function(a,b) return a.dist<b.dist end)
    return best
end

local function ShouldSwitch(newTarget)
    if not Lock.target or not ValidTarget(Lock.target) then return true end
    if newTarget==Lock.target then return false end
    local curSc,_=Score(Lock.target,GetPS(Lock.target.UserId))
    local newSc,_=Score(newTarget,GetPS(newTarget.UserId))
    return (newSc-curSc)>LOCK_SWITCH_HYSTERESIS
end

local LockOn,UnlockAll

local function FullNeutralReset()
    Lock.target=nil; Lock.inCombat=false; Lock.combatTime=0; Lock.combatUntil=0
    Lock.prevPos=nil; Lock.vel=Vector3.zero; Lock.isAtk=false
    DestroyConstraint()
    Parry.nextFire=0; Parry.firing=false; Parry.firingAt=0
    Parry.reactiveMode=false
end

LockOn=function(t)
    if not t then return end
    local isNew=(t~=Lock.target)
    Lock.target=t; Lock.expireTime=os.clock()+LockCFG.LockDuration
    Lock.prevPos=nil; Lock.vel=Vector3.zero
    if isNew then SetupConstraint() end
end

UnlockAll=function()
    Lock.target=nil; Lock.prevPos=nil; Lock.vel=Vector3.zero
    DestroyConstraint()
end

local PROX_ATKS={
    "IsPunching","IsHeavyPunching","IsHitRunning",
    "IsKickCombo","IsFiring","IsStartingBattle",
}

local function ProxCheck()
    if not Lock.on then return end
    local now=os.clock()
    if now-Lock.lastProx<0.10 then return end
    Lock.lastProx=now
    local c=LP.Character; if not c then return end
    local isAtk=false
    for _,a in ipairs(PROX_ATKS) do
        if c:GetAttribute(a)==true then isAtk=true; break end
    end
    if isAtk and not Lock.isAtk then
        local root=MC.root; if not root then Lock.isAtk=isAtk; return end
        local closest,cd=nil,LockCFG.ProxRange
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LP and p.Character then
                local er=p.Character:FindFirstChild("HumanoidRootPart")
                local eh=p.Character:FindFirstChild("Humanoid")
                if er and eh and eh.Health>0 then
                    local d=Dist(root,er)
                    if d<cd then cd=d; closest=p end
                end
            end
        end
        if closest then MarkCombat(LockCFG.SwingGrace); LockOn(closest) end
    end
    Lock.isAtk=isAtk
end

-- ============================================================
--  EXCHANGE — lock cuma aktif kalau ada hit beneran
--  incoming : HP kita turun / ReactionFX (dan ada musuh dekat)
--  outgoing : HP musuh turun pas kita lagi swing & dia dekat
--  ga ada dua-duanya > ExchangeTTL (swing doang > SwingGrace) → NETRAL
-- ============================================================
local lastHitTakenT = 0
local function OnHitTaken(src)
    local now = os.clock()
    if now - lastHitTakenT < 0.08 then return end        -- dedup FX + HP drop
    local near = NearestEnemy(24)
    if not near then return end                           -- fall dmg / DoT: bukan exchange
    lastHitTakenT = now
    -- belajar: hit mendarat berapa detik setelah anim penyerang mulai
    do
        local bestPS, bd = nil, 9999
        for _,p in ipairs(Players:GetPlayers()) do
            local ps = PS[p.UserId]
            if p ~= LP and ps and ps.atkName and not ps.atkHitSeen
               and (now - ps.atkStartT) > 0.04 and (now - ps.atkStartT) < 1.3 then
                local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                local d = (r and MC.root) and Dist(MC.root, r) or 9999
                if d < bd then bd = d; bestPS = ps end
            end
        end
        if bestPS then
            bestPS.atkHitSeen = true
            local off = now - bestPS.atkStartT
            Learn(HitOff, bestPS.atkName, off)
            local missed = bestPS.atkPressed
            if missed then GoodOff[bestPS.atkName] = nil end   -- press kita meleset, buang
            dbg(string.format("HIT by %s at +%.3f (learned %.3f) pressed=%s",
                bestPS.atkName, off, HitOff[bestPS.atkName], tostring(missed)))
        end
    end
    MarkCombat(LockCFG.ExchangeTTL)
    if Parry.on then Parry.missCount = Parry.missCount + 1 end
    UpdateCombo(GetPS(near.UserId), false, "hit")
    UpdateThreshold(true, nil)
    if Lock.on and now - Lock.lastSwitch >= LockCFG.SwitchCooldown then
        Lock.lastSwitch = now
        LockOn(near)
    end
    ReactiveParry(false)                                  -- sambung combo = parry next hit
end

local EnemyHP = {}
local function HitWatch()
    local root = MC.root; if not root then return end
    local now = os.clock()
    local striking = IsSelfStriking() or (now - Lock.lastStrikeT) < 0.9
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local h = c and c:FindFirstChildWhichIsA("Humanoid")
            if h then
                local prev = EnemyHP[p.UserId]
                EnemyHP[p.UserId] = h.Health
                if prev and striking and h.Health < prev - 0.01 then
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if r and Dist(root, r) <= 20 then
                        MarkCombat(LockCFG.ExchangeTTL)
                        if Lock.on then LockOn(p) end
                    end
                end
            else
                EnemyHP[p.UserId] = nil
            end
        end
    end
end

local function HookSelf(char)
    if not char then return end
    local hum=char:FindFirstChildWhichIsA("Humanoid")

    for _,attr in ipairs(SELF_ATKS) do
        pcall(function()
            char:GetAttributeChangedSignal(attr):Connect(function()
                if char:GetAttribute(attr)==true then
                    MarkCombat(LockCFG.SwingGrace); Lock.lastStrikeT=os.clock()
                    if Lock.on then
                        local best=GetBestTarget(true)
                        if best then LockOn(best) end
                    end
                end
            end)
        end)
    end

    for _,attr in ipairs(KO_ATTRS) do
        pcall(function()
            char:GetAttributeChangedSignal(attr):Connect(function()
                if char:GetAttribute(attr)==true then FullNeutralReset() end
            end)
        end)
    end

    if hum then
        hum.Died:Connect(function() FullNeutralReset() end)

        local prevHP=hum.Health
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health<prevHP then OnHitTaken("hp") end
            prevHP=hum.Health
        end)
    end
end

LP.CharacterAdded:Connect(function(c)
    FullNeutralReset()
    task.wait(0.20); HookSelf(c)
end)
if LP.Character then HookSelf(LP.Character) end

RunService.Heartbeat:Connect(function(dt)
    CheckNeutral(); ProxCheck(); HitWatch()
    local active=Lock.on and Lock.inCombat
    if not active then
        if Lock.target and not Lock.inCombat then UnlockAll() end
        return
    end
    if Lock.target and os.clock()>Lock.expireTime then UnlockAll(); return end
    if Lock.target and not ValidTarget(Lock.target) then UnlockAll(); return end
    local best=GetBestTarget(true)
    if best and ShouldSwitch(best) then LockOn(best) end
    if not Lock.target and best then LockOn(best); return end
    if not Lock.target then return end
    local ec=Lock.target.Character; if not ec then return end
    local er=ec:FindFirstChild("HumanoidRootPart"); if not er then return end
    UpdateVel(er.Position)
    local aimPt=Predict(er.Position,dt)
    aimPt=Vector3.new(aimPt.X,aimPt.Y+1.5,aimPt.Z)
    SetAimDir(aimPt)
end)

