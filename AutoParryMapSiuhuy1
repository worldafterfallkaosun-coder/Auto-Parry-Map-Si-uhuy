-- ============================================================
--  MAIN HEARTBEAT LOOP — nil-guarded
-- ============================================================
RunService.Heartbeat:Connect(function()
    -- Nil guard — prevent "attempt to index nil" on load
    if not Parry then return end
    if not AutoBlock then return end
    if not CombatLock then return end

    MaybeRotateNames()
    RefreshChar()
    CheckNeutral()

    AutoBlock:tick()
    CombatLock:tick()

    local now = os.clock()

    if not MC.root or not MC.hum then return end
    if MC.hum.Health <= 0 then return end

    SetupHPWatch()

    -- Parry + AutoBlock arm scan
    if Parry.on then
        for _,p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local uid = p.UserId
                local ps  = GetPS(uid)
                local ec  = p.Character
                if ec then
                    local er = ec:FindFirstChild("HumanoidRootPart")
                    local eh = ec:FindFirstChildWhichIsA("Humanoid")
                    if er and eh and eh.Health > 0 then
                        local sc, hvy = Score(p, ps)
                        -- Arm block fallback saat ancaman score >= 2
                        if sc >= 2 then
                            AutoBlock:arm(hvy)
                        end
                        -- Parry fire threshold = 3
                        if sc >= Parry.dynThreshold then
                            FireParry(uid, hvy, ps)
                        end
                    end
                end
            end
        end
    end

    Decoy:tick()
end)

-- ============================================================
--  KEYBINDS
--  Q = toggle Parry
--  E = toggle Lock (hanya aktif saat ada combat exchange)
-- ============================================================
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- Q: Toggle Parry
    if input.KeyCode == Enum.KeyCode.Q then
        Parry.on = not Parry.on
        if not Parry.on then
            AutoBlock:disarm()
        end
        print("[HSA v9.1] Parry:", Parry.on and "ON" or "OFF")
    end

    -- E: Toggle Lock
    if input.KeyCode == Enum.KeyCode.E then
        if Lock.on then
            Lock.on       = false
            Lock.target   = nil
            Lock.inCombat = false
            CombatLock.active = false
            if Lock.alignOri then
                pcall(function() Lock.alignOri:Destroy() end)
                Lock.alignOri = nil
            end
            if Lock.att0 then
                pcall(function() Lock.att0:Destroy() end)
                Lock.att0 = nil
            end
            print("[HSA v9.1] Lock: NEUTRAL")
        else
            if CombatLock.active then
                Lock.on = true
                print("[HSA v9.1] Lock: ACTIVE")
            else
                print("[HSA v9.1] Lock: no active exchange — go hit someone first")
            end
        end
    end
end)

