-- ============================================================
--  SCORE SYSTEM v9.2 — threshold 3, cache 3ms
-- ============================================================
local SCORE_TTL = 0.003

local function GetSwingBonus(er,root)
    local toMe=root.Position-er.Position
    local d=toMe.Magnitude
    if d<0.1 then return 0 end
    local dirN=toMe/d
    local fDot=er.CFrame.LookVector:Dot(dirN)
    local sDot=math.abs(er.CFrame.RightVector:Dot(dirN))
    local b=0
    if fDot>0.35 then b=b+18 end
    if sDot>0.28 then b=b+12 end
    if fDot>0.70 then b=b+10 end
    return math.min(b,40)
end

local function GetVelBonus(ps,er,root)
    local vel=er.Velocity
    local prev=ps.prevVel
    ps.prevVel=vel
    local acc=(vel-prev).Magnitude
    if acc<1.0 then return 0 end
    local toMe=root.Position-er.Position
    if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return 0 end
    local dot=toMe.Unit:Dot(vel.Unit)
    local b=0
    if dot>0.15 then b=b+math.floor(dot*46) end
    if vel.Unit.Y<-0.22 and dot>0.06 then b=b+18 end
    return math.min(b,58)
end

local function Score(p,ps)
    local now=os.clock()
    if now-ps.cacheTime<SCORE_TTL then return ps.cachedScore,ps.cachedHeavy end
    local ec=p.Character; local root=MC.root
    if not ec or not root then ps.cachedScore=0; return 0,false end
    local er=ec:FindFirstChild("HumanoidRootPart")
    local eh=ec:FindFirstChildWhichIsA("Humanoid")
    if not er or not eh or eh.Health<=0 then ps.cachedScore=0; return 0,false end
    local d=Dist(root,er)
    if d>24 or IsFromBack(er) then ps.cachedScore=0; return 0,false end

    local sc=0; local hvy=false

    sc=sc+math.floor((1-d/24)*22)

    local hasAttr,isHAttr=ScanAttrs(ec,eh)
    if isHAttr then sc=sc+115; hvy=true
    elseif hasAttr then sc=sc+75 end

    if ec:GetAttribute("InCombat")==true  then sc=sc+16 end
    if ec:GetAttribute("FightMode")==true then sc=sc+13 end

    local anim=eh:FindFirstChildOfClass("Animator")
    if anim then
        local ok,tracks=pcall(function() return anim:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _,t in pairs(tracks) do
                if t and t.IsPlaying then
                    local n=t.Animation.Name; local pos=t.TimePosition
                    if IsM2Anim(n) then
                        hvy=true
                        sc=sc+(pos<=0.02 and 95 or pos<=0.05 and 88 or
                               pos<0.15 and 70 or 52)
                        break
                    elseif IsM1Anim(n) then
                        sc=sc+(pos<=0.02 and 85 or pos<=0.04 and 70 or
                               pos<0.12 and 56 or 36)
                        break
                    end
                end
            end
        end
    end

    if ps.heavyAlert and now<ps.heavyAlertExp then sc=sc+50; hvy=true end
    if ps.combo>0 then sc=sc+math.min(ps.combo*15,68) end

    local avg=ps.avgInterval
    if avg and avg<0.45 then sc=sc+math.floor((1-avg/0.45)*32) end

    sc=sc+GetSwingBonus(er,root)
    sc=sc+GetVelBonus(ps,er,root)

    if d<9 then
        local toMe=(root.Position-er.Position).Unit
        if toMe:Dot(er.CFrame.LookVector)>0.50 then sc=sc+24 end
    end

    local hpR=eh.Health/math.max(eh.MaxHealth,1)
    if hpR<0.28 then sc=sc+20 elseif hpR<0.52 then sc=sc+10 end

    if ps.m2Detected and now<ps.m2DetectedExp then sc=sc+32; hvy=true end

    if ps.missStreak >= 3 then sc=sc-math.min(ps.missStreak*8,40) end

    -- v9.2: bonus score kalau ini adalah attacker terakhir / target terakhir
    if Lock.lastAttacker==p and now-Lock.lastAttackerT<8.0 then sc=sc+30 end
    if Lock.lastHitTarget==p and now-Lock.lastHitTargetT<8.0 then sc=sc+20 end

    local final=math.min(sc,300)
    ps.cachedScore=final; ps.cachedHeavy=hvy; ps.cacheTime=now
    return final,hvy
end

-- ============================================================
--  ANIM WINDOW PREDICTOR
-- ============================================================
local function AnimWindowPredict(track)
    if not track or not track.IsPlaying then return 0 end
    local ok,dur=pcall(function() return track.Length end)
    if not ok or not dur or dur<=0 then return 0 end
    local pos=track.TimePosition; local spd=track.Speed
    if spd<=0 then return 0 end
    return math.max(0, (dur*0.15 - pos)/spd)
end

-- ============================================================
--  DECOY
-- ============================================================
local Decoy = { nextT=0, nextSeqT=0 }

function Decoy:schedule()
    self.nextT = os.clock() + Gamma(2.5, 4.5) + 6.0
end

function Decoy:scheduleSeq()
    self.nextSeqT = os.clock() + Gamma(3.0, 5.0) + 10.0
end

function Decoy:tick()
    local now=os.clock()
    if now>=self.nextT and RL:ok() then
        pcall(function()
            task.delay(LogN(-2.80, 0.15, 0.040, 0.140), function()
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:schedule()
    end
    if now>=self.nextSeqT and RL:ok() then
        pcall(function()
            task.spawn(function()
                local react = ReactionDelay(false)
                task.wait(react)
                if not RL:ok() then return end
                RequestBlock:FireServer(true); RL:mark()
                local tap = LogN(-2.90, 0.10, 0.032, 0.095)
                task.wait(tap)
                if RL:ok() then RequestBlock:FireServer(false); RL:mark() end
            end)
        end)
        self:scheduleSeq()
    end
end

Decoy:schedule()
Decoy:scheduleSeq()

-- ============================================================
--  RAW PARRY — v9.2: adaptive tap via AdaptiveTapDuration
-- ============================================================
local function RawParry(tapOverride)
    if not RL:ok() then return false end
    local tap = tapOverride or AdaptiveTapDuration()

    local jPre  = LogN(-4.85, 0.14, 0.003, 0.016)
    local jPost = LogN(-5.10, 0.14, 0.002, 0.012)

    pcall(function()
        task.wait(jPre)
        RequestBlock:FireServer(true); RL:mark()
        task.wait(tap)
        task.wait(jPost)
        RequestBlock:FireServer(false)
    end)
    return true
end

-- ============================================================
--  PRIORITY PARRY BURST — v9.2: adaptive burst count
--  Ragdoll mode: burst count max, timing minimal, bypass semua gate
-- ============================================================
local spamLock  = false
local spamLockT = 0

local function DoParryBurst(isHeavy, urgency, animTrack, burstOverride)
    if spamLock and os.clock()-spamLockT > 0.55 then spamLock=false end
    -- v9.2: ragdoll bypass spamLock sepenuhnya
    if spamLock and urgency ~= "ragdoll" and urgency ~= "instant" then return end
    spamLock=true; spamLockT=os.clock()

    local pingLead = Ping:lead()
    local isRagdoll = (urgency == "ragdoll")
    local fps       = FPS.current

    -- v9.2: adaptive burst count
    -- ragdoll = max burst selalu
    -- fps tinggi = bisa lebih banyak karena presisi lebih tinggi
    local minB, maxB
    if isRagdoll then
        minB = 6; maxB = 10
    elseif isHeavy then
        minB = fps > 90 and 6 or 5
        maxB = fps > 90 and 10 or 8
    else
        minB = fps > 90 and 4 or 3
        maxB = fps > 90 and 8 or 6
    end

    local count = burstOverride or math.random(minB, maxB)
    count = math.min(count, math.floor(DynRL:cap() * (isRagdoll and 0.85 or 0.65)))
    count = math.max(count, 3)

    task.spawn(function()
        -- === REACTION DELAY ===
        if urgency == "instant" or urgency == "ragdoll" then
            -- instant/ragdoll: 12–35ms (tidak 0, masih human minimum)
            local minDelay = isRagdoll and 0.008 or 0.012
            task.wait(LogN(-3.80, 0.08, minDelay, 0.035))
        elseif urgency == "reactive" then
            task.wait(LogN(-3.10, 0.08, 0.040, 0.070))
        else
            local react = ReactionDelay(isHeavy)
            if animTrack then
                local ahead = AnimWindowPredict(animTrack)
                if ahead > 0.005 and ahead < react then
                    react = math.max(0.010, react - ahead)
                end
            end
            react = math.max(0.008, react - pingLead)
            task.wait(react)
        end

        -- === TAP LOOP ===
        for i=1,count do
            local parryActive = Parry.on or Parry.reactiveMode or isRagdoll
            if not parryActive and urgency ~= "reactive" and urgency ~= "instant" and urgency ~= "ragdoll" then break end
            if not RL:ok() then
                if isRagdoll then
                    -- ragdoll: jangan tunggu, skip tap ini
                    continue
                end
                task.wait(Gamma(1.5, 0.06))
            end
            -- v9.2: tap adaptif, lebih pendek saat ragdoll (urgency tinggi)
            local tapT = isRagdoll and AdaptiveTapDuration() * 0.7 or AdaptiveTapDuration()
            RawParry(tapT)
            if i < count then
                local shape = isRagdoll and 1.0 or (1.2 + (i/count)*0.6)
                local scaleT = isRagdoll and 0.018 or 0.030
                local iv = Gamma(shape, scaleT)
                iv = math.clamp(iv, isRagdoll and 0.010 or 0.015, 0.080)
                task.wait(iv)
            end
        end

        -- v9.2: saat ragdoll, jangan lock spamLock terlalu lama
        if isRagdoll then
            task.delay(0.10, function() spamLock=false end)
        else
            spamLock=false
        end
    end)
end

-- ============================================================
--  FIRE PARRY — v9.2: ragdoll bypass SEMUA gate
-- ============================================================
local function CanFire(ps, reactive)
    local ragdoll = RagdollState and RagdollState.active
    -- v9.2: ragdoll = bypass SEMUA gate kecuali hard KO
    if ragdoll then
        if IsHardKO() then return false end
        return true
    end
    if reactive then
        if not MC.root then return false end
        return not IsSelfAttacking()
    end
    if not Parry.on then return false end
    if Parry.firing then
        if os.clock()-Parry.firingAt > 0.38 then Parry.firing=false
        else return false end
    end
    if os.clock() < Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAttacking() then return false end
    local gate = 0.085
    if ps and os.clock()-ps.lastFireT < gate then return false end
    return true
end

local function FireParry(isHeavy, ps, urgency, animTrack)
    local ragdoll   = RagdollState and RagdollState.active
    local isReactive = (urgency=="reactive")
    local isRdl     = ragdoll or (urgency=="ragdoll")

    -- v9.2: ragdoll = reset semua lock dan fire langsung
    if isRdl then
        Parry.firing=false; Parry.firingAt=0; Parry.nextFire=0
        spamLock=false; spamLockT=0
    end

    if not isRdl and not CanFire(ps, isReactive) then return false end

    local cd  = Ping:cd(isHeavy)
    local cdJ = Gamma(1.2, 0.006)

    if not isReactive and not isRdl then
        Parry.firing   = true
        Parry.firingAt = os.clock()
        Parry.nextFire = os.clock()+cd+cdJ
    end
    if ps then ps.lastFireT=os.clock() end

    task.spawn(function()
        local urg = isRdl and "ragdoll" or (urgency or "normal")
        DoParryBurst(isHeavy, urg, animTrack, nil)
        if not isReactive and not isRdl then
            task.wait(0.28)
            Parry.firing=false
        end
    end)
    return true
end

-- v9.2: instant — 12–35ms delay
local lastInstantT=0
local function SafeFireInstant(isHeavy)
    local now=os.clock()
    local ragdoll = RagdollState and RagdollState.active
    -- ragdoll: minGap sangat kecil (8ms)
    local minGap = ragdoll and 0.008 or 0.035
    if now-lastInstantT < minGap then return end
    lastInstantT=now
    Parry.nextFire=0; Parry.firing=false
    spamLock=false; spamLockT=0
    local urg = ragdoll and "ragdoll" or "instant"
    DoParryBurst(isHeavy or true, urg, nil, nil)
end

local lastReactT=0
local function ReactiveParry(isHeavy)
    local now=os.clock()
    local ragdoll = RagdollState and RagdollState.active
    local minGap = ragdoll and 0.060 or 0.090
    if now-lastReactT < minGap then return end
    lastReactT=now
    Parry.reactiveMode=true
    Parry.reactiveModeExp=now+0.40
    spamLock=false; spamLockT=0
    local urg = ragdoll and "ragdoll" or "reactive"
    DoParryBurst(isHeavy or false, urg, nil, nil)
    task.delay(0.45, function() Parry.reactiveMode=false end)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, isHeavy, src)
    local now=os.clock()
    table.insert(ps.history, {t=now,h=isHeavy,s=src})
    if #ps.history>28 then table.remove(ps.history,1) end
    ps.lastHitTime=now
    if #ps.history>=3 then
        local sum,n=0,0
        for i=2,#ps.history do
            sum=sum+ps.history[i].t-ps.history[i-1].t; n=n+1
        end
        ps.avgInterval=sum/n
    else ps.avgInterval=nil end
end

local function UpdateCombo(ps, uid, isHeavy, src)
    if os.clock()-ps.lastHitTime>1.5 then ps.combo=0 end
    RecordHit(ps,isHeavy,src)
    ps.combo=ps.combo+1
    return ps.combo
end

local function UpdateThreshold(missed, ps)
    local target=missed and 3 or 8
    Parry.dynThreshold=Parry.dynThreshold*0.82+target*0.18
    Parry.dynThreshold=math.clamp(Parry.dynThreshold,3,10)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1
        Parry.missStreak=Parry.missStreak+1
        if ps then ps.missStreak=(ps.missStreak or 0)+1 end
        if Parry.consecMiss>=4 then
            spamLock=false; spamLockT=0
            Parry.consecMiss=0
            Parry.missStreak=0
            Parry.nextFire=0
        end
    else
        Parry.consecMiss=0
        Parry.missStreak=0
        if ps then ps.missStreak=0 end
    end
end

-- ============================================================
--  BUILD QUEUE
-- ============================================================
local function BuildQueue()
    local q={}
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local ps=GetPS(p.UserId)
            local sc,hv=Score(p,ps)
            if sc>=Parry.dynThreshold then
                table.insert(q,{player=p,score=sc,heavy=hv,ps=ps})
            end
        end
    end
    table.sort(q,function(a,b) return a.score>b.score end)
    while #q>3 do table.remove(q) end
    return q
end

-- ============================================================
--  VEL PRE-FIRE
-- ============================================================
local function CheckVelPreFire(p, ps, er)
    if not MC.root or not er then return end
    if IsFromBack(er) then return end
    local vel=er.Velocity
    local acc=(vel-ps.prevVel).Magnitude
    if acc>=4.5 then
        local toMe=MC.root.Position-er.Position
        if toMe.Magnitude<0.1 or vel.Magnitude<0.1 then return end
        local dot=toMe.Unit:Dot(vel.Unit)
        if dot>0.18 then
            local now=os.clock()
            if now-ps.lastVelSpike>0.08 then
                ps.lastVelSpike=now
                FireParry(false,ps,"normal",nil)
            end
        end
    end
end

