local function HookSelf(char)
    if not char then return end
    local hum=char:FindFirstChildWhichIsA("Humanoid")
    for _,a in ipairs(SELF_ATKS) do
        pcall(function()
            char:GetAttributeChangedSignal(a):Connect(function()
                if char:GetAttribute(a)==true then
                    MarkCombat()
                    -- outgoing attack → trigger CL (which will call LockOn)
                    if Lock.on then CL:onOutgoing(nil) end
                end
            end)
        end)
    end
    for _,a in ipairs(KO_ATTRS) do
        pcall(function()
            char:GetAttributeChangedSignal(a):Connect(function()
                if char:GetAttribute(a)==true then
                    Lock.target=nil; Lock.inCombat=false
                    DestroyCon(); Parry.nextFire=0; Parry.firing=false; ClearSL()
                end
            end)
        end)
    end
    if hum then
        hum.Died:Connect(function() FullOff() end)
        local rdlCd=0
        hum:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
            local now=os.clock()
            if hum.FloorMaterial==Enum.Material.Air then
                task.delay(0.032,function()
                    local root=MC.root; if not root then return end
                    local v=root.Velocity; local c=MC.char
                    local bh=c and (c:GetAttribute("IsBeingCarried")==true or c:GetAttribute("IsBeingFinished")==true)
                    if (v.Y>8 or v.Y< -4 or bh) and now>rdlCd then
                        rdlCd=now+0.18; SetRDL(true)
                        if Lock.on then CL:onIncoming(nil) end
                        if Parry.on then FQ:push("ragdoll",false,nil) end
                    end
                end)
            else task.delay(0.065,function() SetRDL(false) end) end
        end)
        local prevHP=hum.Health; local cHitT={}; local lastCPT=0
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health<prevHP then
                MarkCombat(); CL:onIncoming(nil)
                local now=os.clock()
                cHitT[#cHitT+1]=now
                local f={}; for _,t in ipairs(cHitT) do if now-t<0.65 then f[#f+1]=t end end
                cHitT=f
                if #cHitT>=2 and now-lastCPT>0.095 then
                    lastCPT=now
                    task.delay(0.005,function()
                        Parry.nextFire=0; Parry.firing=false; ClearSL()
                        if Parry.on then FQ:push("prearm",false,nil) end
                    end)
                end
            end
            prevHP=hum.Health
        end)
    end
end

